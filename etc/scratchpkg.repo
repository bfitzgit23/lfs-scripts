#
# /etc/scratchpkg.repo : scratchpkg repo file
#
# format:
#    <repo directory> <repo url> <repo branch, "main" by default>
#
# The venomlinux trees below are converted to Pkgfile (pkgutils/prt-get) form
# under ports/scratch/venom-<repo> by tools/spkgbuild2pkgfile.sh.
#

/usr/ports/core             https://github.com/bfitzgit23/lfs-scripts
/usr/ports/extra            https://github.com/bfitzgit23/lfs-scripts
/usr/ports/contrib          https://github.com/bfitzgit23/lfs-scripts
/usr/ports/multilib         https://github.com/bfitzgit23/lfs-scripts
/usr/ports/opt              https://github.com/bfitzgit23/lfs-scripts
/usr/ports/scratch          https://github.com/bfitzgit23/lfs-scripts

/usr/ports/venom-core          https://codeberg.org/venomlinux/core
/usr/ports/venom-extra         https://codeberg.org/venomlinux/extra
/usr/ports/venom-nonfree       https://codeberg.org/venomlinux/nonfree
/usr/ports/venom-multilib      https://codeberg.org/venomlinux/multilib
/usr/ports/venom-kde-lxqt      https://codeberg.org/venomlinux/kde-lxqt
/usr/ports/venom-mate          https://codeberg.org/venomlinux/mate
/usr/ports/venom-xfce         https://codeberg.org/venomlinux/xfce
/usr/ports/venom-s6            https://codeberg.org/venomlinux/s6
