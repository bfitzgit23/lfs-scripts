#
# /etc/scratchpkg.repo : scratchpkg repo file
#
# format:
#    <repo directory> <repo url> <repo branch, "main" by default>
#
# The venomlinux collections are converted to Pkgfile (pkgutils/prt-get) form
# and imported into the trees below by tools/sync-venom-ports.sh. Every
directory listed here lives in this repository.
#

/usr/ports/core             https://github.com/bfitzgit23/lfs-scripts
/usr/ports/extra            https://github.com/bfitzgit23/lfs-scripts
/usr/ports/contrib          https://github.com/bfitzgit23/lfs-scripts
/usr/ports/multilib         https://github.com/bfitzgit23/lfs-scripts
/usr/ports/opt              https://github.com/bfitzgit23/lfs-scripts
/usr/ports/compat-32        https://github.com/bfitzgit23/lfs-scripts
/usr/ports/compiz           https://github.com/bfitzgit23/lfs-scripts
/usr/ports/gnome            https://github.com/bfitzgit23/lfs-scripts
/usr/ports/iso              https://github.com/bfitzgit23/lfs-scripts
/usr/ports/kde4             https://github.com/bfitzgit23/lfs-scripts
/usr/ports/lxqt             https://github.com/bfitzgit23/lfs-scripts
/usr/ports/plasma           https://github.com/bfitzgit23/lfs-scripts
/usr/ports/xorg             https://github.com/bfitzgit23/lfs-scripts

/usr/ports/nonfree          https://github.com/bfitzgit23/lfs-scripts
/usr/ports/mate             https://github.com/bfitzgit23/lfs-scripts
/usr/ports/xfce             https://github.com/bfitzgit23/lfs-scripts
/usr/ports/kde-lxqt         https://github.com/bfitzgit23/lfs-scripts
/usr/ports/s6               https://github.com/bfitzgit23/lfs-scripts
