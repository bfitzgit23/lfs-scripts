# Depends: libxvmc libx11-32 libxext-32 xorgproto-32 libxv-32
description="X11 Video Motion Compensation extension library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxvmc"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxvmc-32
version=1.0.15
release=1
source=(http://ftp.x.org/pub/individual/lib/libXvMC-$version.tar.xz)
renames=(libxvmc-1.0.15.tar.xz)

pkg_build() {
	if [ -d libXvMC-$version ]; then
		cd libXvMC-$version
	fi

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
