# Depends: opus
description="A totally open, royalty-free, highly versatile audio codec"
homepage="https://opus-codec.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=opus-32
version=1.6.1
release=1
source="https://downloads.xiph.org/releases/opus/opus-$version.tar.gz"

pkg_build() {
	export CC="gcc -m32"
        export CXX="g++ -m32"
        export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson $SRC/${name%-*}-$version build \
		--libdir=/usr/lib32 \
		-Dcustom-modes=true \
		-Dtests=disabled
	meson compile -C build
	DESTDIR=$PKG meson install -C build

	rm -fr $PKG/usr/include
}
