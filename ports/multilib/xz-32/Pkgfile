# Depends: xz
description="Programs for compressing and decompressing files"
homepage="https://xz.tukaani.org/xz-utils/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xz-32
version=5.8.3
release=1
source="https://github.com/tukaani-project/xz/archive/refs/tags/v$version/xz-$version.tar.gz
       fix-sabotage.patch"

pkg_build() {
	cd ${name%-*}-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig" 

        patch -np1 -i $SRC/fix-sabotage.patch
        autoreconf -fi
	./configure --prefix=/usr    \
		    --libdir=/usr/lib32 \
	            --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
