# Depends: libxpm xorgproto-32 libx11-32
description="X11 pixmap library"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxpm-32
version=3.5.19
release=1
source=(http://ftp.x.org/pub/individual/lib/libXpm-$version.tar.xz)
renames=(libxpm-3.5.19.tar.xz)

pkg_build() {
	if [ -d libXpm-$version ]; then
		cd libXpm-$version
	fi

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
		--disable-open-zfile \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
