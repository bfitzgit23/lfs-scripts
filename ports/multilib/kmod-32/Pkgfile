# Depends: kmod xz-32 zlib-32
description="Libraries and utilities for loading kernel modules"
homepage="https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=kmod-32
version=34.2
release=1
source="https://www.kernel.org/pub/linux/utils/kernel/kmod/${name%-*}-$version.tar.xz"
pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson $SRC/${name%-*}-$version build \
		--libdir=/usr/lib32 \
		-Ddlopen=all \
		-Dmanpages=false 
	meson compile -C build
	DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
