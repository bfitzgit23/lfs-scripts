description="XML-XCB protocol descriptions"
homepage="https://xcb.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xcb-proto-32
version=1.17.0
release=1
source="https://xorg.freedesktop.org/archive/individual/proto/xcb-proto-$version.tar.xz"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	export PYTHON=/usr/bin/python3

	if [ -d xcb-proto-$version ]; then
		cd xcb-proto-$version
	fi
	
	sed 's/datarootdir/libdir/' -i Makefile.am 

	NOCONFIGURE=1 ./autogen.sh
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}

