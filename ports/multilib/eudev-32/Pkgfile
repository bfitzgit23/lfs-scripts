# Depends: eudev kmod-32
description="Programs for dynamic creation of device nodes"
homepage="https://www.kernel.org/pub/software/network/ethtool/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=eudev-32
version=3.2.14
release=1
source=(https://github.com/eudev-project/eudev/archive/v$version.tar.gz)
renames=(eudev-3.2.14.tar.gz)

pkg_build() {
	cd eudev-$version

	export XML_CATALOG_FILES=/etc/xml/catalog
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"
	./autogen.sh
	./configure --prefix=/usr           \
	            --libdir=/usr/lib32     \
	            --sysconfdir=/etc       \
	            --with-rootprefix=      \
	            --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
