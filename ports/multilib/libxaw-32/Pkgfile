# Depends: libxaw libxt-32 libxmu-32 libxpm-32
description="X11 Athena Widget library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxaw"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxaw-32
version=1.0.16
release=1
source=(http://ftp.x.org/pub/individual/lib/libXaw-$version.tar.xz)
renames=(libxaw-1.0.16.tar.bz2)

pkg_build() {
	if [ -d libXaw-$version ]; then
		cd libXaw-$version
	fi

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}

