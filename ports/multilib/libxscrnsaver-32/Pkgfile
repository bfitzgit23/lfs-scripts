# Depends: xorgproto-32 libx11-32 libxext-32
description="X11 Screen Saver extension client library"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxscrnsaver-32
version=1.2.5
release=1
source=(http://ftp.x.org/pub/individual/lib/libXScrnSaver-$version.tar.xz)
renames=(libxscrnsaver-1.2.5.tar.xz)

pkg_build() {
	cd libXScrnSaver-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
