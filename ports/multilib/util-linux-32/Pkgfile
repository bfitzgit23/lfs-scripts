# Depends: util-linux ncurses-32 sqlite-32
description="Utilities for handling file systems, consoles, partitions, and messages"
homepage="https://github.com/util-linux/util-linux"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=util-linux-32
version=2.42.2
release=1

case $version in
	*.*.*) _ver=${version%.*};;
	*.*) _ver=$version;;
esac

source="https://www.kernel.org/pub/linux/utils/util-linux/v$_ver/util-linux-$version.tar.xz"

pkg_build() {
	export CC='gcc -m32'
	export CXX='g++ -m32'
	export PKG_CONFIG_PATH='/usr/lib32/pkgconfig'

	venom-meson $SRC/${name%-*}-$version build \
	        --libdir=/usr/lib32 \
	        --libexecdir=/usr/lib32 \
		--auto-features=disabled \
	        -Db_lto=false \
	        -Dbuild-libblkid=enabled \
	        -Dbuild-libuuid=enabled \
	        -Dbuild-libmount=enabled \
	        -Dbuild-libsmartcols=enabled \
	        -Dbuild-libfdisk=enabled \
	        -Dbuild-python=disabled \
	        -Dnls=disabled
	meson compile -C build 

	DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
