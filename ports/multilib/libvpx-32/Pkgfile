# Depends: yasm
description="Implementations of the VP8 Codec, used in most current html5 video, and of the next-generation VP9 Codec"
homepage="https://www.webmproject.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libvpx-32
version=1.16.0
release=1
source=(https://github.com/webmproject/libvpx/archive/v$version.tar.gz)
renames=(libvpx-1.16.0.tar.gz)


pkg_build() {
	if [ -d libvpx-$version ]; then
		cd libvpx-$version
	fi

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure --prefix=/usr   \
                    --libdir=/usr/lib32 \
                    --target=x86-linux-gcc \
 	            --enable-shared  \
 	            --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32

	rm -rf $PKG/usr/bin
	rm -rf $PKG/usr/include
	rm -rf $PKG/usr/share
}
