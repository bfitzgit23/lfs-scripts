# Depends: libgpg-error
description="Library that defines common error values for all GnuPG components"
homepage="https://www.gnupg.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libgpg-error-32
version=1.61
release=1
source="https://www.gnupg.org/ftp/gcrypt/${name%-*}/${name%-*}-$version.tar.bz2"

pkg_build() {
	if [ -d ${name%-*}-$version ]; then cd ${name%-*}-$version; fi

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	# allow building with gawk-5.0
	sed -i 's/namespace/pkg_&/' \
		src/Makefile.am \
		src/Makefile.in \
		src/mkstrtable.awk

  	./configure --prefix=/usr --libdir=/usr/lib32
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
