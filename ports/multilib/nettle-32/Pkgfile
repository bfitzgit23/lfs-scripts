# Depends: nettle libgmp-32
description="Low-level cryptographic library that is designed to fit easily in many contexts"
homepage="https://www.lysator.liu.se/~nisse/nettle"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=nettle-32
version=3.10.2
release=1
source="https://mirrorservice.org/sites/ftp.gnu.org/gnu/nettle/nettle-3.10.2.tar.gz"

pkg_build() {
	if [ -d nettle-$version ]; then
		cd nettle-$version
	fi

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure --prefix=/usr \
		    --libdir=/usr/lib32 \
		    --disable-documentacion \
                    --disable-openssl \
                    --enable-shared \
                    --enable-mini-gmp                  
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
