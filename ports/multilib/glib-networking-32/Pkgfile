# Depends: glib-networking glib-32 gnutls-32
description="Network related gio modules for GLib"
homepage="https://gitlab.gnome.org/GNOME/glib-networking"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=glib-networking-32
version=2.80.1
release=2
source="https://ftp.gnome.org/pub/gnome/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson $SRC/${name%-*}-$version build \
		--libdir=/usr/lib32 \
		--libexecdir=/usr/lib32 \
		-Dlibproxy=disabled \
		-Dgnome_proxy=disabled
	meson compile -C build
	DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
