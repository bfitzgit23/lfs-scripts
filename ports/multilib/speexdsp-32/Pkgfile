# Depends: speexdsp
description="Speech processing library that goes along with the Speex codec"
homepage="https://github.com/xiph/speexdsp"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=speexdsp-32
version=1.2.1
release=1
source=(https://github.com/xiph/speexdsp/archive/refs/tags/SpeexDSP-1.2.1.tar.gz)
renames=(speexdsp-1.2.1.tar.gz)

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	if [ -d ${name%-*}-SpeexDSP-$version ]; then cd ${name%-*}-SpeexDSP-$version; fi

	./autogen.sh
	./configure --prefix=/usr --libdir=/usr/lib32
	make
	make DESTDIR=$PWD/DESTDIR install
	
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
