# Depends: lcms2
description="Small-footprint color management engine, with special focus on accuracy and performance"
homepage="http://www.littlecms.com/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=lcms2-32
version=2.19
release=1
source="https://downloads.sourceforge.net/lcms/lcms2-$version.tar.gz"

pkg_build() {
	cd lcms2-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure --prefix=/usr --libdir=/usr/lib32 --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
