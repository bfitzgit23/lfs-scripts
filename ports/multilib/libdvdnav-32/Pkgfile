# Depends: libdvdread-32
description="Library that allows easy use of sophisticated DVD navigation features"
homepage="https://www.videolan.org/developers/libdvdnav.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libdvdnav-32
version=7.0.0
release=2
source="https://code.videolan.org/videolan/libdvdnav/-/archive/$version/${name%-*}-$version.tar.gz"

pkg_build() {
       	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson libdvdnav-$version build \
		--libdir=/usr/lib32 \
		--libexecdir=/usr/lib32 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
     
        rm -rf $PKG/usr/include $PKG/usr/share
}
