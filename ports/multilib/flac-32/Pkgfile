# Depends: libogg-32 flac
description="Audio CODEC similar to MP3, but lossless"
homepage="https://xiph.org/flac/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=flac-32
version=1.5.0
release=1
source="${name%-*}-$version.tar.gz::https://github.com/xiph/flac/archive/$version.tar.gz"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cd ${name%-*}-$version
	NOCONFIGURE=1 ./autogen.sh
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-rpath \
		--disable-thorough-tests \
		--enable-ogg \
		--enable-shared \
		--enable-sse
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32

}
