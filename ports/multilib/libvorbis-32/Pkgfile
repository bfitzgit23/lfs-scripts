# Depends: libogg-32
description="Creating (encoding) and playing (decoding) sound in an open (patent free) format"
homepage="https://www.xiph.org/vorbis/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libvorbis-32
version=1.3.7
release=1
source="https://downloads.xiph.org/releases/vorbis/${name%-*}-$version.tar.xz"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cd ${name%-*}-$version
	
	./configure --prefix=/usr --libdir=/usr/lib32 
	make
	make DESTDIR=$PWD/DESTDIR install
	
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
