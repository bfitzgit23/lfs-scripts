# Depends: libxmu libxi glu
description="The OpenGL Extension Wrangler Library"
homepage="https://github.com/nigels-com/glew"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=glew-32
version=2.3.1
release=1
source="https://downloads.sourceforge.net/project/glew/glew/$version/glew-$version.tgz"

pkg_build() {
	if [ -d glew-$version ]; then
		cd glew-$version
	fi
    export CC="gcc -m32"
    export CXX="g++ -m32"
	make \
		CC="${CC:-gcc}" \
		LD="${CC:-gcc}" \
		CFLAGS.EXTRA="$CFLAGS -fPIC" \
		LDFLAGS.EXTRA="$LDFLAGS"

	make \
		LIBDIR="$PKG/usr/lib32" \
		PKGDIR="$PKG/usr/lib32/pkgconfig" \
		GLEW_DEST=$PKG/usr \
		install

	rm -r $PKG/usr/include
}
