# Depends: freetype2 libpng-32
description="Font rasterization library"
homepage="https://downloads.sourceforge.net/freetype"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=freetype2-32
version=2.14.3
release=1
source="https://downloads.sourceforge.net/freetype/freetype-$version.tar.xz"

pkg_build() {
	if [ -d freetype-$version ]; then
		cd freetype-$version
	fi

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
