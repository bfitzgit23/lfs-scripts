# Depends: libxmu libxt-32 libxext-32
description="X11 miscellaneous micro-utility library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxmu"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxmu-32
version=1.3.1
release=1
source=(http://ftp.x.org/pub/individual/lib/libXmu-$version.tar.xz)
renames=(libxmu-1.3.1.tar.xz)

pkg_build() {
	cd libXmu-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"
	export CFLAGS="$CLFAGS -Wno-error=pointer-to-int-cast -Wno-error=int-to-pointer-cast"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
