# Depends: alsa-lib
description="ALSA library used by programs (including ALSA Utilities) requiring access to the ALSA sound interface"
homepage="https://www.alsa-project.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=alsa-lib-32
version=1.2.16.1
release=1
source="https://www.alsa-project.org/files/pub/lib/alsa-lib-$version.tar.bz2"

pkg_build() {
	cd alsa-lib-$version
        
        autoreconf -fi
        export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

  	./configure --libdir=/usr/lib32 --without-debug

	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
