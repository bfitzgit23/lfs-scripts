# Depends: dbus-glib gtk3 libxcomposite
description="MATE session manager and configuration program"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-session-manager
version=1.28.0
release=1
source="https://github.com/mate-desktop/mate-session-manager/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/$name \
		--disable-schemas-compile \
		--disable-docbook-docs
	make
	make DESTDIR=$PKG install
}
