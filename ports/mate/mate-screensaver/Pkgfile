# Depends: libx11 libxscrnsaver dbus-glib mate-desktop gtk3 mate-menus mesa libsm libice libxext libxxf86vm linux-pam libmatekbd libxklavier libnotify
description="Screensaver for MATE"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-screensaver
version=1.28.0
release=1
source="https://github.com/mate-desktop/mate-screensaver/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib \
		--localstatedir=/var \
		--disable-nls
	make
	make DESTDIR=$PKG install
}
