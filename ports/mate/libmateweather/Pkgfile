# Depends: libsoup3 gtk3
description="A library for accessing weather information from online services"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libmateweather
version=1.28.2
release=1
source=(https://github.com/mate-desktop/libmateweather/archive/refs/tags/v$version.tar.gz)
renames=(libmateweather-1.28.2.tar.gz)

pkg_build() {

	autoreconf -fiv

	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install

}
