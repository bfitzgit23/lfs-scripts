# Depends: dbus-glib mate-desktop libmatekbd libxklavier
description="A fork of gnome-settings-daemon for MATE"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-settings-daemon
version=1.28.0
release=1
source="https://github.com/mate-desktop/mate-settings-daemon/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib/$name \
		--disable-nls
	make
	make DESTDIR=$PKG install
}
