# Depends: enchant libpeas1 gtksourceview4 iso-codes itstool
description="The MATE text editor"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pluma
version=1.28.0
release=1
source="https://github.com/mate-desktop/pluma/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {

	# skip broken translations
	rm -r help/ru

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/$name \
		--enable-gtk-doc=no \
		--enable-python
	make
	make DESTDIR=$PKG install
}
