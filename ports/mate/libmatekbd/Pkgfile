# Depends: libxklavier gtk3
description="A fork of libgnomekbd"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libmatekbd
version=1.28.0
release=1
source="https://github.com/mate-desktop/libmatekbd/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}
