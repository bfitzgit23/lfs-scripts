# Depends: gtk3 glib mate-panel libxext libcanberra libx11 zlib libgtop libsm libice udisks2
description="Common MATE utilities for viewing disk usage, logs and fonts, taking screenshots, managing dictionaries and searching files"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-utils
version=1.28.0
release=1
source="https://github.com/mate-desktop/mate-utils/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	
	# skip broken translations
	rm -r  */help/uk
	
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib/$name
	make
	make DESTDIR=$PKG install

}
