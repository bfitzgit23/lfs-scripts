# Depends: gtk3 libnotify glib mate-desktop libnotify
description="The file manager for MATE"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=caja
version=1.28.0
release=1
source="https://github.com/mate-desktop/caja/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr --disable-update-mimedb --disable-nls
	make
	make DESTDIR=$PKG install
}
