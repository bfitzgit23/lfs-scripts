# Depends: glib mate-desktop libpeas1 gtk3 gobject-introspection libexif lcms2 dbus-glib librsvg zlib libjpeg-turbo libxml2 libx11 itstool
description="An image viewing and cataloging program for MATE"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=eom
version=1.28.0
release=1
source="https://github.com/mate-desktop/eom/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}
