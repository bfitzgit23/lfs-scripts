# Depends: gtk3 glib libxml2 itstool
description="Calculator for the MATE desktop environment"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-calc
version=1.28.0
release=1
source="https://github.com/mate-desktop/mate-calc/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {

	# remove help/ja, buid fails otherwise
	rm -r help/ja

	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}
