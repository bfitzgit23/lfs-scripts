# Depends: caja dbus-glib python3 gtk3 mate-desktop
description="A Caja extension"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=caja-extensions
version=1.28.0
release=1
source="https://github.com/mate-desktop/caja-extensions/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr --disable-gksu --disable-nls
	make
	make DESTDIR=$PKG install

}
