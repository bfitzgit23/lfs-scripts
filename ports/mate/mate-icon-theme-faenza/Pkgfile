# Depends: mate-common
description="Faenza icon theme for MATE"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-icon-theme-faenza
version=1.20.0
release=1
# pub.mate-desktop.org is gone and the theme stopped releasing after 1.20.0, so
# take the tag tarball from the MATE legacy archive.
source="https://github.com/mate-desktop-legacy-archive/$name/archive/refs/tags/v$version/$name-$version.tar.gz"

pkg_build() {
	./autogen.sh --prefix=/usr
	make
	make DESTDIR=$PKG install
}
