# Depends: mate-panel libwnck3 gtk3 glib libx11 libxtst libfakekey
description="A simple window management tool (GTK2 version)"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-netbook
version=1.27.0
release=1
source="https://github.com/mate-desktop/mate-netbook/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib/$name \
		--disable-nls
	make
	make DESTDIR=$PKG install
}
