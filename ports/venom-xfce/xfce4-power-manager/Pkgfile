# Depends: libnotify upower xfce4-panel
description="Power manager for the Xfce desktop"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-power-manager
version=4.20.0
release=2
source="http://archive.xfce.org/src/xfce/xfce4-power-manager/${version%.*}/$name-$version.tar.bz2"

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--sbindir=/usr/bin \
		--localstatedir=/var \
		--enable-x11 \
		--enable-wayland \
		--disable-network-manager \
		--enable-polkit \
		--disable-debug \
		--disable-nls
	make
	make DESTDIR=$PKG install

}
