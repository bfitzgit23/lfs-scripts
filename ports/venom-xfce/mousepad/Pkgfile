# Depends: gtksourceview4 xfconf gspell
description="Simple text editor for Xfce"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mousepad
version=0.7.0
release=1
source="https://gitlab.xfce.org/apps/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

pkg_build() {

	venom-meson $name-$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

}
