# Depends: gtk3 startup-notification xfconf libgtop
description="Widgets library for the Xfce desktop environment"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxfce4ui
version=4.20.2
release=1
source="http://archive.xfce.org/src/xfce/$name/${version%.*}/$name-$version.tar.bz2"

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-x11 \
		--enable-wayland \
		--disable-debug 
	make
	make DESTDIR=$PKG install
}
