# Depends: libxklavier xfce4-panel
description="Plugin to switch keyboard layouts for the Xfce4 panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-xkb-plugin
version=0.9.0
release=1
source="https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz"

pkg_build() {

	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
	
	rm -rf $PKG/usr/share/locale
}
