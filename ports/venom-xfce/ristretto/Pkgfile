# Depends: libexif libxfce4ui
description="Fast and lightweight image viewer for the Xfce desktop"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ristretto
version=0.14.0
release=1
source="http://archive.xfce.org/src/apps/ristretto/${version%.*}/$name-$version.tar.xz"

pkg_build() {

	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
