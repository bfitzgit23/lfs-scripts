# Depends: consolekit2 desktop-file-utils libxfce4windowing polkit-gnome xfdesktop iceauth xinit xrdb
description="Session manager for Xfce"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-session
version=4.20.4
release=1
source="https://archive.xfce.org/src/xfce/xfce4-session/${version%.*}/$name-$version.tar.bz2"

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--enable-x11 \
		--enable-wayland \
		--disable-debug \
		--disable-legacy-sm \
		--disable-nls
	make
	make DESTDIR=$PKG install

}
