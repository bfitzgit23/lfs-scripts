# Depends: gtk-layer-shell garcon libwnck3 thunar
description="Desktop manager for the Xfce Desktop Environment"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfdesktop
version=4.20.2
release=1
source="https://archive.xfce.org/src/xfce/xfdesktop/${version%.*}/$name-$version.tar.bz2
venomboard-nord.png"

pkg_build() {

	./configure \
	    --prefix=/usr \
	    --disable-nls \
	    --enable-thunarx \
	    --enable-x11 \
	    --enable-wayland \
	    --enable-notifications \
	    --with-default-backdrop-filename="/usr/share/backgrounds/xfce/venomboard-nord.png"

	make
	make DESTDIR=$PKG install

	install -Dm644 -t $PKG/usr/share/backgrounds/xfce/ $SRC/venomboard-nord.png

}
