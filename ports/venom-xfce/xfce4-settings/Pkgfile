# Depends: exo garcon libcanberra libnotify libxklavier gnome-icon-theme libinput wayland-protocols
description="Collection of programs that are useful for adjusting your Xfce preferences"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-settings
version=4.20.4
release=1
source="https://archive.xfce.org/src/xfce/xfce4-settings/${version%.*}/$name-$version.tar.bz2"

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--enable-x11 \
		--enable-wayland \
		--enable-xrandr \
		--enable-xcursor \
		--enable-libnotify \
		--enable-libxklavier \
		--enable-pluggable-dialogs \
		--enable-sound-settings \
		--disable-debug \
		--disable-nls
	make
	make DESTDIR=$PKG install

}
