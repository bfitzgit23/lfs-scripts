# Depends: xfce4-panel
description="Shows the date and time in the xfce4 panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-datetime-plugin
version=0.8.3
release=1
source="http://archive.xfce.org/src/panel-plugins/xfce4-datetime-plugin/${version%.*}/xfce4-datetime-plugin-$version.tar.bz2"

pkg_build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib \
		--localstatedir=/var \
		--disable-static \
		--disable-debug \
		--disable-nls
	make
	make DESTDIR=$PKG install

}
