# Depends: curl openssl-32 libpsl-32
description="Utility and a library used for transferring files"
homepage="https://curl.se/	"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=curl-32
version=8.21.0
release=1
source="https://curl.haxx.se/download/${name%-*}-$version.tar.xz"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

	cd ${name%-*}-$version

	autoreconf -fi
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-static \
		--disable-ldap \
		--disable-ldaps \
		--enable-threaded-resolver \
		--with-ca-bundle=/etc/ssl/certs/ca-certificates.crt \
		--with-openssl \
		--without-brotli \
		--without-libidn2 \
		--without-librtmp \
		--without-nghttp2 \
		--without-zstd
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
