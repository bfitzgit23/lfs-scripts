# Depends: clang-32 elfutils-32 glslang libdrm-32 libglvnd-32 libva-32 libxdamage-32 libxfixes-32 libxrandr-32 libxshmfence-32 libxv-32 libxvmc-32 libxxf86vm-32 llvm-32 mesa spirv-llvm-translator-32 wayland-32 zlib-32
description="OpenGL compatible 3D graphics library"
homepage="https://www.mesa3d.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mesa-32
version=26.1.3
release=1

### BEGIN Rust crates
rust_crates="paste 1.0.14
proc-macro2 1.0.86
quote 1.0.35
rustc-hash 2.1.1
syn 2.0.87
unicode-ident 1.0.12"

# Full list crates
gen_rust_crates () {
	grep crates.io subprojects/*.wrap | \
	sed -r 's|.*crates/([^/]+)/([0-9.]+)/download|\1 \2|'
}

rcrate=""
while IFS= read -r line; do
    set -- $line
    crate_name=$1
    crate_version=$2
    rcrate="$rcrate $crate_name-$crate_version.tar.gz::https://crates.io/api/v1/crates/$crate_name/$crate_version/download"
done <<EOF 
$rust_crates 
EOF
### END Rust crates

source="https://mesa.freedesktop.org/archive/${name%-*}-$version.tar.xz
	crossfile $rcrate"

pkg_build() {
	cd ${name%-*}-$version 

	# Add subproject sources
        export MESON_PACKAGE_CACHE_DIR="$SRC"

	export BINDGEN_EXTRA_CLANG_ARGS="-m32"
	export PKG_CONFIG_LIBDIR='/usr/lib32/pkgconfig:/usr/share/pkgconfig'

	scratch isinstalled vulkan-icd-loader-32 && OPT_MESA_GALLIUM='zink,'
	scratch isinstalled wayland-protocols && OPT_MESA_PLATFORMS='wayland,x11' ||  OPT_MESA_PLATFORMS='x11'

	# CBUILD: enable o disable CBUILD_MESA_OPTS, source CBUILD_MESA_OPTS from mesa.opt file
	CBUILD_MESA_OPTS="-Dshared-llvm=enabled 
	-Dglx=dri 
	-Dgallium-drivers=${OPT_MESA_GALLIUM}crocus,iris,nouveau,r300,r600,radeonsi,svga,virgl,i915,tegra 
	-Dplatforms=${OPT_MESA_PLATFORMS} 
	-Dgallium-mediafoundation=disabled 
	-Dintel-rt=disabled 
	-Dgallium-rusticl=true 
	-Dvulkan-drivers=amd,intel,intel_hasvk,nouveau,swrast 
	$OPT_MESA_VAAPI
	"
	cbuild_options "${name%-*}"

	venom-meson build \
		--cross-file=$SRC/crossfile \
		--libdir=/usr/lib32 \
		-Db_lto=false \
		-Degl=enabled \
		-Dgbm=enabled \
		-Dgles1=disabled \
 		-Dgles2=enabled \
		-Dllvm=enabled \
		-Dglvnd=enabled \
		-Dvideo-codecs=vc1dec,h264dec,h264enc,h265dec,h265enc \
		-Dvulkan-layers=device-select,overlay $CBUILD_MESA_OPTS 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# indirect rendering symlink
	ln -s libGLX_mesa.so.0 $PKG/usr/lib32/libGLX_indirect.so.0
  
	rm -rf $PKG/usr/include $PKG/usr/share/glvnd $PKG/etc/OpenCL
	rm -f $PKG/usr/share/drirc.d/00-mesa-defaults.conf
	rm -f $PKG/usr/share/drirc.d/00-radv-defaults.conf

	
	[ -f "/usr/bin/mesa-overlay-control.py" ] && \
		rm $PKG/usr/bin/mesa-overlay-control.py

	[ -f "/usr/share/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json" ] && \
		rm $PKG/usr/share/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json

	[ -f "/usr/share/vulkan/explicit_layer.d/VkLayer_INTEL_nullhw.json" ] && \
		rm $PKG/usr/share/vulkan/explicit_layer.d/VkLayer_INTEL_nullhw.json

	[ -f "/usr/share/vulkan/explicit_layer.d/VkLayer_MESA_overlay.json" ] && \
		rm $PKG/usr/share/vulkan/explicit_layer.d/VkLayer_MESA_overlay.json
}
