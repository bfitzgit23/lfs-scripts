# Depends: libxml2 icu-32 xz-32 zlib-32
description="Contains libraries and utilities used for parsing XML files"
homepage="https://gitlab.gnome.org/GNOME/libxml2"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxml2-32
version=2.15.3
release=1
source="https://download.gnome.org/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

        venom-meson ${name%-*}-$version build \
                --prefix=/usr \
		--libdir=/usr/lib32 \
		--libexecdir=/usr/lib32 \
		-Dhistory=disabled \
		-Dhttp=enabled \
		-Dicu=enabled \
		-Dlegacy=enabled \
		-Dpython=disabled
        meson compile -C build
        DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build
	
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
