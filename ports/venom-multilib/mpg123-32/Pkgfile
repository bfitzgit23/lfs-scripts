# Depends: mpg123 alsa-lib-32
description="Console-based MP3 player"
homepage="https://mpg123.de/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mpg123-32
version=1.33.6
release=1
source="https://downloads.sourceforge.net/mpg123/mpg123-$version.tar.bz2"

pkg_build() {
	cd mpg123-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure --prefix=/usr --libdir=/usr/lib32 --with-audio="alsa" --with-cpu=i586
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
