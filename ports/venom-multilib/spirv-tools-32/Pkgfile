# Depends: spirv-headers
description="API and commands for processing SPIR-V modules"
homepage="https://www.khronos.org/vulkan"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=spirv-tools-32
version=1.4.350.1
release=1
source="${name%-*}-$version.tar.gz::https://github.com/KhronosGroup/SPIRV-Tools/archive/vulkan-sdk-$version.tar.gz"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
        export ASMFLAGS="-m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cmake -S SPIRV-Tools-vulkan-sdk-$version -B build -G Ninja \
		-D CMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
		-D CMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
		-D BUILD_SHARED_LIBS=ON \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=lib32 \
		-D CMAKE_BUILD_TYPE=Release \
		-D SPIRV_WERROR=OFF \
		-D SPIRV_SKIP_TESTS=ON \
		-D SPIRV-Headers_SOURCE_DIR=/usr \
		-D SPIRV_TOOLS_BUILD_STATIC=OFF \
		-Wno-dev 
        cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -rf $PKG/usr/share $PKG/usr/include $PKG/usr/bin
}
