# Depends: libxxf86vm xorgproto-32 libx11-32 libxext-32
description="X11 XFree86 video mode extension library"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxxf86vm-32
version=1.1.7
release=1
source="${name%-*}-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXxf86vm-$version.tar.xz"

pkg_build() {
	cd libXxf86vm-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}

