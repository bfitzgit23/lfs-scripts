# Depends: openssl
description="Management tools and libraries relating to cryptography"
homepage="https://www.openssl.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"


name=openssl-32
version=3.6.3
release=1
source="https://github.com/${name%-*}/${name%-*}/releases/download/${name%-*}-$version/${name%-*}-$version.tar.gz"

pkg_build() {
	cd ${name%-*}-$version

        export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

  	./Configure --prefix=/usr      \
	         --openssldir=/etc/ssl \
	         --libdir=lib32        \
		 -m32 linux-generic32  \
	         shared                \
	         zlib-dynamic
	make

	# disable static lib
	sed -i '/INSTALL_LIBS/s/libcrypto.a libssl.a//' Makefile

	make DESTDIR=$PKG MANDIR=/usr/share/man MANSUFFIX=ssl install

	rm -fr $PKG/etc/ $PKG/usr/share $PKG/usr/include $PKG/usr/bin
}
