# Depends: elfutils zlib-32 curl-32
description="utilities and libraries for handling ELF files"
homepage="https://sourceware.org/elfutils/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=elfutils-32
version=0.195
release=1
source="https://sourceware.org/ftp/elfutils/$version/elfutils-$version.tar.bz2"

pkg_build() {
	cd elfutils-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	# https://sourceware.org/PR23914
	sed -i 's:-Werror::' */Makefile.in

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--sysconfdir=/etc \
		--program-prefix="eu-" \
		--disable-debuginfod \
		--disable-libdebuginfod \
		--disable-nls \
		--enable-deterministic-archives \
		--without-zstd
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
