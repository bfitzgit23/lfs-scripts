# Depends: libffi
description="Portable foreign function interface library"
homepage="https://sourceware.org/libffi/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libffi-32
version=3.6.0
release=1
source="https://github.com/libffi/libffi/releases/download/v$version/libffi-$version.tar.gz"

pkg_build() {
	cd libffi-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

  	sed -e '/^includesdir/ s/$(libdir).*$/$(includedir)/' \
	    -i include/Makefile.in

	sed -e '/^includedir/ s/=.*$/=@includedir@/' \
	    -e 's/^Cflags: -I${includedir}/Cflags:/' \
	    -i libffi.pc.in

	./configure --prefix=/usr --libdir=/usr/lib32 --disable-static --with-gcc-arch=x86-64
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
