# Depends: cairo libpng-32 pixman-32 fontconfig-32 glib-32 libxcb-32 libxrender-32 libx11-32 libxext-32
description="2D graphics library with support for multiple output devices"
homepage="https://cairographics.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=cairo-32
version=1.18.4
release=2
source="https://gitlab.freedesktop.org/cairo/cairo/-/archive/$version/${name%-*}-$version.tar.bz2"

pkg_build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson ${name%-*}-$version build \
		--libdir=lib32 \
		--buildtype=plain \
		-Ddwrite=disabled \
		-Dspectre=disabled \
		-Dsymbol-lookup=disabled \
		-Dtests=disabled
	meson compile -C build
	DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
