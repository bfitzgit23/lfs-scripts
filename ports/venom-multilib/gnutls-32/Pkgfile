# Depends: gnutls libtasn1-32 libunistring-32 nettle-32 p11-kit-32
description="Libraries and userspace tools which provide a secure layer over a reliable transport layer"
homepage="https://www.gnutls.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gnutls-32
version=3.8.13
mver=$(echo $version | awk -F. '{print $1"."$2}')
release=1
source="https://www.gnupg.org/ftp/gcrypt/gnutls/v$mver/gnutls-${version}.tar.xz"

pkg_build() {
	cd gnutls-${version%.1}

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"
        export PKG_CONFIG_PATH="$NETTLE3_ROOT:$PKG_CONFIG_PATH"

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--host=i686-pc-linux-gnu \
		--with-zlib \
		--with-included-unistring \
		--with-included-libtasn1 \
		--disable-year2038 \
		--disable-static \
		--disable-valgrind-tests
        sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
	make DESTDIR=$PWD/DESTDIR install

        mkdir -p $PKG/usr/lib32
	mv DESTDIR/usr/lib32/* $PKG/usr/lib32/      
}

