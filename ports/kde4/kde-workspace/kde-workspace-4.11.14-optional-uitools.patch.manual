+#ifndef WITHOUT_UITOOLS
 #include <QUiLoader>
+#endif
 
 #include <KColorScheme>
 #include <KDebug>
@@ -208,6 +210,7 @@
 
     void createConfigurationInterfaceForPackage()
     {
+#ifndef WITHOUT_UITOOLS
         const QString uiFile = containment.data()->package()->filePath("mainconfigui");
         if (uiFile.isEmpty()) {
             kWarning() << "No ui file found for containment";
@@ -228,6 +231,10 @@
         } else {
             kWarning() << "Failed to load widget from" << uiFile;
         }
+#else
+        kWarning() << "This build has no QtUiTools module: the wallpaper package's"
+                   << "configuration UI cannot be shown";
+#endif
     }
 };
 
