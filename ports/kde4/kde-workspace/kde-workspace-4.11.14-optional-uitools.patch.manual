--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,6 +20,25 @@
 
 option(WITH_XINERAMA "Xinerama support for multi-headed X displays" ON)
 
+# QtUiTools (QUiLoader) is an optional Qt module - Qt 4 builds it only from
+# tools/designer/src/uitools, so a Qt configured without its tools part has
+# none.  The workspace uses it to load the .ui files that wallpaper and
+# window-decoration packages ship; build those parts out when it is missing
+# instead of leaving them with an undefined reference to QUiLoader.
+option(WITH_UITOOLS "Build the parts that need QtUiTools (QUiLoader)" ON)
+if (WITH_UITOOLS)
+   set(KDE4WORKSPACE_UITOOLS_LIBS ${QT_QTUITOOLS_LIBRARY})
+else (WITH_UITOOLS)
+   set(KDE4WORKSPACE_UITOOLS_LIBS "")
+   add_definitions(-DWITHOUT_UITOOLS)
+   message(WARNING "\n"
+      "kde-workspace: QtUiTools (QUiLoader) is unavailable, building without it.\n"
+      "  disabled: the wallpaper package settings page, the window-decoration\n"
+      "            settings page and the scripted effect/decoration\n"
+      "            configuration UIs, all of which load package .ui files.\n"
+      "  re-enable: provide libQtUiTools.a in Qt 4's library directory.\n")
+endif (WITH_UITOOLS)
+
 find_package(Strigi)
 
 set_package_properties(Strigi PROPERTIES DESCRIPTION "Desktop indexing and search support"
--- a/libs/plasmagenericshell/CMakeLists.txt
+++ b/libs/plasmagenericshell/CMakeLists.txt
@@ -35,7 +35,7 @@
 
 kde4_add_library(plasmagenericshell SHARED ${plasmagenericshell_LIB_SRCS})
 
-target_link_libraries(plasmagenericshell ${KDE4_PLASMA_LIBS} ${KDE4_KDEUI_LIBS} ${KDE4_KFILE_LIBS} ${QT_QTSCRIPT_LIBRARY} ${QT_QTDECLARATIVE_LIBRARY} ${QT_QTUITOOLS_LIBRARY} kworkspace kephal)
+target_link_libraries(plasmagenericshell ${KDE4_PLASMA_LIBS} ${KDE4_KDEUI_LIBS} ${KDE4_KFILE_LIBS} ${QT_QTSCRIPT_LIBRARY} ${QT_QTDECLARATIVE_LIBRARY} ${KDE4WORKSPACE_UITOOLS_LIBS} kworkspace kephal)
 if(UNIX AND Q_WS_X11)
     target_link_libraries(plasmagenericshell ${X11_LIBRARIES})
 endif(UNIX AND Q_WS_X11)
