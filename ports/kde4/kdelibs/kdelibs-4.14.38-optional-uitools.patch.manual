@@ -48,9 +48,12 @@
    pixmap.cpp point.cpp rect.cpp size.cpp url.cpp
    brush.cpp
    QBrush_bind.cpp
-   quiloader_binding.cpp
    )
 
+if (WITH_UITOOLS)
+   list(APPEND kjsembed_LIB_SRCS quiloader_binding.cpp)
+endif (WITH_UITOOLS)
+
 if (NOT DEFINED QT_ONLY)
    set(KJSLIBNAME kjs)
    set(KJSEMBEDLIBNAME kjsembed)
@@ -64,9 +67,13 @@
    endif (NOT QTONLY_WEBKIT)
 endif (NOT DEFINED QT_ONLY)
 
+if (WITH_UITOOLS)
+   set(kjsembed_UITOOLS_LIBS ${QT_QTUITOOLS_LIBRARY})
+endif (WITH_UITOOLS)
+
 kde4_add_library(${KJSEMBEDLIBNAME} ${LIBRARY_TYPE} ${kjsembed_LIB_SRCS})
 
-target_link_libraries(${KJSEMBEDLIBNAME} LINK_PRIVATE ${KDE4_KDECORE_LIBS} ${QT_QTUITOOLS_LIBRARY} ${QT_QTGUI_LIBRARY} ${QT_QTSVG_LIBRARY} ${QT_QTXML_LIBRARY} ${QT_QTCORE_LIBRARY} ${KJSLIBNAME} )
+target_link_libraries(${KJSEMBEDLIBNAME} LINK_PRIVATE ${KDE4_KDECORE_LIBS} ${kjsembed_UITOOLS_LIBS} ${QT_QTGUI_LIBRARY} ${QT_QTSVG_LIBRARY} ${QT_QTXML_LIBRARY} ${QT_QTCORE_LIBRARY} ${KJSLIBNAME} )
 
 set_target_properties(${KJSEMBEDLIBNAME} PROPERTIES VERSION ${GENERIC_LIB_VERSION} SOVERSION ${GENERIC_LIB_SOVERSION} )
 install(TARGETS ${KJSEMBEDLIBNAME} EXPORT kdelibsLibraryTargets ${INSTALL_TARGETS_DEFAULT_ARGS})
