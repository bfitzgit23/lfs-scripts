--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -32,6 +32,23 @@
 
 option(STATIC_LIBRARY "Build kdelibs as static libraries." FALSE)
 
+# QtUiTools (QUiLoader) is an optional Qt module.  Qt 4 builds it only from
+# tools/designer/src/uitools, so a Qt configured without its tools part has no
+# libQtUiTools.a.  Everything in kdelibs that needs QUiLoader is droppable, so
+# build it out instead of refusing to configure.
+option(WITH_UITOOLS "Build the parts that need QtUiTools (QUiLoader)" ON)
+if (NOT WITH_UITOOLS)
+   add_definitions(-DWITHOUT_UITOOLS)
+   message(WARNING "\n"
+      "kdelibs: QtUiTools (QUiLoader) is unavailable, building without it.\n"
+      "  disabled: KJSEmbed's QUiLoader binding and the QWidget/QAction/\n"
+      "            QActionGroup/QLayout constructors that load widgets by\n"
+      "            class name, Kross' forms module, the QtScript Kross\n"
+      "            widget-binding plugin (krossqtsplugin) and Plasma applets'\n"
+      "            mainconfigui .ui configuration pages.\n"
+      "  re-enable: provide libQtUiTools.a in Qt 4's library directory.\n")
+endif (NOT WITH_UITOOLS)
+
 ################# write platform profile file which will be installed #################
 include(CreateKDEPlatformProfile.cmake)
 
