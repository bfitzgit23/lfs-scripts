# Depends: thunar taglib libxfce4ui gtk3 glib
description="adds special features for media files to the Thunar File Manager"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=thunar-media-tags-plugin
version=0.6.0
release=1
source="https://gitlab.xfce.org/thunar-plugins/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

pkg_build() {

	venom-meson $SRC/$name-$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
