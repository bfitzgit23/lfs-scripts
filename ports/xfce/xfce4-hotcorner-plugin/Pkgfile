# Depends: xfce4-panel libnotify
description="Provides an easy way to set up hot corners in the Xfce desktop environment"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-hotcorner-plugin
version=0.0.4
release=1
source=(https://github.com/christopherkobayashi/$name/archive/refs/tags/$version.tar.gz)
renames=(xfce4-hotcorner-plugin-0.0.4.tar.gz)

pkg_build() {

	CFLAGS="$CFLAGS -w"
    ./configure --prefix=/usr --disable-debug
    make
    make DESTDIR=$PKG  install
}
