# Depends: xfce4-panel libical popt libnotify
description="A simple calendar application with reminders for Xfce"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=orage
version=4.21.0
release=1
source="https://gitlab.xfce.org/apps/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

pkg_build() {

	venom-meson $SRC/$name-$name-$version build -Dx11-tray-icon=true
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
