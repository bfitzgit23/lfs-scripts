# Depends: xfce4-panel
description="CPU frequency plugin for the Xfce4 panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-cpufreq-plugin
version=1.3.0
release=1
source="https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz"

pkg_build() {

	venom-meson $SRC/$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
