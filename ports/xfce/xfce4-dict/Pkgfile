# Depends: xfce4-panel
description="A dictionary plugin for the Xfce panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-dict
version=0.8.9
release=1
source="https://gitlab.xfce.org/apps/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

pkg_build() {

	venom-meson $name-$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

}
