# Depends: xfce4-panel xfce4-dev-tools
description="Shows the date and time in the xfce4 panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-datetime-plugin
version=0.8.3
release=1
# 0.8.3 never reached archive.xfce.org, so build from the tagged source; its
# autogen.sh runs xdt-autogen, which turns configure.ac.in into configure.
source="https://gitlab.xfce.org/panel-plugins/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

pkg_build() {
	./autogen.sh \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib \
		--localstatedir=/var \
		--disable-static \
		--disable-debug \
		--disable-nls
	make
	make DESTDIR=$PKG install

}
