# Depends: python3-gpep517 python3-installer python3-setuptools

# description	: CompizConfig graphical Settings Manager (GTK3/Python3)
# homepage	: https://gitlab.com/compiz/ccsm
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="CompizConfig graphical Settings Manager (GTK3/Python3)"
name=ccsm
version=0.8.18
release=2
source="https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2"

pkg_build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=.
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
    python3 -m installer -d $PKG .dist/*.whl
}
