# Depends: nss libxtst libappindicator libnotify
description="Internxt Drive client UI"
homepage="https://internxt.com/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=internxt-bin
version=2.5.4
_name=Internxt-${version}.AppImage
release=1
source="${_name}::https://github.com/internxt/drive-desktop-linux/releases/download/v${version}/Internxt-${version}.AppImage"

pkg_build() {
	chmod +x "${_name}"
	./"${_name}" --appimage-extract

	# Correct path for .desktop file
	sed -e "s/AppRun/${name%-bin}/g" -i "squashfs-root/${name%-bin}.desktop"


	install -d "$PKG/opt/${name%-bin}"
	cp -a "squashfs-root/." "$PKG/opt/${name%-bin}"
	chmod -R +rx "$PKG/opt/${name%-bin}"

	install -d "$PKG/usr/bin"
	ln -s "/opt/${name%-bin}/${name%-bin}" "$PKG/usr/bin/${name%-bin}"

	install -d "$PKG/usr/share"
	cp -r "squashfs-root/usr/share/." "${PKG}/usr/share/"

	find "$PKG" -type d -exec chmod 755 {} +

	install -Dm644 "squashfs-root/${name%-bin}.desktop" "$PKG/usr/share/applications/${name%-bin}.desktop"
}
