# Depends: glib
description="A library that implements the Desktop Menu Specifications from freedesktop.org"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-menus
version=1.28.1
release=1
source="https://github.com/mate-desktop/$name/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr --sysconfdir=/etc --disable-nls
	make
	make DESTDIR=$PKG install
}
