# Depends: libwnck3 librsvg mate-desktop mate-menus libmateweather itstool
description="The MATE panel"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-panel
version=1.28.7
release=1
source="https://github.com/mate-desktop/$name/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr --libexecdir=/usr/lib/$name --disable-nls
	make
	make DESTDIR=$PKG install

}
