# Depends: gobject-introspection cairo cyrus-sasl gdk-pixbuf glib gtk3 gstreamer gst-plugins-base gst-plugins-good json-glib libcap-ng libepoxy libjpeg-turbo libusb lz4 openssl opus pixman polkit python3-pyparsing python3-six spice-protocol usbredir wayland wayland-protocols zlib bfs-spkgbuild-macros
# description	: GTK3 SPICE client library and widget
# homepage	: https://www.spice-space.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GTK3 SPICE client library and widget"
name=spice-gtk
version=0.42
release=2
build_opt=(
    -Dgtk=enabled
    -Dwayland-protocols=enabled
    -Dwebdav=disabled
    -Dusbredir=enabled
    -Dlibcap-ng=enabled
    -Dpolkit=enabled
    -Dintrospection=enabled
    -Dvapi=disabled
    -Dlz4=enabled
    -Dsasl=enabled
    -Dopus=enabled
    -Dsmartcard=disabled
    -Degl=enabled
    -Dgtk_doc=disabled
)
source="https://www.spice-space.org/download/gtk/spice-gtk-$version.tar.xz"

pkg_build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=.
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
