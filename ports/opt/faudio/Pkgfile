# Depends: sdl2 gst-libav
# description	: XAudio2 reimplementation
# homepage	: https://github.com/FNA-XNA/FAudio/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="XAudio2 reimplementation"
name=faudio
version=26.11
release=1
source="https://github.com/FNA-XNA/FAudio/archive/$version/$name-$version.tar.gz"

pkg_build() {
	cd "$SRC/FAudio-26.11" || return 1
  cmake -S $SRC/FAudio-$version -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -Wno-dev

  cmake --build build
  DESTDIR=$PKG cmake --install build
}
