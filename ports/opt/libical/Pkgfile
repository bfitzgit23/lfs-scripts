# Depends: cmake glib gobject-introspection libxml2 vala
# description	: The libical package contains an implementation of the iCalendar protocols and data formats.
# homepage	: https://github.com/libical
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: db doxygen graphviz gtk-doc icu pygobject

description="The libical package contains an implementation of the iCalendar protocols and data formats."
name=libical
version=3.0.20
release=1
build_opt=(
  -DCMAKE_INSTALL_PREFIX=/usr
  -DCMAKE_BUILD_TYPE=Release
  -DSTATIC_ONLY=OFF
  -DICAL_GLIB=true
  -DGOBJECT_INTROSPECTION=true
  -DICAL_GLIB_VAPI=true
  -DLIBICAL_BUILD_TESTING=false
  -DICAL_BUILD_DOCS=false
)
source="https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.gz"

pkg_build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=.
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  cmake -S . -B build "${build_opt[@]}"

  cmake --build build -j1

  DESTDIR="$PKG" cmake --install build
}
