# Depends: boost valgrind bfs-spkgbuild-macros
# description	: exempi package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="exempi package"
name=exempi
version=2.6.6
release=2
source="https://libopenraw.freedesktop.org/download/${name}-${version}.tar.xz"

pkg_build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=.
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
