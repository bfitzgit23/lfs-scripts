# Depends: libxslt docbook-xml
# description	: A collection of XSL stylesheets that are useful for performing transformations on XML DocBook files.
# homepage	: http://docbook.sourceforge.net/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A collection of XSL stylesheets that are useful for performing transformations on XML DocBook files."
name=docbook-xsl-nons
version=1.79.2
release=5
source=(https://github.com/docbook/xslt10-stylesheets/releases/download/release/$version/$name-$version.tar.bz2 https://www.linuxfromscratch.org/patches/blfs/svn/$name-$version-stack_fix-1.patch)

pkg_build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done



	install -v -m 0755 -d $PKG/usr/share/xml/docbook/xsl-stylesheets-$version

	cp -v -R \
		VERSION common eclipse epub epub3 fo \
		highlighting html htmlhelp images javahelp lib manpages \
		params profiling roundtrip slides template tests tools website \
		xhtml xhtml-1_1 xhtml5 \
		$PKG/usr/share/xml/docbook/xsl-stylesheets-$version

	ln -s VERSION $PKG/usr/share/xml/docbook/xsl-stylesheets-${version}/VERSION.xsl

	ln -sf xsl-stylesheets-$version $PKG/usr/share/xml/docbook/xsl-stylesheets

	find $PKG \( -name "NEWS*" -o -name "README*" -o -name "ChangeLog*" \) -delete

	# pkgmk has no post-install hook, so the rewrites this package used to add
	# to /etc/xml/catalog never appeared.  Ship them in a catalogue of its own,
	# at the path docbook-xml's master catalogue delegates to, so xsltproc
	# resolves http://docbook.sourceforge.net/release/xsl/ with either this
	# package or docbook-xsl installed.  Both install the same stylesheet tree,
	# so they are alternatives; install only one of them.
	install -d "$PKG/etc/xml" || return 1
	XSL_CATALOG="$PKG/etc/xml/docbook-xsl"
	xmlcatalog --noout --create "$XSL_CATALOG" || return 1
	for base in "http://docbook.sourceforge.net/release/xsl/$version" \
			"http://docbook.sourceforge.net/release/xsl/current"; do
		xmlcatalog --noout --add "rewriteSystem" "$base" \
			"/usr/share/xml/docbook/xsl-stylesheets-$version" \
			"$XSL_CATALOG" || return 1
		xmlcatalog --noout --add "rewriteURI" "$base" \
			"/usr/share/xml/docbook/xsl-stylesheets-$version" \
			"$XSL_CATALOG" || return 1
	done
}
