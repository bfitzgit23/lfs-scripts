# Depends: parted pkgconf python3 python3-setuptools python3-gpep517 python3-installer
# description	: Python bindings for GNU Parted
# homepage	: https://github.com/dcantrell/pyparted
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python bindings for GNU Parted"
name=python3-pyparted
version=3.13.0
release=1
source="https://files.pythonhosted.org/packages/source/p/pyparted/pyparted-${version}.tar.gz"

pkg_build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pyparted-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=.
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
