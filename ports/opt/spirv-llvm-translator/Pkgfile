# Depends: libxml2 llvm spirv-headers spirv-tools
# description	: Bidirectional translation between LLVM IR and SPIR-V
# homepage	: https://github.com/KhronosGroup/SPIRV-LLVM-Translator
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Bidirectional translation between LLVM IR and SPIR-V"
name=spirv-llvm-translator
version=23.1.3
release=3
# Upstream compiles against the SPIRV-Headers commit named in
# spirv-headers-tag.conf, not against a Khronos release: the
# SPV_INTEL_subgroup_bitcast_shuffle capability (6207) and opcode (6208)
# that the 23.x sources reference only exist on SPIRV-Headers main so far,
# and the newest Vulkan SDK headers (1.4.363.0) still lack them.
_spirv_headers_commit=cb42dec3830d3ac67fa449ecdc0c0f73d5e74498
source=(https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v${version}/SPIRV-LLVM-Translator-${version}.tar.gz
	https://github.com/KhronosGroup/SPIRV-Headers/archive/$_spirv_headers_commit/SPIRV-Headers-$_spirv_headers_commit.tar.gz)

pkg_build() {
	cd "$SRC/SPIRV-LLVM-Translator-$version" || return 1
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR="$SRC/SPIRV-Headers-$_spirv_headers_commit" \
        -G Ninja || return $?
    cmake --build build -j "${JOBS:-1}" || return $?
    DESTDIR="$PKG" cmake --install build || return $?
}
