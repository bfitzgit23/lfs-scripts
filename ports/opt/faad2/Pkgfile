# Depends: cmake bfs-spkgbuild-macros
# description	: faad2 package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="faad2 package"
name=faad2
version=2.11.4
release=2
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
      -DCMAKE_BUILD_TYPE=Release
      -DBUILD_SHARED_LIBS=ON"
source="https://github.com/knik0/${name}/archive/${version}/${name}-${version}.tar.gz"

pkg_build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$SRC/faad2-2.11.4" || return 1
	bfs_autobuild
}
