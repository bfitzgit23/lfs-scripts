# Depends: s6
description="A complete service manager for s6 systems."
homepage="https://skarnet.org/software/s6-rc/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=s6-rc
version=0.6.1.1
release=1
source=(https://git.sr.ht/~skarnet/s6-rc/archive/v$version.tar.gz)
renames=(s6-rc-0.6.1.1.tar.gz)

pkg_build() {
	cd $name-v$version
	./configure \
		--bindir=/bin \
		--prefix=/usr \
		--libdir=/usr/lib \
		--libexecdir=/usr/lib \
		--datadir=/etc \
		--enable-shared \
		--disable-static \
		--disable-allstatic \
		--disable-static-libc
	make
	make DESTDIR=$PKG install
}
