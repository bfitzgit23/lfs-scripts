# Depends: skalibs execline
description="skarnet.org's small & secure supervision software suite. Comes with an ultra-fast init replacement, process management tools, an asynchronous locking library, and more."
homepage="https://skarnet.org/software/s6/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=s6
version=2.15.0.0
release=1
source=(https://git.sr.ht/~skarnet/s6/archive/v$version.tar.gz)
renames=(s6-2.15.0.0.tar.gz)

pkg_build() {
	if [ -d $name-v$version ]; then cd $name-v$version; fi

	./configure \
		--bindir=/bin \
		--prefix=/usr \
		--libdir=/usr/lib \
		--libexecdir=/usr/lib \
		--datadir=/etc \
		--enable-shared \
		--disable-static \
		--disable-allstatic \
		--disable-static-libc
	make
	make DESTDIR=$PKG install
}
