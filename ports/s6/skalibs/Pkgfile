description="A general-purpose utility library for secure, small C development"
homepage="https://www.skarnet.org/software/skalibs/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=skalibs
version=2.15.0.0
release=1
source="$name-$version.tar.gz::https://git.sr.ht/~skarnet/skalibs/archive/v$version.tar.gz"

pkg_build() {
	cd $name-v$version
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib \
		--datadir=/etc \
		--enable-shared \
		--disable-static
	make
	make DESTDIR=$PKG install
}
