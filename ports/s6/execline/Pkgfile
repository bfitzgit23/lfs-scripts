# Depends: skalibs
description="A small scripting language, to be used in place of a shell in non-interactive scripts"
homepage="https://skarnet.org/software/execline"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=execline
version=2.9.9.1
release=1
source=(https://git.sr.ht/~skarnet/execline/archive/v$version.tar.gz)
renames=(execline-2.9.9.1.tar.gz)

pkg_build() {
	if [ -d $name-v$version ]; then cd $name-v$version; fi
	./configure \
		--bindir=/bin \
		--prefix=/usr \
		--libdir=/usr/lib \
		--datadir=/etc \
		--enable-shared \
		--disable-static \
		--disable-allstatic \
		--disable-static-libc
	make
	make DESTDIR=$PKG install
}
