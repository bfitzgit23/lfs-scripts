description="The principal firewall tool for Linux"
homepage="https://www.netfilter.org/projects/iptables/index.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=iptables
version=1.8.13
release=2
source="https://www.netfilter.org/projects/iptables/files/$name-$version.tar.xz"

pkg_build() {

	./configure \
		--prefix=/usr \
	        --sbindir=/sbin \
	        --enable-libipq \
		--enable-nftables
	make
	make DESTDIR=$PKG install

	ln -sf iptables-nft $PKG/sbin/iptables
}
