# Depends: libdrm eudev xorg-server xorgproto
description="X.Org Video Driver for NVidia Cards"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xf86-video-nouveau
version=1.0.18
release=1
source="https://www.x.org/pub/individual/driver/$name-$version.tar.xz"

pkg_build() {

	export CFLAGS="$CFLAGS -fPIC"

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
