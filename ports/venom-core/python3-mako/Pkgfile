# Depends: python3-setuptools python3-markupsafe python3-gpep517 python3-wheel
description="Python module that implements hyperfast and lightweight templating for the Python platform"
homepage="https://github.com/sqlalchemy/mako"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-mako
version=1.3.12
release=1
source="$name-$version.tar.gz::https://pypi.org/packages/source/m/mako/mako-$version.tar.gz"

pkg_build() {
	cd mako-$version

	    gpep517 build-wheel \
		    --wheel-dir .dist \
		    --output-fd 3 3>&1 >&2

		python3 -m installer -d $PKG \
		    .dist/*.whl
}
