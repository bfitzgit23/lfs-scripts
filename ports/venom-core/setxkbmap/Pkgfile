# Depends: libxkbfile libxrandr
description="Set the keyboard using the X Keyboard Extension"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=setxkbmap
version=1.3.5
release=1
source="http://ftp.x.org/pub/individual/app/setxkbmap-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
