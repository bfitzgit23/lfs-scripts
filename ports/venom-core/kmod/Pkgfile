# Depends: xz zlib zstd
description="Libraries and utilities for loading kernel modules"
homepage="https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=kmod
version=34.2
release=1
source="https://www.kernel.org/pub/linux/utils/kernel/$name/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build \
		--bindir=/bin \
		--sbindir=/sbin \
		-Ddlopen=all \
		-Dmanpages=false 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
