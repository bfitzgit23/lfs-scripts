# Depends: libinput xorg-server
description="Wrapper around libinput and allows for libinput to be used for input devices in X"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xf86-input-libinput
version=1.5.0
release=1
source="https://www.x.org/releases/individual/driver/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr --sysconfdir=/etc \
		--localstatedir=/var --disable-static
	make
	make DESTDIR=$PKG install
}
