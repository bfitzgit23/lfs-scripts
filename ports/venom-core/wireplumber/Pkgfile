# Depends: cpptoml lua pipewire
description="Session/policy manager implementation for PipeWire"
homepage="https://gitlab.freedesktop.org/pipewire/wireplumber"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=wireplumber
version=0.5.15
release=1
source="https://gitlab.freedesktop.org/pipewire/wireplumber/-/archive/$version/$name-$version.tar.gz"

pkg_build() {

	venom-meson $name-$version build \
	    -D system-lua=true \
	    -D system-lua-version=auto \
	    -D introspection=disabled \
	    -D doc=disabled \
	    -D elogind=disabled \
	    -D systemd=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -r $PKG/usr/share/locale
}
