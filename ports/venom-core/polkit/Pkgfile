# Depends: duktape gobject-introspection intltool linux-pam
description="Toolkit for defining and handling authorizations"
homepage="https://freedesktop.org/software/polkit"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=polkit
version=127
release=5
source="$name-$version.tar.gz::https://github.com/polkit-org/$name/archive/refs/tags/$version.tar.gz
	22193ca2cc0f4e023d331cc1391f55143ef9cade.patch
	patch-src_polkit_polkitunixsession.c
	patch-src_polkitbackend_polkitbackendsessionmonitor.c
	polkit-1"

pkg_build() {
	export XML_CATALOG_FILES=/etc/xml/catalog

	patch -Rp1 -d $name-$version -i $SRC/22193ca2cc0f4e023d331cc1391f55143ef9cade.patch
	patch -Np0 -d $name-$version -i $SRC/patch-src_polkit_polkitunixsession.c
	patch -Np0 -d $name-$version -i $SRC/patch-src_polkitbackend_polkitbackendsessionmonitor.c

  	venom-meson $name-$version build -Dsession_tracking="ConsoleKit" -Dos_type=suse
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	chown polkitd $PKG/etc/polkit-1/rules.d
	chown polkitd $PKG/usr/share/polkit-1/rules.d
	chmod 700 $PKG/etc/polkit-1/rules.d
	chmod 700 $PKG/usr/share/polkit-1/rules.d
	chmod 4775 $PKG/usr/bin/pkexec
	chmod 4755 $PKG/usr/lib/polkit-1/polkit-agent-helper-1

	mv $SRC/polkit-1 $PKG/etc/pam.d/

	rm -r $PKG/usr/lib/systemd $PKG/usr/lib/sysusers.d \
	      $PKG/usr/lib/tmpfiles.d $PKG/usr/share/locale
}
