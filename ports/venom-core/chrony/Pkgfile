# Depends: gnutls libedit libcap ncurses nettle nss
description="Lightweight NTP client and server"
homepage="https://chrony-project.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=chrony
version=4.8
release=1
source="https://chrony-project.org/releases/$name-$version.tar.gz"

pkg_build() {
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
