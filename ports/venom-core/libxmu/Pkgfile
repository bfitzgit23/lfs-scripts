# Depends: libx11 libxt libxext
description="X11 miscellaneous micro-utility library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxmu"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxmu
version=1.3.1
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXmu-$version.tar.xz"

pkg_build() {
	cd libXmu-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install

}
