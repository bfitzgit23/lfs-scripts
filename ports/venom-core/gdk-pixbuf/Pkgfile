# Depends: glib libpng libtiff libjpeg-turbo shared-mime-info libx11 libxcb libxau jasper gobject-introspection
description="Toolkit for image loading and pixel buffer manipulation"
homepage="https://wiki.gnome.org/Projects/GdkPixbuf"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gdk-pixbuf
version=2.44.7
release=1
source="https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2"

pkg_build() {
	venom-meson $name-$version build \
		-Ddebug=false \
		-Dglycin=disabled \
		-Ddocumentation=false \
		-Dinstalled_tests=false \
		-Dman=false \
		-Dothers=enabled \
		-Dtests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
	
}
