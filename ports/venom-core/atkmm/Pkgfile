# Depends: at-spi2-core glibmm meson
description="Official C++ interface for the ATK accessibility toolkit library"
homepage="https://www.gtkmm.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=atkmm
version=2.28.4
release=1
source="https://gitlab.gnome.org/GNOME/atkmm/-/archive/$version/$name-$version.tar.bz2"

pkg_build() {
	venom-meson $name-$version build \
	    -D maintainer-mode=true
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
