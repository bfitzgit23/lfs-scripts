description="Control and monitor S.M.A.R.T. enabled ATA and SCSI Hard Drives"
homepage="http://smartmontools.sourceforge.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=smartmontools
version=7.5
release=1
source="https://sourceforge.net/projects/$name/files/$name/$version/$name-$version.tar.gz
	run.smartd
	finish.smartd
	rc.smartd"

pkg_build() {

  	./configure --prefix=/usr           \
	            --sysconfdir=/etc       \
	            --with-initscriptdir=no
	make
	make DESTDIR=$PKG install

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.smartd $PKG/etc/sv/smartd/run
		install -Dm755 $SRC/finish.smartd $PKG/etc/sv/smartd/finish
		ln -s /run/runit/supervise.smartd $PKG/etc/sv/smartd/supervise
	} || continue

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.smartd $PKG/etc/rc.d/smartd || continue
}
