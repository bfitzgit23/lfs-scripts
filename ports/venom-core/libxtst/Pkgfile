# Depends: libx11 libxext libxi
description="X11 Testing -- Resource extension library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxtst"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxtst
version=1.2.5
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXtst-$version.tar.xz"

pkg_build() {
	cd libXtst-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install


}
