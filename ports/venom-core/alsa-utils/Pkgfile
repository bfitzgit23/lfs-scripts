# Depends: alsa-lib
description="Various utilities for controlling sound card"
homepage="http://www.alsa-project.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=alsa-utils
version=1.2.16
release=1
source="https://www.alsa-project.org/files/pub/utils/$name-$version.tar.bz2
	rc.alsa
	run finish"

pkg_build() {

	./configure \
		--prefix=/usr \
		--disable-alsaconf \
		--disable-bat \
		--disable-maintainer-mode \
		--disable-nls \
		--disable-xmlto \
		--with-systemdsystemunitdir=no 
	make
	make DESTDIR=$PKG install

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run $PKG/etc/sv/alsa/run
		install -Dm755 $SRC/finish $PKG/etc/sv/alsa/finish
		ln -s /run/runit/supervise.alsa $PKG/etc/sv/alsa/supervise
	} || continue

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.alsa $PKG/etc/rc.d/alsa || continue
}
