# Depends: libx11 libxxf86vm
description="Alter a monitor's gamma correction"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xgamma
version=1.0.8
release=1
source="http://ftp.x.org/pub/individual/app/xgamma-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

