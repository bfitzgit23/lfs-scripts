# Depends: libx11 libglvnd
description="Query configuration information of DRI drivers"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xdriinfo
version=1.0.8
release=1
source="http://ftp.x.org/pub/individual/app/xdriinfo-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
