# Depends: meson libpng
description="The pixel-manipulation library for X and cairo"
homepage="https://cgit.freedesktop.org/pixman/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pixman
version=0.46.4
release=1
source="https://www.x.org/releases/individual/lib/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build -Dtests=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
