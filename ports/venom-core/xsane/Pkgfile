# Depends: gimp sane
description="Scanner frontend and GIMP plugin for sane"
homepage="http://www.sane-project.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xsane
version=0.999
release=4
source="http://http.debian.net/debian/pool/main/x/$name/${name}_$version.orig.tar.gz
       xsane-0.995-xdg-open.patch
       0165-xsane-0.999-lcms2.patch
       xsane-preview-selection.patch
       configure-add-stdlib-to-conftest.patch
       fix-func_arg_mismatch.patch"

pkg_build() {

	export CPPFLAGS="-I/usr/include/" 
	export LDFLAGS="-L/usr/lib/" 
	export CFLAGS="${CFLAGS} -Wno-implicit-function-declaration -Wno-error=format-truncation"

	patch -Np1 -i $SRC/xsane-0.995-xdg-open.patch
	sed -i -e 's:png_ptr->jmpbuf:png_jmpbuf(png_ptr):' src/xsane-save.c
	patch -Np1 -i $SRC/0165-xsane-0.999-lcms2.patch
	patch -p1 -i $SRC/xsane-preview-selection.patch
	patch -p1 -i $SRC/configure-add-stdlib-to-conftest.patch
	patch -p1 -i $SRC/fix-func_arg_mismatch.patch
    
	./configure \
	        --prefix=/usr \
	        --mandir=/usr/share/man \
	        --enable-gimp
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/sbin $PKG/usr/share/sane/xsane/doc
	rm $PKG/usr/share/sane/xsane/xsane-gpl.txt

	install -d $PKG/usr/lib/gimp/2.0/plug-ins
	ln -s /usr/bin/xsane $PKG/usr/lib/gimp/2.0/plug-ins
}

