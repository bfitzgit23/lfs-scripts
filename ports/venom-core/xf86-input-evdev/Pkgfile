# Depends: mtdev eudev libevdev xorg-server
description="X.org evdev input driver"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xf86-input-evdev
version=2.11.0
release=1
source="https://www.x.org/releases/individual/driver/$name-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
