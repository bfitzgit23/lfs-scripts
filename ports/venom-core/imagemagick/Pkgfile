# Depends: fontconfig lcms2 libtool libxext libxt perl libxml2 librsvg
description="ImageMagick is a collection of tools and libraries to read, write, and manipulate an image in various image formats"
homepage="https://imagemagick.org/ "
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=imagemagick
version=7.1.2.26
vrsn=${version%.*}-${version##*.}
release=1
source="$name-$version.tar.gz::https://github.com/ImageMagick/ImageMagick/archive/refs/tags/$vrsn.tar.gz"
KEEP_LIBTOOL="yes"

pkg_build() {
	cd ImageMagick-$vrsn

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-hdri \
		--with-modules \
		--with-perl \
		--disable-static \
		--without-openexr
	make
	make DESTDIR=$PKG install
}
