# Depends: libaio
description="Set of tools that manage logical partitions"
homepage="https://sourceware.org/lvm2/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=lvm2
version=2.03.41
release=1
backup="etc/lvm/lvm.conf
	etc/lvm/lvmlocal.conf"
source="$name-$version.tgz::https://sourceware.org/pub/lvm2/LVM2.$version.tgz"

pkg_build() {
	cd LVM2.$version

	#fix the install_lvm2 make target
	sed '/SIMPLE_RECURSIVE_TARGETS/s/=/= install_lvm2/' -i libdm/make.tmpl.in
	
	CONFIG_SHELL=/bin/bash  \
	./configure --prefix=/usr \
		--libdir=/usr/lib \
		--with-libexecdir=/usr/lib/lvm2 \
		--exec-prefix= \
		--enable-cmdlib \
		--enable-pkgconfig \
		--enable-udev_sync
	make 
	make DESTDIR=$PKG install_lvm2 install_device-mapper
}
