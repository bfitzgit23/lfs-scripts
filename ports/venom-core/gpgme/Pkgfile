# Depends: gnupg swig python3-setuptools
description="C library that allows cryptography support to be added to a program"
homepage="https://www.gnupg.org/related_software/gpgme/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gpgme
version=2.1.1
release=1
source="https://gnupg.org/ftp/gcrypt/gpgme/$name-$version.tar.bz2"

pkg_build() {

	sed -i 's/-unknown//' autogen.sh

	autoreconf -fi
	./configure \
		--prefix=/usr \
		--disable-fd-passing \
		--disable-static \
		--disable-gpgsm-test
	make
	make DESTDIR=$PKG install

}
