# Depends: cairo harfbuzz fribidi fontconfig gobject-introspection meson libxft
description="A library for layout and rendering of text"
homepage="https://www.pango.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pango
version=1.58.0
release=1
source="https://gitlab.gnome.org/GNOME/pango/-/archive/$version/$name-$version.tar.gz"

pkg_build() {
	venom-meson $name-$version build -Dintrospection=enabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
