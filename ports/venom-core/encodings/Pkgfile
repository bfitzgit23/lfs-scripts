# Depends: util-macros mkfontscale
description="X.org font encoding files"
homepage="https://gitlab.freedesktop.org/xorg/font/encodings"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=encodings
version=1.1.0
release=2
source="https://xorg.freedesktop.org//releases/individual/font/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -rf $PKG/usr/share/fonts/encodings/encodings.dir
}
