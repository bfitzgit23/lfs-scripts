# Depends: libva
description="Intel VA-API Media Applications and Scripts for libva"
homepage="https://01.org/linuxmedia/vaapi"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libva-utils
version=2.23.0
release=1
source="https://github.com/intel/libva-utils/archive/$version/$name-$version.tar.gz"
pkg_build() {
	venom-meson $name-$version build -Dtests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
