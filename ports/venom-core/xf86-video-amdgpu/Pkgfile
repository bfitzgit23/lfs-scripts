# Depends: eudev xorg-server
description="X.Org Video Driver for newer AMD Radeon video cards starting from Volcanic Islands"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xf86-video-amdgpu
version=25.0.0
release=1
source="https://www.x.org/pub/individual/driver/$name-$version.tar.xz"

pkg_build() {

	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
