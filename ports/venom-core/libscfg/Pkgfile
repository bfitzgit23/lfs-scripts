# Depends: meson
description="A C library for scfg"
homepage="https://git.sr.ht/~emersion/libscfg"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libscfg
version=0.2.0
release=1
source="$name-$version.tar.gz::https://codeberg.org/emersion/libscfg/archive/v$version.tar.gz"

pkg_build() {
	venom-meson $name build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
