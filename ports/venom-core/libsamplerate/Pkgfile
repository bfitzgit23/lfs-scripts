# Depends: libsndfile
description="Secret Rabbit Code - aka Sample Rate Converter for audio"
homepage="https://libsndfile.github.io/libsamplerate/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libsamplerate
version=0.2.2
release=1
source="https://github.com/libsndfile/libsamplerate/releases/download/$version/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share
}
