description="A commandline option parser"
homepage="https://github.com/rpm-software-management/popt"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=popt
version=1.19
release=1
source="https://ftp.osuosl.org/pub/rpm/$name/releases/popt-1.x/$name-$version.tar.gz"

pkg_build() {

	./configure --prefix=/usr --disable-static --disable-nls
	make
	make DESTDIR=$PKG install
}
