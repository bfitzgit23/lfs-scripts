# Depends: libx11 libxcursor libpng zlib
description="Create an X cursor file from PNG images"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xcursorgen
version=1.0.9
release=1
source="http://ftp.x.org/pub/individual/app/xcursorgen-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
