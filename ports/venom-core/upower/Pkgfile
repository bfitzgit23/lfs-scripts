# Depends: dbus-glib libgudev libusb polkit gobject-introspection meson libxslt
description="Abstraction for enumerating power devices, listening to device events and querying history and statistics"
homepage="https://upower.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=upower
version=1.91.2
release=2
source="https://gitlab.freedesktop.org/$name/$name/-/archive/v$version/$name-v$version.tar.gz
	reduce-gudev.patch"

pkg_build() {
	patch -Np1 -d $name-v$version -i $SRC/reduce-gudev.patch
	venom-meson $name-v$version build \
		-Dgtk-doc=false \
		-Dman=false \
		-Dsystemdsystemunitdir=no 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}

