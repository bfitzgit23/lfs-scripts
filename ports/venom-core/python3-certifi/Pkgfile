# Depends: python3-setuptools python3-gpep517  python3-wheel
description="Python package for providing Mozilla's CA Bundle"
homepage="https://github.com/certifi/python-certifi"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-certifi
version=2026.6.17
release=1
source="$name-$version.tar.gz::https://pypi.io/packages/source/c/certifi/certifi-$version.tar.gz"

pkg_build() {
	
	cd certifi-$version

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" \
		.dist/*.whl


}
