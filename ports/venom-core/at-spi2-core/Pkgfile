# Depends: dbus glib libxtst gobject-introspection meson libxml2
description="Provides a Service Provider Interface for the Assistive Technologies available on the GNOME platform and a library against which applications can be linked"
homepage="https://gitlab.gnome.org/GNOME/at-spi2-core"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=at-spi2-core
version=2.60.5
release=1
source="https://download.gnome.org/sources/at-spi2-core/${version%.*}/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build -Ddocs=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# remove junk files
	rm -fr $PKG/usr/lib/systemd/
}
