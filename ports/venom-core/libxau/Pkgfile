# Depends: xorgproto
description="X11 authorisation library"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxau
version=1.0.12
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXau-$version.tar.xz"

pkg_build() {
	cd libXau-$version

 	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
