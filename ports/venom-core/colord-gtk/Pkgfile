# Depends: colord glib gtk3 intltool lcms2 meson
description="GTK support library for colord"
homepage="https://www.freedesktop.org/software/colord/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=colord-gtk
version=0.3.1
release=1
source="https://www.freedesktop.org/software/colord/releases/$name-$version.tar.xz"

pkg_build() {
venom-meson $name-$version build \
    -Dgtk2=false \
    -Dgtk4=false \
    -Dvapi=true \
    -Dtests=true \
    -Dman=false \
    -Ddocs=false 
meson compile -C build
DESTDIR=$PKG meson install --no-rebuild -C build
}
