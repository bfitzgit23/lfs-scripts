# Depends: meson vala bash-completion libxslt dbus
description="Configuration database system"
homepage="https://wiki.gnome.org/Projects/dconf"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=dconf
version=0.40.0
release=2
source="https://gitlab.gnome.org/GNOME/dconf/-/archive/$version/$name-$version.tar.bz2"

pkg_build() {

	export XML_CATALOG_FILES=/etc/xml/catalog
	venom-meson $name-$version build \
	--libexecdir=/usr/lib/$name
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

        rm -rf $PKG/usr/lib/systemd
}
