# Depends: gtk3 intltool
description="Lightweight GTK+ clipboard manager (fork of Parcellite)"
homepage="https://github.com/CristianHenzel/ClipIt/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=clipit
version=1.4.5
release=1
source="https://github.com/CristianHenzel/ClipIt/archive/v$version/$name-$version.tar.gz"

pkg_build() {
	cd ClipIt-$version

	./autogen.sh
	./configure \
		--prefix=/usr \
        	--sysconfdir=/etc \
		--disable-nls \
		--with-gtk3
	make
	make DESTDIR=$PKG install
}

