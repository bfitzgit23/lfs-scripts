# Depends: libxcb
description="Utility libraries for XC Binding"
homepage="https://xcb.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xcb-util
version=0.4.1
release=1
source="https://xorg.freedesktop.org/archive/individual/xcb/xcb-util-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

