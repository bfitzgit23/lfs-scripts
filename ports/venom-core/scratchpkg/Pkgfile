# Depends: b3sum coreutils findutils git libarchive util-linux
description="Venom Linux Package Manager "
homepage="https://codeberg.org/venomlinux/scratchpkg"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=scratchpkg
version=20260628
release=1
source="$name-$version.tar.gz::https://codeberg.org/venomlinux/scratchpkg/archive/$version.tar.gz"
backup="etc/scratchpkg.conf
	etc/scratchpkg.alias
	etc/scratchpkg.repo
	etc/scratchpkg.mask
	etc/revdep.conf"

pkg_build() {
	cd $name
	DESTDIR=$PKG ./INSTALL.sh
}
