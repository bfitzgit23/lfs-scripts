# Depends: yasm
description="Implementations of the VP8 Codec, used in most current html5 video, and of the next-generation VP9 Codec"
homepage="https://www.webmproject.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libvpx
version=1.16.0
release=2
source="$name-$version.tar.gz::https://github.com/webmproject/libvpx/archive/v$version.tar.gz
	CVE-2026-2447.patch"

pkg_build() {

	patch -Np1 -i $SRC/CVE-2026-2447.patch	

	mkdir libvpx-build
	cd    libvpx-build

	../configure --prefix=/usr    \
 	            --enable-shared  \
 	            --disable-static
	make
	make DESTDIR=$PKG install
}
