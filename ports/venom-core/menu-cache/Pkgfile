# Depends: libfm-extra gtk-doc
description="Caching mechanism for freedesktop.org compliant menus"
homepage="https://lxde.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=menu-cache
version=1.1.1
release=1
source="$name-$version.tar.gz::https://github.com/lxde/menu-cache/archive/$version.tar.gz"

pkg_build() {
	./autogen.sh
	./configure --prefix=/usr \
	            --libexecdir=/usr/lib \
	            --disable-static
	make
	make DESTDIR=$PKG install
}
