# Depends: cairo libsigc++
description="Provides a C++ interface to Cairo"
homepage="https://www.cairographics.org/cairomm/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=cairomm
version=1.14.6
release=1
source="https://cairographics.org/releases/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
