# Depends: libxau libxext libxmu libx11
description="X.Org authorization settings program"
homepage="https://xcb.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xauth
version=1.1.5
release=1
source="http://ftp.x.org/pub/individual/app/xauth-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
