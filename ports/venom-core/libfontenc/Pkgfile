# Depends: zlib font-util xorgproto
description="X11 font encoding library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libfontenc"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libfontenc
version=1.1.9
release=1
source="http://ftp.x.org/pub/individual/lib/$name-$version.tar.xz"

pkg_build() {
	cd libfontenc-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
