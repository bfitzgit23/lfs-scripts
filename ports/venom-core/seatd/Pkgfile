# Depends: meson scdoc
description="Seat management daemon and library "
homepage="https://git.sr.ht/~kennylevinsen/seatd"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=seatd
version=0.9.3
release=1
source="$name-$version.tar.gz::https://git.sr.ht/~kennylevinsen/seatd/archive/$version.tar.gz
	rc.seatd
	run.seatd"

pkg_build() {
    venom-meson $name-$version build \
          -Dlibseat-logind=disabled \
	  -Dlibseat-seatd=enabled \
	  -Dlibseat-builtin=enabled \
          -Dman-pages=enabled \
          -Dexamples=disabled \
          -Dserver=enabled 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# user can run seatd-launch
	chmod u+s $PKG/usr/bin/seatd-launch

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.seatd $PKG/etc/rc.d/seatd || continue
	
	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.seatd $PKG/etc/sv/seatd/run
		ln -s /run/runit/supervise.seatd $PKG/etc/sv/seatd/supervise
	} || continue
}
