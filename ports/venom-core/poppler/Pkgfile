# Depends: cmake freetype2 poppler-data ninja
description="PDF rendering library and command line tools used to manipulate PDF files"
homepage="https://poppler.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=poppler
version=26.06.0
release=1
source="https://poppler.freedesktop.org/$name-$version.tar.xz"

pkg_build() {
	cmake -S $name-$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DENABLE_UNSTABLE_API_ABI_HEADERS=ON \
		-DENABLE_UTILS=ON \
		-DENABLE_CPP=ON \
		-DBUILD_CPP_TESTS=OFF \
		-DBUILD_MANUAL_TESTS=OFF \
		-DENABLE_QT5=$(scratch isinstalled qt5 && printf "ON" || printf "OFF") \
		-DBUILD_QT5_TESTS=OFF \
		-DENABLE_QT6=$(scratch isinstalled qt6-base && printf "ON" || printf "OFF") \
		-DBUILD_QT6_TESTS=OFF \
		-DENABLE_GPGME=OFF \
		-DENABLE_BOOST=$(scratch isinstalled boost && printf "ON" || printf "OFF") \
		-DENABLE_GLIB=$(scratch isinstalled gobject-introspection && printf "ON" || printf "OFF") \
		-DENABLE_LCMS=$(scratch isinstalled lcms2 && printf "ON" || printf "OFF") \
		-DENABLE_LIBTIFF=$(scratch isinstalled libtiff && printf "ON" || printf "OFF") \
		-DENABLE_NSS3=$(scratch isinstalled nss && printf "ON" || printf "OFF") \
		-DENABLE_LIBOPENJPEG=$(scratch isinstalled openjpeg2 && echo openjpeg2 || echo none) \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build

	# cleanup 
	rm -vrf $PKG/usr/include/poppler/glib
	rm -vrf $PKG/usr/include/poppler/qt5
	rm -vrf $PKG/usr/include/poppler/qt6

	rm -vf $PKG/usr/lib/libpoppler-glib.*
	rm -vf $PKG/usr/lib/libpoppler-qt5.*
	rm -vf $PKG/usr/lib/libpoppler-qt6.*

	rm -vf $PKG/usr/lib/pkgconfig/poppler-glib.pc
	rm -vf $PKG/usr/lib/pkgconfig/poppler-qt5.pc
	rm -vf $PKG/usr/lib/pkgconfig/poppler-qt6.pc

	rm -vrf $PKG/usr/lib/gir*
	rm -vrf $PKG/usr/share/gir*

	rm -vrf $PKG/usr/share/gtk-doc
}
