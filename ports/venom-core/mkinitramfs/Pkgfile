# Depends: libarchive
description="Modular initramfs image creation utility"
homepage="https://codeberg.org/venomlinux/mkinitramfs"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mkinitramfs
version=20260514
release=1
backup="etc/mkinitramfs.conf"
source="$name-$version.tar.gz::https://codeberg.org/venomlinux/mkinitramfs/archive/$version.tar.gz
	mkinitramfs.conf"

pkg_build() {
	cd $name
	DESTDIR=$PKG ./INSTALL.sh
	install -m644 $SRC/mkinitramfs.conf $PKG/etc/
}
