# Depends: iso-codes libsecret libnotify networkmanager gobject-introspection meson libnma libappindicator
description="Panel applet used to configure wired and wireless network connections"
homepage="https://gitlab.gnome.org/GNOME/network-manager-applet"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=network-manager-applet
version=1.36.0
release=1
source="https://gitlab.gnome.org/GNOME/network-manager-applet/-/archive/$version/$name-$version.tar.gz"

pkg_build() {
	venom-meson $name-$version build \
		-Dselinux=false \
		-Dteam=false \
		-Dwwan=$(scratch isinstalled modemmanager && printf "true" || printf "false")
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
