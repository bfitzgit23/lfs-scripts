# Depends: libx11 libxext
description="X11 Resource extension library"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxres
version=1.2.3
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXres-$version.tar.xz"

pkg_build() {
	cd libXres-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}

