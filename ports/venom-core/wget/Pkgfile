# Depends: ca-certificates openssl util-linux libidn2 pcre2
description="Network utility to retrieve files from the Web"
homepage="https://www.gnu.org/software/wget/wget.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=wget
version=1.25.0
release=1
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.gz"

pkg_build() {

  	./configure --prefix=/usr \
	            --sysconfdir=/etc \
	            --with-ssl=openssl
	make
	make DESTDIR=$PKG install

}
