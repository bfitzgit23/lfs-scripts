# Depends: libxv libx11
description="Prints out the capabilities of any video adaptors associated with the display that are accessible through the X-Video extension"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xvinfo
version=1.1.5
release=1
source="http://ftp.x.org/pub/individual/app/xvinfo-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
