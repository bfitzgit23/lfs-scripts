# Depends: dbus gobject-introspection intltool libdaemon libevent
description="A system which facilitates service discovery on a local network via the mDNS/DNS-SD protocol suite"
homepage="https://www.avahi.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=avahi
version=0.9rc5
release=1
source="https://github.com/avahi/avahi/archive/refs/tags/v${version%rc*}-${version#${version%rc*}}.tar.gz
	rc.avahi-daemon"

pkg_build() {
	cd $name-${version%rc*}-${version#${version%rc*}}
	NOCONFIGURE=1 ./autogen.sh
	./configure --prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--runstatedir=/run \
		--with-distro=none \
		--with-autoipd-user=avahi \
		--with-autoipd-group=avahi \
		--with-avahi-priv-access-group=wheel \
		--enable-compat-libdns_sd \
		--disable-gtk \
		--disable-gtk3 \
		--disable-qt3 \
		--disable-qt4 \
		--disable-qt5 \
		--disable-python \
		--disable-static \
		--disable-pygobject \
		--disable-python-dbus \
		--disable-manpages \
		--disable-mono \
		--disable-mono-doc \
		--disable-nls \
		--disable-libsystemd \
		--with-systemdsystemunitdir=no
	make
	make DESTDIR=$PKG install

	ln -s avahi-compat-libdns_sd/dns_sd.h $PKG/usr/include/dns_sd.h

	install -D -m 0755 $SRC/rc.avahi-daemon $PKG/etc/rc.d/avahi-daemon

	rm -fr $PKG/run
}
