# Depends: libxcb xtrans
description="X11 client-side library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libx11"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libx11
version=1.8.13
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libX11-$version.tar.xz"

pkg_build() {
	cd libX11-$version
	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static \
		--disable-specs
	make
	make DESTDIR=$PKG install
}
