# Depends: libxext libxmu libxt libx11 libxpm
description="X11 Athena Widget library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxaw"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxaw
version=1.0.16
release=1
source="$name-$version.tar.bz2::http://ftp.x.org/pub/individual/lib/libXaw-$version.tar.xz"

pkg_build() {
	cd libXaw-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install


}
