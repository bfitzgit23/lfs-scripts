# Depends: libsm libx11
description="Message bus system, a simple way for applications to talk to one another"
homepage="https://www.freedesktop.org/wiki/Software/dbus/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=dbus
version=1.16.2
release=2
source="https://dbus.freedesktop.org/releases/$name/$name-$version.tar.xz
	rc.$name
	run"

pkg_build() {
	venom-meson $name-$version build -Dsystem_pid_file=/run/dbus/dbus.pid 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.$name $PKG/etc/rc.d/$name || continue

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run $PKG/etc/sv/$name/run
		ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
	} || continue

	rm -r $PKG/usr/share/dbus-1/system.d $PKG/run
}
