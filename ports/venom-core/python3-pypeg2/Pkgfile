# Depends: python3
description="An intrinsic PEG Parser-Interpreter for Python"
homepage="https://fdik.org/pyPEG/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pypeg2
version=2.15.2
release=1
source="$name-$version.tar.gz::https://pypi.python.org/packages/source/p/pyPEG2/pyPEG2-$version.tar.gz"

pkg_build() {
	cd pyPEG2-$version
	python3 setup.py build
	python3 setup.py install --root="$PKG" --prefix=/usr --optimize=1 --skip-build
}
