# Depends: fontconfig libxslt mesa nss dbus libsm libx11 libxtst libxcb libxcomposite libxfixes libxi libxcursor libxkbcommon libxrender libxshmfence xcb-util-image xcb-util-keysyms qtwebengine krb5
description="Video Conferencing and Web Conferencing Service"
homepage="https://zoom.us/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=zoom
version=7.1.0.3715
release=1
source="$name-$version.tar.xz::https://cdn.zoom.us/prod/$version/zoom_x86_64.pkg.tar.xz"

build() {

  sed -i 's/Zoom\.png/Zoom/g' "$SRC/usr/share/applications/Zoom.desktop"
  sed -i 's/StartupWMClass=Zoom/StartupWMClass=zoom/g' "$SRC/usr/share/applications/Zoom.desktop"

  cp -dpr --no-preserve=ownership opt usr $PKG

}
