# Depends: xfce4-panel lm_sensors libnotify hicolor-icon-theme
description="A netload plugin for the Xfce panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-sensors-plugin
version=1.5.0
release=1
source="https://gitlab.xfce.org/panel-plugins/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

build() {
	venom-meson $name-$name-$version build 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

}
