# Depends: xfce4-panel libnotify libcanberra pulseaudio
description="Pulseaudio plugin for the Xfce4 panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-pulseaudio-plugin
version=0.5.1
release=1
source="http://archive.xfce.org/src/panel-plugins/xfce4-pulseaudio-plugin/${version%.*}/xfce4-pulseaudio-plugin-$version.tar.xz"

build() {

	venom-meson $name-$version build 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
