# Depends: xfce4-panel thunar
description="Menu with quick access to folders, documents, and removable media"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-places-plugin
version=1.9.0
release=1
source="https://archive.xfce.org/src/panel-plugins/$name/${version%.*}/$name-$version.tar.xz"

build() {

	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
