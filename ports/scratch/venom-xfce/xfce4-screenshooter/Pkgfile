# Depends: xfce4-panel libsoup hicolor-icon-theme
description="Plugin that makes screenshots for the Xfce panel"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfce4-screenshooter
version=1.11.3
release=1
source="http://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.xz"

build() {

	venom-meson $name-$version build -Dwerror=false 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
	
	rm -rf $PKG/usr/share/locale
}
