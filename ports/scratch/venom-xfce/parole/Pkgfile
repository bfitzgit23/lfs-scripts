# Depends: gst-plugins-good libxfce4ui libnotify taglib gst-libav
description="DVD/CD/music player for Xfce that uses GStreamer"
homepage="https://xfce.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=parole
version=4.20.0
release=1
source="https://gitlab.xfce.org/apps/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

build() {

	venom-meson $name-$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

}
