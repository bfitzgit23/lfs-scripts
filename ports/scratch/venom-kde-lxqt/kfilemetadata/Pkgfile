# Depends: exiv2 karchive kcodecs kconfig kcoreaddons ki18n poppler taglib
description="Provides a simple library for extracting the text and metadata from a number of different files"
homepage="https://community.kde.org/Frameworks"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=kfilemetadata
version=6.27.0
release=1
source="https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz"

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -D BUILD_TESTING=OFF \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build

}
