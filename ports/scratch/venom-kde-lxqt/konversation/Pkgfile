# Depends: karchive kbookmarks kcodecs kcolorscheme kcompletion kxmlgui qt6-5compat
description="A user-friendly and fully-featured IRC client"
homepage="https://apps.kde.org/konversation/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=konversation
version=26.04.2
release=1
source="http://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz"

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -D BUILD_TESTING=OFF \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build

}
