# Depends: basu
description="Library for Emulated Input"
homepage="https://libinput.pages.freedesktop.org/libei/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libei
version=1.6.0
release=1
source="https://gitlab.freedesktop.org/libinput/libei/-/archive/$version/$name-$version.tar.gz"

build() {
    venom-meson $name-$version build \
     --prefix=/usr \
     --libdir=lib \
     -Dtests=disabled
    meson compile -C build

   DESTDIR=$PKG meson install --no-rebuild -C build

}
