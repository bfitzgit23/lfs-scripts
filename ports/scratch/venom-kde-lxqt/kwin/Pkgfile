# Depends: kdeclarative kdecoration kglobalacceld knewstuff kscreenlocker kwayland lcms2 libdisplay-info pipewire xwayland knighttime
description="Easy to use, but flexible, X Window Manager and Wayland Compositor"
homepage="https://kde.org/plasma-desktop/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=kwin
version=6.7.1
release=1
source="https://download.kde.org/stable/plasma/$(echo $version | cut -d. -f1-3)/$name-$version.tar.xz"

build() {
	# Fix doc build with libxml2 2.15
	find -name index.docbook | xargs sed -e 's|url=" http|url="http|g' -i

	cmake -S $name-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_INSTALL_LIBEXECDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -D BUILD_TESTING=OFF \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
 
        rm -rf $PKG/usr/lib/systemd
}
