# Depends: kcmutils kdeclarative kpeople kstatusnotifieritem libfakekey modemmanager-qt pulseaudio-qt qqc2-desktop-style libei
description="Adds communication between KDE and your smartphone"
homepage="https://kdeconnect.kde.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=kdeconnect
version=26.04.2
release=1
source="https://download.kde.org/stable/release-service/$version/src/$name-kde-$version.tar.xz"

build() {
	cmake -B build -S $name-kde-$version \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -D BUILD_TESTING=OFF \
	        -D BLUETOOTH_ENABLE=OFF \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}

