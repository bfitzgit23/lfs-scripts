# Depends: appstream-glib desktop-file-utils fmt gsl libadwaita libbs2b libebur128 libsigc++3 libmysofa lilv nlohmann-json rnnoise speexdsp zita-convolver tbb calf lsp-plugins qt6-graphs libportal webrtc-audio-processing breeze-icons kconfigwidgets kiconthemes kirigami-addons
description="Audio Effects for Pipewire applications"
homepage="https://github.com/wwmm/easyeffects"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=easyeffects
version=8.2.5
release=1
source="$name-$version.tar.gz::https://github.com/wwmm/easyeffects/archive/refs/tags/v$version.tar.gz"

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
	        -DCMAKE_BUILD_TYPE=Release \
	        -DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
