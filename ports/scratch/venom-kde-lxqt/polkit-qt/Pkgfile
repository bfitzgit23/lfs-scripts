# Depends: polkit qt6-base
description="A library that allows developers to access PolicyKit API with a nice Qt-style API"
homepage="https://www.kde.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=polkit-qt
bname=polkit-qt-1
version=0.200.0
release=1
source="$name-$version.tar.xz::http://download.kde.org/stable/$bname/$bname-$version.tar.xz"

build() {
	cmake -S $SRC/$bname-$version -B build \
	       -DCMAKE_INSTALL_PREFIX=/usr \
	       -DLIB_DESTINATION=/usr/lib \
	       -DQT_MAJOR_VERSION=6 \
	       -DCMAKE_INSTALL_LIBEXECDIR=lib \
	       -DCMAKE_BUILD_TYPE=Release \
	       -DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	       -DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	       -DOPTION=ON/OFF \
	       -Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
