# Depends: libx11
description="Device Color Characterization utility for X Color Management System"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xcmsdb
version=1.0.7
release=1
source="http://ftp.x.org/pub/individual/app/xcmsdb-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

