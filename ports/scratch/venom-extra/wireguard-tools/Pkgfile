# Depends: openresolv
description="Tools for configuring WireGuard"
homepage="https://www.wireguard.com/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=wireguard-tools
version=1.0.20260223
release=1
source="https://git.zx2c4.com/wireguard-tools/snapshot/$name-$version.tar.xz"

build() {
	cd src

	make
	make install \
		 DESTDIR=$PKG \
		 PREFIX=/usr \
		 RUNSTATEDIR=/run \
		 WITH_BASHCOMPLETION=$(scratch isinstalled bash-completion && echo yes || echo no) \
		 WITH_SYSTEMDUNITS=no \
		 WITH_WGQUICK=yes
}
