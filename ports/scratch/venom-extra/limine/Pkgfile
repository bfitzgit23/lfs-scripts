# Depends: nasm mtools
description="Modern, advanced, portable, multiprotocol bootloader."
homepage="https://limine-bootloader.org "
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=limine
version=12.3.3
release=1
source="https://github.com/Limine-Bootloader/Limine/releases/download/v$version/$name-$version.tar.xz"

build() {
	./configure --prefix=/usr \
		TOOLCHAIN_FOR_TARGET=gnu \
		CC_FOR_TARGET=gcc \
		LD_FOR_TARGET=ld \
		OBJCOPY_FOR_TARGET=objcopy \
		OBJDUMP_FOR_TARGET=objdump \
		READELF_FOR_TARGET=readelf \
		--enable-bios-cd \
		--enable-bios-pxe \
		--enable-bios \
		--enable-uefi-x86-64 \
		--enable-uefi-cd 
	make
	make DESTDIR=$PKG install
}
