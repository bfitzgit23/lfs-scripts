# Depends: libtorrent curl
description="Ncurses BitTorrent client based on libTorrent"
homepage="https://rakshasa.github.io/rtorrent/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=rtorrent
version=0.16.15
release=1
source="https://github.com/rakshasa/$name/releases/download/v$version/$name-$version.tar.gz"

build() {

	autoreconf -fvi

	./configure --prefix=/usr --disable-debug
	make
	make DESTDIR=$PKG install
}
