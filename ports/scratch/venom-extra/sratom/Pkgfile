# Depends: sord lv2 python3-sphinx-lv2-theme
description="An LV2 Atom RDF serialisation library"
homepage="https://drobilla.net/software/sratom.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sratom
version=0.6.22
release=1
source="https://download.drobilla.net/$name-$version.tar.xz"

build() {
	venom-meson $name-$version build \
		-Ddocs=disabled \
		-Dtests=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
