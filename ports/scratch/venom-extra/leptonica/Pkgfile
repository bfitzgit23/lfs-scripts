# Depends: giflib libjpeg-turbo libpng libtiff libwebp
description="Image processing and analysis applications"
homepage="http://www.leptonica.com/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=leptonica
version=1.87.0
release=1
source="https://github.com/DanBloomberg/leptonica/releases/download/$version/$name-$version.tar.gz"

build(){
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
