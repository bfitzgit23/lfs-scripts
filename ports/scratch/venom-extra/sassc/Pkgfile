# Depends: libsass
description="C implementation of Sass CSS preprocessor"
homepage="https://sass-lang.com/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sassc
version=3.6.2
release=1
source="$name-$version.tar.gz::https://github.com/sass/$name/archive/$version.tar.gz"

build() {
	autoreconf -vfi
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
}
