# Depends: libxml2 curl libmpfr intltool doxygen
description="Multi-purpose desktop calculator"
homepage="https://qalculate.github.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libqalculate
version=5.11.0
release=1
source="$name-$version.tar.gz::https://github.com/Qalculate/libqalculate/archive/v$version.tar.gz"

build() {
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
