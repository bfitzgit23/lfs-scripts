# Depends: babl json-glib graphviz
description="GEneric Graphics Library, a graph based image processing format"
homepage="https://www.gegl.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gegl
version=0.4.70
release=1
source="https://download.gimp.org/pub/gegl/${version%.*}/$name-$version.tar.xz"

build() {
	venom-meson $name-$version build -Ddocs=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
