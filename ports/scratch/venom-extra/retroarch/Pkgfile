# Depends: qt5 openal pulseaudio dbus libusb libxv v4l-utils ffmpeg
description="Reference frontend for the libretro API "
homepage="http://www.libretro.com/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=retroarch
version=1.22.2
release=1
source="https://github.com/libretro/RetroArch/archive/v$version/$name-$version.tar.gz
"

build() {
	cd RetroArch-$version

	./configure \
		--prefix=/usr \
		--enable-builtinmbedtls \
		--disable-builtinzlib \
		--disable-cg \
		--disable-jack \
		--disable-oss \
		--disable-sdl \
		--enable-dbus 
	make
	make DESTDIR=$PKG install
}
