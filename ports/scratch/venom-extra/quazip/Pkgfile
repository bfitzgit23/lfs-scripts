# Depends: qt6-base qt6-5compat ninja
description="Qt/C++ wrapper over minizip"
homepage="https://stachenov.github.io/quazip/ "
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=quazip
version=1.7.1
release=1
source="https://github.com/stachenov/$name/archive/v$version/$name-$version.tar.gz"

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DQUAZIP_QT_MAJOR_VERSION=6 \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
