# Depends: libgudev upower
description="Makes power profiles handling available over D-Bus"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
homepage="https://gitlab.freedesktop.org/hadess/power-profiles-daemon"

name=power-profiles-daemon
version=0.30
release=2
source="https://gitlab.freedesktop.org/hadess/power-profiles-daemon/-/archive/$version/$name-$version.tar.bz2"

build() {
	venom-meson $name-$version build \
		-Dsystemdsystemunitdir="" \
		-Dgtk_doc=false \
		-Dpylint=disabled \
		-Dtests=false \
		-Dbashcomp=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# Fix tlp conflict
	rm -rf $PKG/usr/share/dbus-1
}
