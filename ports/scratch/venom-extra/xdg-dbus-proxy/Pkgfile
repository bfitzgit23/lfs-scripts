# Depends: glib meson
description="D-Bus proxy"
homepage="https://github.com/flatpak/xdg-dbus-proxy"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xdg-dbus-proxy
version=0.1.7
release=1
source="https://github.com/flatpak/xdg-dbus-proxy/releases/download/$version/xdg-dbus-proxy-$version.tar.xz"

build() {
	venom-meson $name-$version build -D man=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
