# Depends: gtk3 hicolor-icon-theme desktop-file-utils intltool
description="Fast and lightweight IDE"
homepage="https://www.geany.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=geany
version=2.1
release=1
source="http://download.geany.org/$name-$version.tar.bz2"

build() {

	./configure \
		--prefix=/usr \
		--disable-api-docs \
		--disable-html-docs \
		--disable-pdf-docs \
		--disable-nls
	make
	make DESTDIR=$PKG install
}
