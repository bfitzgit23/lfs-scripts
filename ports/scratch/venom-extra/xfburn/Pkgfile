# Depends: exo libxfce4util libisoburn
description="A simple CD/DVD burning tool based on libburnia libraries"
homepage="https://docs.xfce.org/apps/xfburn/start"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfburn
version=0.8.0
release=1
source="http://archive.xfce.org/src/apps/$name/${version%.*}/$name-$version.tar.bz2"

build() {

	./configure --prefix=/usr \
		 --disable-static \
		 --disable-nls \
		 --disable-debug \
		 --disable-gstreamer \
		 --disable-dependency-tracking
	make
	make DESTDIR=$PKG install

}
