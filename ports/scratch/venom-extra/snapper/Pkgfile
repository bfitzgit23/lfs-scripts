# Depends: btrfs-progs dbus boost json-c libxslt docbook-xsl linux-pam e2fsprogs
description="A tool for managing BTRFS and LVM snapshots. It can create, diff and restore snapshots and provides timelined auto-snapping."
homepage="http://snapper.io"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=snapper
version=0.13.1
release=2
source="https://github.com/openSUSE/snapper/archive/v$version/$name-$version.tar.gz
	rc.snapperd
	run.snapperd"

build() {

	    export XML_CATALOG_FILES=/etc/xml/catalog

	    # rename cron scripts
	    sed -i -e 's@suse.de-@@g' scripts/Makefile.am

	    # fix config location in cron scripts
	    sed -i -e 's@/etc/sysconfig/@/etc/conf.d/@g' scripts/snapper-hourly

	    # fix pam plugin install location
	    sed -i -e 's@shell echo /@shell echo /usr/@g' pam/Makefile.am

	aclocal
	libtoolize --force --automake --copy
	autoheader
	automake --add-missing --copy
	autoconf
	./configure --prefix=/usr \
		--sbindir=/usr/bin \
		--with-conf=/etc/conf.d \
		--with-pam-security=/usr/lib/security \
		--disable-zypp \
		--disable-systemd \
		--disable-silent-rules
	make
	make DESTDIR=$PKG install

	rm -rf $PKG/usr/lib/snapper/testsuite/
	rm -f $PKG/usr/lib/snapper/systemd-helper

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.snapperd $PKG/etc/sv/snapperd/run 
		ln -s /run/runit/supervise.snapperd $PKG/etc/sv/snapperd/supervise
	} || continue

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.snapperd $PKG/etc/rc.d/snapperd || continue
}
