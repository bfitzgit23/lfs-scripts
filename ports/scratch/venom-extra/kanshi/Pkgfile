# Depends: libscfg libvarlink vali wayland
description="Dynamic output configuration for Wayland WMs "
homepage="https://wayland.emersion.fr/kanshi/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=kanshi
version=1.9.0
release=1
source="https://gitlab.freedesktop.org/emersion/kanshi/-/releases/v$version/downloads/$name-$version.tar.gz"

build() {
	venom-meson $name-$version build \
	        -Dman-pages=disabled \
      		-Dipc=enabled 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
