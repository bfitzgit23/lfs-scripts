# Depends: rust pulseaudio
description="Cross-platform ncurses Spotify client written in Rust, inspired by ncmpc and the likes"
homepage="https://github.com/hrkfdn/ncspot"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ncspot
version=1.3.4
release=1
source="https://github.com/hrkfdn/ncspot/archive/v$version/$name-$version.zip"

build() {

	cargo fetch --locked
	cargo build --release --locked
	install -Dm 755 "target/release/$name" "$PKG/usr/bin/$name"
}
