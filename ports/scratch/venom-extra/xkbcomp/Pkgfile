# Depends: libxkbfile
description="X Keyboard description compiler"
homepage="https://xorg.freedesktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xkbcomp
version=1.5.0
release=1
source="http://ftp.x.org/pub/individual/app/xkbcomp-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
