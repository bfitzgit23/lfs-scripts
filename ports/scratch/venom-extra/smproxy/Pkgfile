# Depends: libxmu
description="Allows X applications that do not support X11R6 session management to participate in an X11R6 session"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=smproxy
version=1.0.8
release=1
source="http://ftp.x.org/pub/individual/app/smproxy-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

