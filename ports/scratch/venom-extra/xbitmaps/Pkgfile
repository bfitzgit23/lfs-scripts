description="X.org Bitmap files"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xbitmaps
version=1.1.4
release=1
source="http://ftp.x.org/pub/individual/data/xbitmaps-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static

	make DESTDIR=$PKG install
}

