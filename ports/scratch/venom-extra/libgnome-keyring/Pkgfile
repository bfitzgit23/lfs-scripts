# Depends: dbus libgcrypt libgpg-error vala gobject-introspection intltool
description="GNOME keyring client library"
homepage="https://gitlab.gnome.org/Archive/libgnome-keyring"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libgnome-keyring
version=3.12.0
release=2
source="https://gitlab.gnome.org/Archive/libgnome-keyring/-/archive/$version/$name-$version.tar.gz"

build() {

	# fix vapi build with vala 0.42
	sed -i 's/unlock skip=false/@unlock skip=false/' library/GnomeKeyring-1.0.metadata
	autoreconf -fvi
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static \
		--libexecdir=/usr/lib/gnome-keyring
	make
	make DESTDIR=$PKG install

}
