# Depends: libx11 libxft libxrender fontconfig
description="A simple (suckless) terminal"
homepage="https://st.suckless.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=st
version=0.9.2
release=1
source="https://dl.suckless.org/st/st-$version.tar.gz"

_portdir=$PWD

build() {

	cbuild_restore "$SRC/$name-$version/config.h" || cp config.def.h config.h	

	for p in $_portdir/*.patch $_portdir/*.diff; do
		[ -f $p ] || continue
		patch -Np1 -i $p
	done

	make PREFIX=/usr
	make PREFIX=/usr DESTDIR=$PKG install
}
