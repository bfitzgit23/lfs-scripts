# Depends: libxrandr libx11
description="Print contents of X events"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xev
version=1.2.7
release=1
source="http://ftp.x.org/pub/individual/app/xev-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
