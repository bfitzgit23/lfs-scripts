# Depends: libxmu libx11
description="Print an X window dump from xwd"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xpr
version=1.2.0
release=1
source="http://ftp.x.org/pub/individual/app/$name-$version.tar.gz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

