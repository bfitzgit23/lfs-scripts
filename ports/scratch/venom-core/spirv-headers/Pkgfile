# Depends: cmake ninja
description="SPIR-V Headers"
homepage="https://www.khronos.org/registry/spir-v"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=spirv-headers
version=1.4.350.1
release=3
commit=daa093dd29aab8cbb6562b808370562f56e399fb
#source="$name-$version.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/refs/tags/vulkan-sdk-$version.tar.gz"
source="$name-$version-$commit.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/$commit.tar.gz"

build() {
	cmake -S SPIRV-Headers* -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
        	-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
