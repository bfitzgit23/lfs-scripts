# Depends: glib libxml2 intltool
description="Freedesktop.org Shared MIME Info"
homepage="https://www.freedesktop.org/wiki/Specifications/shared-mime-info-spec/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=shared-mime-info
version=2.4
release=1
source="https://gitlab.freedesktop.org/xdg/$name/-/archive/$version/shared-mime-info-$version.tar.gz"

build() {

    scratch isinstalled xmlto &&  export XML_CATALOG_FILES=/etc/xml/catalog
	venom-meson $name-$version build \
		-Dupdate-mimedb=false \
		-Dbuild-tests=false 
		meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
