# Depends: cargo-c gdk-pixbuf pango vala
description="Library and tools used to manipulate, convert and view Scalable Vector Graphic (SVG) images"
homepage="https://wiki.gnome.org/Projects/LibRsvg"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=librsvg
version=2.62.3
release=1
source="https://gitlab.gnome.org/GNOME/librsvg/-/archive/$version/$name-$version.tar.gz"

build() {
	export CARGO_PROFILE_RELEASE_LTO=true 
	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
	
	venom-meson $name-$version build \
		-Ddocs=disabled \
		-Dpixbuf=enabled \
		-Dpixbuf-loader=enabled \
		-Dtests=false \
		-Dvala=enabled 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
