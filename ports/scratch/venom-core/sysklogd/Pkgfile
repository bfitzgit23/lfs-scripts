description="Logging system messages, such as those given by the kernel"
homepage="https://github.com/troglobit/sysklogd"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sysklogd
version=2.7.2
release=1
backup="etc/syslog.conf"
source="https://github.com/troglobit/sysklogd/releases/download/v$version/sysklogd-$version.tar.gz
	rc.$name
	run"

build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--without-logger
	make
	make DESTDIR=$PKG install

	install -Dm644 syslog.conf $PKG/etc/syslog.conf

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.$name $PKG/etc/rc.d/$name || continue
	
	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run $PKG/etc/sv/$name/run
		ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
	} || continue
}
