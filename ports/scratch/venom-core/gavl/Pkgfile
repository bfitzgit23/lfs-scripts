# Depends: libpng
description="Low level library that handles the details of audio and video formats"
homepage="http://gmerlin.sourceforge.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gavl
version=1.4.0
release=3
source="https://downloads.sourceforge.net/gmerlin/$name-$version.tar.gz"

build() {

	# fix build with GCC 14
	export CFLAGS="${CFLAGS} -Wno-implicit-function-declaration"

	LIBS=-lm \
	./configure --prefix=/usr --without-doxygen --with-cpuflags=none
	make
	make DESTDIR=$PKG install
}
