# Depends: libx11
description="Property displayer for X"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xprop
version=1.2.8
release=1
source="http://ftp.x.org/pub/individual/app/xprop-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
