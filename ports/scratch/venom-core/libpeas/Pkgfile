# Depends: gobject-introspection gtk3 python3-gobject3 meson
description="GObject based plugins engine"
homepage="https://wiki.gnome.org/Projects/Libpeas"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libpeas
version=2.2.1
release=1
source="https://gitlab.gnome.org/GNOME/libpeas/-/archive/$version/$name-$version.tar.gz"

build() {
	venom-meson $name-$version build \
		-Dgtk_doc=false \
		-Dgjs=false \
		-Dlua51=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
