# Depends: libxmu
description="X server resource database utility"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xrdb
version=1.2.2
release=1
source="http://ftp.x.org/pub/individual/app/xrdb-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
