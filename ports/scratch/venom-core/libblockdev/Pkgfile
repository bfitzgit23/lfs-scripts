# Depends: cryptsetup gobject-introspection json-glib keyutils libbytesize libnvme parted yaml
description="C library supporting GObject introspection for manipulation of block devices"
homepage="https://github.com/storaged-project/libblockdev/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libblockdev
version=3.5.0
release=1
source="https://github.com/storaged-project/libblockdev/releases/download/$version/$name-$version.tar.gz"

build() {
	
	./configure \
		--prefix=/usr \
            	--sysconfdir=/etc \
            	--with-python3    \
		--without-escrow \
            	--without-gtk-doc \
		--without-nvdimm \
            	--without-dm
	make
	make DESTDIR=$PKG install
}

