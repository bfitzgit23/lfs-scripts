# Depends: basu inih wayland-protocols xdg-desktop-portal
description="xdg-desktop-portal backend for wlroots"
homepage="https://github.com/emersion/xdg-desktop-portal-wlr"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xdg-desktop-portal-wlr
version=0.8.3
release=1
source="https://github.com/emersion/xdg-desktop-portal-wlr/archive/v$version/$name-$version.tar.gz"

build() {
	venom-meson $name-$version build -Dsd-bus-provider=basu
	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
