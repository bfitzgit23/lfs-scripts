# Depends: e2fsprogs glib libssh2 perl slang
description="A file manager that emulates Norton Commander"
homepage="https://midnight-commander.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mc
version=4.8.33
release=1
source="http://ftp.midnight-commander.org/$name-$version.tar.xz"

build() {
	./configure --prefix=/usr \
	            --sysconfdir=/etc \
	            --libexecdir=/usr/lib \
	            --enable-charset
	make
	make DESTDIR=$PKG install
}
