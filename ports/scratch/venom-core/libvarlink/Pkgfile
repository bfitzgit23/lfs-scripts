# Depends: meson ninja
description="Varlink C library and command line tool"
homepage="https://github.com/varlink/libvarlink"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libvarlink
version=24.0.1
release=1
source="$name-$version.tar.gz::https://github.com/varlink/libvarlink/archive/refs/tags/v$version.tar.gz"

build() {
	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
