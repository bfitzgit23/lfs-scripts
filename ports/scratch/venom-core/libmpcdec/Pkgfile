# Depends: libcue libreplaygain
description="MusePack decoding library"
homepage="https://musepack.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libmpcdec
version=1.2.6
release=1
source="http://files.musepack.net/source/libmpcdec-$version.tar.bz2"

build() {
	./configure \
		--prefix=/usr \
		--disable-static
	make
	make DESTDIR=$PKG install
}

