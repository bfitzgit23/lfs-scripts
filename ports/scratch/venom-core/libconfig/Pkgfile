description="C/C++ Configuration File Library"
homepage="https://github.com/hyperrealm/libconfig"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libconfig
version=1.8.2
release=1
source="$name-$version.tar.gz::https://github.com/hyperrealm/libconfig/archive/v$version.tar.gz"

build() {

	autoreconf -vi

	./configure --prefix=/usr
	sed -i "s/doc//g" Makefile

	make
	make DESTDIR=$PKG install
}

