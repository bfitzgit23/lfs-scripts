# Depends: libxmu libx11 libxext
description="User preference utility for X"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xset
version=1.2.5
release=1
source="http://ftp.x.org/pub/individual/app/xset-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

