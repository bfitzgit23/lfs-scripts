# Depends: gtk4-layer-shell json-glib libhandy pulseaudio scdoc granite blueprint-compiler libadwaita
description="A simple GTK based notification daemon for SwayWM"
homepage="https://github.com/ErikReider/SwayNotificationCenter"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=swaync
version=0.12.6
release=1
source="$name-$version.tar.gz::https://github.com/ErikReider/SwayNotificationCenter/archive/v$version.tar.gz"

build() {
	venom-meson SwayNotificationCenter-$version build \
		-Dsystemd-service=false \
		-Dscripting=true
	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
