description="X.Org Autotools macros"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=util-macros
version=1.20.2
release=1
source="http://ftp.x.org/pub/individual/util/util-macros-$version.tar.xz"

build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make DESTDIR=$PKG install
}

