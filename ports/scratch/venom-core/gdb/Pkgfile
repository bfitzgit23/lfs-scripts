# Depends: expat libmpfr readline texinfo xz zlib
description="The GNU Debugger (GDB)"
homepage="https://www.gnu.org/software/gdb"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gdb
version=17.2
release=1
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.xz"

build() {

	mkdir build && cd build

	../configure \
		--prefix=/usr \
		--disable-nls \
		--enable-64-bit-bfd  \
		--enable-lto \
		--enable-tui \
		--with-system-readline \
		--with-system-zlib\
		--with-python=/usr/bin/python3
	make
	make -C gdb DESTDIR=$PKG install   
	make -C gdbserver DESTDIR=$PKG install
}
