# Depends: python3-gpep517 python3-setuptools python3-hatchling python3-hatch-vcs
description="HTTP library with thread-safe connection pooling and file post support"
homepage="https://github.com/urllib3/urllib3"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-urllib3
_name=${name#*-}
_n=${_name%${_name#?}}
version=2.7.0
release=1
source="$name-$version.tar.gz::https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz"

build() {
	cd ${name#*-}-$version

	gpep517 build-wheel \
                --wheel-dir .dist \
                --output-fd 3 3>&1 >&2
        python3 -m installer -d $PKG \
                .dist/*.whl
}
