# Depends: fuse3 gcr gtk3 libcdio-paranoia libsoup3 libusb udisks2
description="Userspace virtual filesystem designed to work with the I/O abstractions of GLib's GIO library"
homepage="https://gitlab.gnome.org/GNOME/gvfs"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gvfs
version=1.60.1
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	venom-meson $name-$version build \
		-Dafc=false \
		-Dbluray=false \
		-Dcdda=false \
		-Ddnssd=false \
		-Dgoa=false \
		-Dgoogle=false \
		-Dgphoto2=false \
		-Dlogind=false \
		-Dmtp=false \
		-Dnfs=false \
		-Donedrive=false \
		-Dsftp=false \
		-Dsmb=false \
		-Dsystemduserunitdir=no \
		-Dtmpfilesdir=no 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# Exclude library for revdep
	mkdir -pv $PKG/etc/revdep.d/
	echo libgvfscommon.so > $PKG/etc/revdep.d/$name.conf
}
