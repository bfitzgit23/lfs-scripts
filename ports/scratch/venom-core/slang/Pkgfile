# Depends: libpng pcre2
description="S-Lang is a powerful interpreted language"
homepage="https://www.jedsoft.org/slang/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=slang
version=2.3.3
release=2
source="https://www.jedsoft.org/releases/$name/$name-$version.tar.bz2"

build() {

	./configure --prefix=/usr \
	            --sysconfdir=/etc \
	            --with-readline=gnu
	make || make -j1
	make -j1 DESTDIR=$PKG \
		install_doc_dir=/usr/share/doc/$name   \
		SLSH_DOC_DIR=/usr/share/doc/$name/slsh \
	install-all

	chmod -v 755 $PKG/usr/lib/libslang.so.$version \
             $PKG/usr/lib/slang/v2/modules/*.so

}
