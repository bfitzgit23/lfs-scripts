# Depends: python3-gobject3 bash-completion
description="MBIM modem protocol helper library"
homepage="https://www.freedesktop.org/wiki/Software/libmbim/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libmbim
version=1.34.0
release=1
source="https://gitlab.freedesktop.org/mobile-broadband/libmbim/-/archive/$version/$name-$version.tar.gz"

build() {
	venom-meson $name-$version build -Dman=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
