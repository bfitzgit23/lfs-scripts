# Depends: curl gnutls libndp libxslt newt nss polkit python3-gobject3 libpsl vala wpa_supplicant jansson
description="Network connection manager and user applications"
homepage="https://networkmanager.dev/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=networkmanager
version=1.56.1
release=1
backup="etc/NetworkManager/NetworkManager.conf"
source="$name-$version.tar.gz::https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/$version/NetworkManager-$version.tar.gz
	rc.$name
	run"

build() {
	venom-meson NetworkManager-$version build \
		-Ddocs=false \
		-Dlibaudit=no \
		-Dmodem_manager=$(scratch isinstalled modemmanager && printf "true" || printf "false") \
		-Dmodify_system=true \
		-Dnmtui=true \
		-Dovs=false \
		-Dpolkit_noauth_group=wheel \
		-Dppp=false \
		-Dqt=false \
		-Dselinux=false \
		-Dsession_tracking=no \
		-Dsystemd_journal=false \
		-Dsystemdsystemunitdir=no \
		-Dtests=no \
		-Dudev_dir=/lib/udev \
		-Dvapi=false
	meson compile -C build 
	DESTDIR=$PKG meson install --no-rebuild -C build

mkdir -p $PKG/etc/NetworkManager
cat >> $PKG/etc/NetworkManager/NetworkManager.conf << "EOF"
[main]
plugins=keyfile
EOF

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run $PKG/etc/sv/$name/run
		ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
	} || continue

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.$name $PKG/etc/rc.d/$name || continue
}
