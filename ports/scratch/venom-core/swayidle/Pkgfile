# Depends: wayland-protocols scdoc
description="Idle management daemon for Wayland"
homepage="https://github.com/swaywm/swayidle"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=swayidle
version=1.9.0
release=1
source="https://github.com/swaywm/$name/releases/download/v$version/$name-$version.tar.gz"

build() {
	venom-meson $name-$version build \
		-Dbash-completions=$(scratch isinstalled bash-completions && printf "true" || printf "false") \
		-Dfish-completions=$(scratch isinstalled fish-completions && printf "true" || printf "false") \
		-Dzsh-completions=$(scratch isinstalled zsh-completions && printf "true" || printf "false") \
		-Dlogind=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
