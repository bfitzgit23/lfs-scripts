# Depends: xorgproto libx11 xkbcomp
description="Keyboard configuration database for the X Window System"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xkeyboard-config
version=2.48
release=1
source="https://gitlab.freedesktop.org/$name/$name/-/archive/$name-$version/$name-$name-$version.tar.bz2"

build() {

        venom-meson $name-$name-$version build \
		-Dcompat-rules=true \
		-Dxorg-rules-symlinks=true
        meson compile -C build
        DESTDIR=$PKG meson install --no-rebuild -C build
}
