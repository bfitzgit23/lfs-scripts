# Depends: libdisplay-info libinput libxkbcommon mesa pixman seatd wayland-protocols xcb-util-errors xcb-util-image xcb-util-renderutil xcb-util-wm
description="Modular Wayland compositor library "
homepage="https://gitlab.freedesktop.org/wlroots/wlroots"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=wlroots
version=0.19.3
release=1
source="https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/$version/wlroots-$version.tar.gz"

build() {
	venom-meson $name-$version build \
		-Dwerror=false \
		-Dexamples=false \
		-Dxwayland=$(scratch isinstalled xwayland && printf "enabled" || printf "disabled") \
		-Dbackends=drm,libinput,x11 \
		-Dlibliftoff=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
