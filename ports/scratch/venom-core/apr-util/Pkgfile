# Depends: openssl apr
description="Predictable and consistent interface to underlying client library interfaces"
homepage="https://apr.apache.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=apr-util
version=1.6.3
release=1
source="https://archive.apache.org/dist/apr/$name-$version.tar.bz2"

build() {
	./configure --prefix=/usr       \
	            --with-apr=/usr     \
	            --with-gdbm=/usr    \
	            --with-openssl=/usr \
	            --with-crypto
	make
	make DESTDIR=$PKG install
}

