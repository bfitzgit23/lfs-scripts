# Depends: spice libxfont2 python3 xorg-server spice-protocol xorgproto
description="Xorg X11 qxl video driver"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xf86-video-qxl
version=0.1.6
release=1
source="https://www.x.org/pub/individual/driver/$name-$version.tar.xz"

build() {

	./configure\
	    --prefix=/usr \
	    --sysconfdir=/etc \
	    --mandir=/usr/share/man \
	    --infodir=/usr/share/info \
	    --localstatedir=/var \
	    --enable-xspice=yes
	make
	make DESTDIR=$PKG install
}
