# Depends: gdbm openssl libffi zlib yaml libgmp
description="Ruby development environment"
homepage="https://www.ruby-lang.org/en/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ruby
version=4.0.5
release=1
source="https://cache.ruby-lang.org/pub/$name/${version%.*}/$name-$version.tar.xz"

build() {

	./configure --prefix=/usr \
		--disable-rpath \
		--enable-shared \
		--without-valgrind \
		--without-baseruby \
		--disable-install-doc \
		--disable-install-rdoc \
		--disable-install-capi
	make
	make DESTDIR=$PKG install

	# https://bugs.ruby-lang.org/issues/20721 remove with 3.3.6
	rm -f $PKG/usr/bin/*.lock
}
