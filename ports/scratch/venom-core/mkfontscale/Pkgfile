# Depends: libfontenc freetype2
description="Create an index of scalable font files for X"
homepage="https://gitlab.freedesktop.org/xorg/app/mkfontscale"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mkfontscale
version=1.2.4
release=1
source="http://ftp.x.org/pub/individual/app/mkfontscale-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
