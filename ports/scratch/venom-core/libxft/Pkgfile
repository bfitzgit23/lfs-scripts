# Depends: fontconfig freetype2 libxrender libx11
description="FreeType-based font drawing library for X"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxft
version=2.3.9
release=1
source="$name-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXft-$version.tar.xz"

build() {
	cd libXft-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
