# Depends: libxinerama libxft freetype2
description="A dynamic window manager for X"
homepage="https://dwm.suckless.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=dwm
version=6.8
release=1
source="https://dl.suckless.org/dwm/dwm-$version.tar.gz"

_portdir=$PWD

build() {

	cbuild_restore "$SRC/$name-$version/config.h" || cp config.def.h config.h

	for p in $_portdir/*.patch $_portdir/*.diff; do
		[ -f $p ] || continue
		patch -Np1 -i $p
	done

	make PREFIX=/usr
	make PREFIX=/usr DESTDIR=$PKG install
}
