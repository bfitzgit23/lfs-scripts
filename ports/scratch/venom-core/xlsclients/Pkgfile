# Depends: libxcb
description="List client applications running on a display"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xlsclients
version=1.1.6
release=1
source="http://ftp.x.org/pub/individual/app/xlsclients-$version.tar.xz"

build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

