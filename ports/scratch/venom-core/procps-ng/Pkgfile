# Depends: ncurses
description="Utilities for monitoring your system and its processes"
homepage="https://gitlab.com/procps-ng/procps"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=procps-ng
version=4.0.6
release=1
source="https://sourceforge.net/projects/procps-ng/files/Production/$name-$version.tar.xz"

build() {

	CONFIG_SHELL=/bin/bash \
	./configure \
		--prefix=/usr \
		--disable-kill \
		--disable-modern-top \
		--disable-rpath \
		--disable-static \
		--disable-w-from \
		--with-ncurses
	make
	make DESTDIR=$PKG install
}
