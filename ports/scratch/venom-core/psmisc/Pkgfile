# Depends: ncurses
description="Miscellaneous procfs tools"
homepage="https://gitlab.com/psmisc/psmisc"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=psmisc
version=23.7
release=1
source="https://sourceforge.net/projects/psmisc/files/psmisc/psmisc-$version.tar.xz"

build() {

	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install

	mkdir -p $PKG/bin
	mv -v $PKG/usr/bin/fuser   $PKG/bin
	mv -v $PKG/usr/bin/killall $PKG/bin
}
