# Depends: perl
description="Library for high quality hyphenation and justification"
homepage="https://hunspell.sf.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=hyphen
version=2.8.9
release=1
source="https://github.com/hunspell/hyphen/releases/download/v$version/$name-$version.tar.gz"

build() {
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
}
