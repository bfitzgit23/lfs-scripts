# Depends: enchant gtk3 iso-codes gobject-introspection vala
description="A flexible API to implement the spell checking in a GTK+ application"
homepage="https://wiki.gnome.org/Projects/gspell"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gspell
version=1.14.4
release=1
source="https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2"

build() {
	venom-meson $name-$version build \
		-Dgtk_doc=false \
		-Dtests=false \
		-Dinstall_tests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
