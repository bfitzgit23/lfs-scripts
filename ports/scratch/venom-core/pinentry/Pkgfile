# Depends: libassuan libgpg-error
description="Collection of simple PIN or pass-phrase entry dialogs which utilize the Assuan protocol"
homepage="https://gnupg.org/related_software/pinentry/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pinentry
version=1.3.2
release=1
source="https://www.gnupg.org/ftp/gcrypt/$name/$name-$version.tar.bz2"

build() {

	opt=""
	scratch isinstalled emacs || opt="$opt --disable-pinentry-emacs"
	scratch isinstalled gtk2  || opt="$opt --disable-pinentry-gtk2"
	scratch isinstalled qt5   || opt="$opt --disable-pinentry-qt5"
	scratch isinstalled qt6-base || opt="$opt --disable-pinentry-qt"
	scratch isinstalled gcr || opt="$opt --disable-pinentry-gnome3"

	CXXFLAGS="$CXXFLAGS -fPIC"

	./configure --prefix=/usr \
	    --enable-pinentry-tty \
	    --enable-pinentry-curses \
	    --enable-fallback-curses \
	    $opt
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share
}
