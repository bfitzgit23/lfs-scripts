# Depends: alsa-lib
description="Plugins for various audio libraries and sound servers"
homepage="https://www.alsa-project.org/wiki/Main_Page"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=alsa-plugins
version=1.2.12
release=1
source="ftp://ftp.alsa-project.org/pub/plugins/$name-$version.tar.bz2"

build() {

	./configure --prefix=/usr --sysconfdir=/etc
	make
	make DESTDIR=$PKG install
}
