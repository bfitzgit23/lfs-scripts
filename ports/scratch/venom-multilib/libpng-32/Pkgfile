# Depends: zlib-32
description="A collection of routines used to create PNG format graphics files (32bit)"
homepage="http://www.libpng.org/pub/png/libpng.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libpng-32
version=1.6.58
release=1
source="https://downloads.sourceforge.net/libpng/libpng-$version.tar.xz
       https://downloads.sourceforge.net/sourceforge/libpng-apng/libpng-$version-apng.patch.gz"

build() {
	cd libpng-$version
        
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

        gzip -cd $SRC/libpng-$version-apng.patch.gz | patch -p1

        autoreconf -fiv

	LIBS=-lpthread ./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
