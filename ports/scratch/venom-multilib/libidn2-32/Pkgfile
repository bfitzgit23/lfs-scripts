# Depends: libidn2 libunistring-32
description="Provides support for IETF Internationalized Domain Names (IDN)"
homepage="https://www.gnu.org/software/libidn/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libidn2-32
version=2.3.8
release=1
source="https://ftp.gnu.org/gnu/libidn/${name%-*}-$version.tar.gz"

build() {
	cd ${name%-*}-$version

       	export CC="gcc -m32"
        export CXX="g++ -m32"
        export PKG_CONFIG_PATH='/usr/lib32/pkgconfig'

	./configure \
                --host=i686-pc-linux-gnu \
		--prefix=/usr \
		--libdir=/usr/lib32 
	make
	make DESTDIR=$PWD/DESTDIR install

        mkdir -p $PKG/usr/lib32
        cp -Rv DESTDIR/usr/lib32/*  $PKG/usr/lib32/
}

