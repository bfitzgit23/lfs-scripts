# Depends: libunistring
description="Functions for manipulating Unicode strings and C strings"
homepage="https://www.gnu.org/software/libunistring/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libunistring-32
version=1.4.2
release=1
source="https://mirrorservice.org/sites/ftp.gnu.org/gnu/libunistring/libunistring-1.4.2.tar.xz"

build() {
	cd libunistring-$version

      	export CC="gcc -m32"
        export CXX="g++ -m32"
        export PKG_CONFIG_PATH='/usr/lib32/pkgconfig'

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32
	make
	make DESTDIR=$PWD/DESTDIR install
        mkdir -p $PKG/usr/lib32
        cp -Rv DESTDIR/usr/lib32/*  $PKG/usr/lib32/
}

