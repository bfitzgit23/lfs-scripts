# Depends: cmake ninja alsa-lib-32 openal
description="Cross-platform 3D audio."
homepage="https://github.com/kcat/openal-soft"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=openal-32
version=1.25.1
release=1
source="https://github.com/kcat/openal-soft/archive/$version/openal-soft-$version.tar.gz"

build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cmake -S openal-soft-$version -B build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=lib32 \
		-DCMAKE_INSTALL_LIBEXECDIR=lib32 \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D ALSOFT_UTILS=OFF \
		-D ALSOFT_EXAMPLES=OFF \
		-Wno-dev

	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -r $PKG/usr/include 
	rm -r $PKG/usr/share
}
