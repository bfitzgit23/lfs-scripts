# Depends: perl numactl
description="Simple NUMA policy support 32-bit version. Libraries only "
homepage="https://github.com/numactl/numactl"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=numactl-32
version=2.0.19
release=1
source="${name%-*}-${version}.tar.gz::https://github.com/numactl/numactl/archive/refs/tags/v${version}.tar.gz"


build() {
	export CC='gcc -m32' 
	export CXX='g++ -m32' 
	export PKG_CONFIG_PATH='/usr/lib32/pkgconfig'

	cd ${name%-*}-$version
	autoreconf -i
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--host=i686-unknown-linux-gnu

	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}

