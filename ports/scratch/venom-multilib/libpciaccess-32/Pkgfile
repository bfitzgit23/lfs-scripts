# Depends: libpciaccess util-macros
description="X11 PCI access library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libpciaccess"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libpciaccess-32
version=0.19
release=1
source="http://ftp.x.org/pub/individual/lib/libpciaccess-$version.tar.xz"

build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"
         
         venom-meson libpciaccess-$version build \
       	    --libdir=/usr/lib32 \
            --libexecdir=/usr/lib32
         meson compile -C build 
	 DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build
        mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
