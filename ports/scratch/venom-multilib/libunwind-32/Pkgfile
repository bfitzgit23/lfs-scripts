# Depends: libunwind
description="Portable and efficient API to determine the call-chain of a program"
homepage="https://savannah.nongnu.org/projects/libunwind"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libunwind-32
version=1.8.3
release=1
source="https://github.com/libunwind/libunwind/releases/download/v$version/${name%-*}-$version.tar.gz
       457612f470f8c0e718cdf7f14ef1ecb583f3b3a6.patch "

build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cd ${name%-*}-$version
        
        patch -Np1 -i $SRC/457612f470f8c0e718cdf7f14ef1ecb583f3b3a6.patch
	autoreconf -fvi
	./configure \
		--build=i686-pc-linux-gnu \
		--host=i686-pc-linux-gnu \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-documentation
	make
	make DESTDIR=$PWD/DESTDIR install

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32

	mkdir -p $PKG/usr/include
	cp -v DESTDIR/usr/include/libunwind-x86.h $PKG/usr/include

}
