# Depends: libsndfile-32 dbus-32 glib-32 speexdsp-32 libsm-32 libxtst-32 libtool-32 pulseaudio
description="Sound system for POSIX OSes"
homepage="https://www.freedesktop.org/wiki/Software/PulseAudio/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pulseaudio-32
version=17.0
release=3
source="https://www.freedesktop.org/software/pulseaudio/releases/${name%-*}-$version.tar.xz"

build() {
        export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"
	venom-meson ${name%-*}-$version build \
		--libdir=/usr/lib32 \
		-D daemon=false \
		-D tests=false \
		-D doxygen=false \
		-D man=false 
	meson compile -C build
	DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
