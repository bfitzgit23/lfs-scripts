# Depends: libxkbfile xorgproto-32 libx11-32
description="X11 keyboard file manipulation library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxkbfile"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxkbfile-32
version=1.2.0
release=2
source="http://ftp.x.org/pub/individual/lib/${name%-*}-$version.tar.xz"

build() {

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson ${name%-*}-$version build \
	   --libdir=/usr/lib32 \
	   --libexecdir=/usr/lib32
        meson compile -C build
        DESTDIR=$PKG meson install --no-rebuild -C build
        rm -rf "${PKG}/usr/include"
}
