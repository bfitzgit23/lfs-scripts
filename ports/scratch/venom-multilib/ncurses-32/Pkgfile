# Depends: ncurses
description="Libraries for terminal-independent handling of character screens (32bit)"
homepage="https://invisible-island.net/ncurses/ncurses.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ncurses-32
version=6.6
vrsn=$(printf "$version" | sed 's/\./_/g')
snapshot=20251230
release=1
source="https://github.com/ThomasDickey/${name%-*}-snapshots/archive/v${vrsn}_$snapshot.tar.gz"

build() {
	cd ${name%-*}-snapshots-${vrsn}_$snapshot

	export CC="gcc -m32" CXX="g++ -m32"

	sed -i '/LIBTOOL_INSTALL/d' c++/Makefile.in

	./configure --prefix=/usr           \
		    --libdir=/usr/lib32     \
	            --mandir=/usr/share/man \
	            --with-shared           \
	            --without-debug         \
	            --without-normal        \
	            --enable-pc-files       \
	            --enable-widec
	make
	make DESTDIR=$PWD/DESTDIR install
	for lib in ncurses form panel menu ; do
	    rm -vf                    DESTDIR/usr/lib32/lib${lib}.so
	    echo "INPUT(-l${lib}w)" > DESTDIR/usr/lib32/lib${lib}.so
	done
	rm -vf                     DESTDIR/usr/lib32/libcursesw.so
	echo "INPUT(-lncursesw)" > DESTDIR/usr/lib32/libcursesw.so
	ln -sfv libncurses.so      DESTDIR/usr/lib32/libcurses.so
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
