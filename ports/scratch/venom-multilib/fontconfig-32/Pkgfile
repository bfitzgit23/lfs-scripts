# Depends: fontconfig expat-32 freetype2-32 util-linux-32
description="A library and support programs used for configuring and customizing font access (32bit)"
homepage="https://www.freedesktop.org/wiki/Software/fontconfig/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=fontconfig-32
version=2.18.1
release=1
source="https://gitlab.freedesktop.org/fontconfig/fontconfig/-/archive/$version/fontconfig-$version.tar.bz2"

build() {
	cd fontconfig-$version
        
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	# make sure the system regenerates src/fcobjshash.h
	rm -f src/fcobjshash.h
        ./autogen.sh
	./configure --prefix=/usr        \
		    --libdir=/usr/lib32  \
	            --sysconfdir=/etc    \
	            --localstatedir=/var \
	            --disable-docs
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
