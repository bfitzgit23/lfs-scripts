# Depends: flac-32 libvorbis-32 alsa-lib-32 libsndfile opus-32
description="Library of C routines for reading and writing files containing sampled audio data"
homepage="https://libsndfile.github.io/libsndfile/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libsndfile-32
version=1.2.2
release=3
source="https://github.com/libsndfile/libsndfile/releases/download/$version/${name%-*}-$version.tar.xz"

build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cmake -S libsndfile-$version -B build -G Ninja \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
                -D CMAKE_INSTALL_LIBDIR=lib32 \
		-DBUILD_TESTING=OFF \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
       
       rm -rf "$PKG/usr/bin"
       rm -rf "$PKG/usr/include"
       rm -rf "$PKG/usr/share/man/man1"
}
