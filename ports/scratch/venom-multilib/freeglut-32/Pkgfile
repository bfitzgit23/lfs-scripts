# Depends: freeglut glu-32 libxi-32
description="a free alternative to the OpenGL Utility Toolkit (GLUT) library"
homepage="https://freeglut.sourceforge.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=freeglut-32
version=3.8.0
release=2
source="https://github.com/freeglut/freeglut/releases/download/v$version/${name%-*}-$version.tar.gz"

build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"


	cmake -S ${name%-*}-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib32 \
		-DCMAKE_INSTALL_LIBEXECDIR=lib32 \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DFREEGLUT_INSTALL_MAN_PAGES=OFF \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build

	ln -s glut.pc $PKG/usr/lib32/pkgconfig/freeglut.pc

	rm -r $PKG/usr/include
}
