# Depends: python3
description="Trivial DataBase similar to gdbm"
homepage="https://tdb.samba.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=tdb-32
_name=tdb
version=1.4.15
release=1
source="https://www.samba.org/ftp/$_name/$_name-$version.tar.gz"

build() {
        export XML_CATALOG_FILES=/etc/xml/catalog
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cd ${name%-*}-$version
	./configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --disable-python
	make
	make DESTDIR=$PWD/DESTDIR install
	
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
