# Depends: dbus expat-32 libx11-32
description="Message bus system, a simple way for applications to talk to one another"
homepage="https://www.freedesktop.org/wiki/Software/dbus/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=dbus-32
version=1.16.2
release=1
source="https://dbus.freedesktop.org/releases/dbus/dbus-$version.tar.xz"

build() {
        export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson dbus-$version build \
		--libdir=/usr/lib32 \
		--libexecdir=/usr/lib32/dbus \
		-Dsystem_pid_file=/run/dbus/dbus.pid 
	meson compile -C build
	DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build

	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
