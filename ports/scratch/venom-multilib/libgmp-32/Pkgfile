# Depends: libgmp
description="Contains math libraries that useful functions for arbitrary precision arithmetic"
homepage="https://gmplib.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libgmp-32
version=6.3.0
release=2
source="https://ftp.osuosl.org/pub/gnu/gmp/gmp-$version.tar.xz"

build() {
	cd gmp-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	# fix build with GCC 15
	export CFLAGS="$CFLAGS -std=gnu17"	

	./configure --prefix=/usr    \
		    --libdir=/usr/lib32 \
		    --build=i686-pc-linux-gnu \
	            --enable-cxx     \
	            --disable-static
	make
	make DESTDIR=$PKG install

	mv $PKG/usr/include/gmp.h $PKG/usr/include/gmp-32.h
	rm $PKG/usr/include/gmpxx.h

	rm -fr $PKG/usr/share/ 
}
