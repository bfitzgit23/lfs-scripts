# Depends: libxfixes xorgproto-32 libx11-32
description="X11 miscellaneous 'fixes' extension library"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxfixes-32
version=6.0.2
release=1
source="${name%-*}-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXfixes-$version.tar.xz"

build() {
	cd libXfixes-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}

