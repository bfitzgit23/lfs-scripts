# Depends: libxcomposite xorgproto-32 libx11-32 libxfixes-32
description="X11 Composite extension library"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxcomposite-32
version=0.4.7
release=1
source="${name%-*}-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXcomposite-$version.tar.xz"

build() {
	cd libXcomposite-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
