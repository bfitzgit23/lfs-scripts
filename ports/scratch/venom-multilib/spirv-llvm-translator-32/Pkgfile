# Depends: llvm-32 spirv-tools-32
description="A tool and a library for bi-directional translation between SPIR-V and LLVM IR"
homepage="https://github.com/KhronosGroup/SPIRV-LLVM-Translator"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=spirv-llvm-translator-32
version=22.1.3
release=1
source="https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v$version/${name%-*}-$version.tar.gz"

build() {

	export CC="gcc -m32"
	export CXX="g++ -m32"
        export ASMFLAGS="-m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	cmake -S SPIRV-LLVM-Translator-$version -B build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=lib32\
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-D CMAKE_POSITION_INDEPENDENT_CODE=ON \
		-D CMAKE_SKIP_RPATH=ON \
		-D LLVM_BUILD_TOOLS=ON \
		-D CCACHE_ALLOWED=OFF \
		-D LLVM_DIR=/usr/lib32/cmake/llvm \
		-D LLVM_SPIRV_BUILD_EXTERNAL=YES \
		-D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr/include/spirv \
		-D FETCHCONTENT_FULLY_DISCONNECTED=ON \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -rf $PKG/usr/share
	rm -rf $PKG/usr/include
	rm -rf $PKG/usr/bin
}
