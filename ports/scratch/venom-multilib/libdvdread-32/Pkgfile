# Depends: libdvdread
description="Library which provides a simple foundation for reading DVDs"
homepage="https://www.videolan.org/developers/libdvdnav.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libdvdread-32
version=7.0.1
release=1
source="https://code.videolan.org/videolan/libdvdread/-/archive/$version/${name%-*}-$version.tar.gz"

build() {
	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson libdvdread-$version build \
		--libdir=/usr/lib32 \
		--libexecdir=/usr/lib32 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
	
	rm -rf $PKG/usr/include $PKG/usr/share
}
