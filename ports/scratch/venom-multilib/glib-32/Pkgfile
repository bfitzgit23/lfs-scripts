# Depends: glib pcre2-32 libffi-32 util-linux-32 elfutils-32 zlib-32
description="Low-level libraries useful for providing data structure handling for C, portability wrappers and interfaces"
homepage="https://gitlab.gnome.org/GNOME/glib"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=glib-32
version=2.88.2
release=1
source="https://download.gnome.org/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz"

build() {

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	venom-meson ${name%-*}-$version build \
		--libdir=/usr/lib32 \
		--libexecdir=/usr/lib32 \
		-D glib_debug=disabled \
		-D sysprof=disabled \
		-D man=false \
		-D gtk_doc=false \
		-D nls=disabled \
		-D selinux=disabled \
                -D introspection=disabled \
                -D glib_debug=disabled \
		-D tests=false
	meson compile -C build
	DESTDIR=$PWD/DESTDIR meson install --no-rebuild -C build

	mkdir -p $PKG/usr/bin $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
	mv DESTDIR/usr/bin/gio-querymodules $PKG/usr/bin/gio-querymodules-32

	install -d $PKG/usr/lib32/gio/modules
}
