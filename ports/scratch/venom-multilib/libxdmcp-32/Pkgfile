# Depends: libxdmcp xorgproto-32
description="X11 Display Manager Control Protocol library"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxdmcp"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxdmcp-32
version=1.1.5
release=1
source="${name%-*}-$version.tar.xz::http://ftp.x.org/pub/individual/lib/libXdmcp-$version.tar.xz"

build() {
	cd libXdmcp-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib32 \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
