# Depends: gtk2
description="MATE themes"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-themes
version=3.22.26
release=1
source="https://github.com/mate-desktop/$name/releases/download/v$version/$name-$version.tar.xz"

build() {
	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}

