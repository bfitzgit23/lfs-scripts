# Depends: glib libgtop libwnck3 gtkmm3 gtk3 cairomm libxml2 librsvg gdk-pixbuf glibmm itstool polkit
description="A system monitor for MATE"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mate-system-monitor
version=1.28.1
release=1
source="https://pub.mate-desktop.org/releases/${version%.*}/$name-$version.tar.xz"

build() {
	./configure --prefix=/usr --disable-systemd --libexecdir=/usr/lib --disable-nls
	make
	make DESTDIR=$PKG install
}
