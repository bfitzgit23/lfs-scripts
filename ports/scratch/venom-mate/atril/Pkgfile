# Depends: gtk3 libsecret caja poppler-glib zlib libtiff libsm libice libx11 gtk-doc yelp-tools
description="MATE document viewer"
homepage="https://mate-desktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=atril
version=1.28.3
release=1
source="https://github.com/mate-desktop/atril/releases/download/v$version/$name-$version.tar.xz"

build() {

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/$name \
		--disable-synctex
	make
	make DESTDIR=$PKG install
}
