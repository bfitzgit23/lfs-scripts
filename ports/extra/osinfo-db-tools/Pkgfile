# Depends: json-glib libsoup3
description="Tools for management of the osinfo database"
homepage="https://libosinfo.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=osinfo-db-tools
version=1.12.0
release=1
source="https://gitlab.com/libosinfo/osinfo-db-tools/-/archive/v$version/$name-v$version.tar.gz"

pkg_build() {

	venom-meson $name-v$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -r $PKG/usr/share/locale
}
