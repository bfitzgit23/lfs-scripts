# Depends: python3 python3-installer

name=python3-setuptools
version=84.2.1
release=1
# setuptools' sdist bootstrap imports distutils, which Python 3.14 no longer
# ships, so building it needs a working distutils shim before setuptools is
# installed - that is the "No module named 'distutils'" death spiral. The
# upstream wheel is built with a working setuptools, so installing it skips
# the bootstrap, and it still carries setuptools' vendored distutils and
# distutils-precedence.pth for the setup.py-based recipes in the tree.
noextract="setuptools-$version-py3-none-any.whl"
source=(https://files.pythonhosted.org/packages/py3/s/setuptools/setuptools-$version-py3-none-any.whl)

pkg_build() {
	python3 -m installer -d $PKG $SRC/setuptools-$version-py3-none-any.whl
}
