# Depends: zlib openssl
description="BitTorrent library with a focus on high performance and good code"
homepage="https://rakshasa.github.io/rtorrent/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libtorrent
version=0.16.28
release=1
source=(https://github.com/rakshasa/$name/archive/refs/tags/v$version.tar.gz)
renames=(libtorrent-0.16.28.tar.gz)

pkg_build() {
	if [ -d libtorrent-$version ]; then
		cd libtorrent-$version
	fi

	autoreconf -fiv

	./configure --prefix=/usr --disable-debug
	make
	make DESTDIR=$PKG install
}
