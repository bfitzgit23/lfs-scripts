# Depends: basu gtest ninja
description="Unofficial, high-level C++ dbus bindings"
homepage="https://github.com/Kistler-Group/sdbus-cpp/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sdbus-cpp
version=2.3.1
release=1
source="$name-$version.tar.gz::https://github.com/Kistler-Group/sdbus-cpp/archive/v$version.tar.gz"

pkg_build() {
	cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DBUILD_SHARED_LIBS=True \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
