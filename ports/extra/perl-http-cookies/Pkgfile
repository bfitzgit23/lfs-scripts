# Depends: perl
description="HTTP cookie jars"
homepage="https://metacpan.org/release/HTTP-Cookies"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-http-cookies
version=6.12
release=1
source=(https://cpan.metacpan.org/authors/id/O/OA/OALDERS/HTTP-Cookies-$version.tar.gz)
renames=(perl-http-cookies-6.12.tar.gz)

pkg_build() {
        cd HTTP-Cookies-$version
	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
        make DESTDIR=$PKG install

}

