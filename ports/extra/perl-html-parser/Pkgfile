# Depends: perl-html-tagset
description="Perl HTML parser class"
homepage="https://metacpan.org/dist/HTML-Parser"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-html-parser
version=3.87
release=1
source=(https://www.cpan.org/authors/id/O/OA/OALDERS/HTML-Parser-$version.tar.gz)
renames=(perl-html-parser-3.87.tar.gz)

pkg_build() {
	if [ -d HTML-Parser-$version ]; then
		cd HTML-Parser-$version
	fi
	perl Makefile.PL INSTALLDIRS=vendor
	make OPTIMIZE="$CFLAGS"
	make DESTDIR=$PKG install
	find $PKG -name *.pod -delete
	rm -rf $PKG/usr/share
}
