# Depends: numactl gst-plugins-base libass lame gtk3 speex jansson opus libvpx x264
description="Multithreaded video transcoder"
homepage="https://handbrake.fr/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=handbrake
version=1.11.2
release=1
source=(https://github.com/HandBrake/HandBrake/releases/download/$version/HandBrake-$version-source.tar.bz2)
renames=(handbrake-1.11.2.tar.bz2)

pkg_build() {
	cd HandBrake-$version

	ln -s "$SOURCE_DIR" download

	./configure --prefix=/usr --disable-df-fetch --enable-fdk-aac --enable-qsv --lto
	make -C build
	make -C build DESTDIR=$PKG install
}
