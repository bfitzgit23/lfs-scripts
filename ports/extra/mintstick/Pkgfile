# Depends: coreutils e2fsprogs exfatprogs gtk3 parted polkit python3 python3-gnupg python3-gobject python3-pyparted python3-requests python3-unidecode udisks2 util-linux xapp
description="Write .img and .iso files to USB sticks, and format them"
homepage="https://github.com/linuxmint/mintstick"

name=mintstick
version=1.6.9
release=1
source=(http://deb.debian.org/debian/pool/main/m/mintstick/mintstick_$version.orig.tar.xz)
renames=(mintstick-$version.tar.xz)
# Formatting runs mkdosfs (dosfstools) for FAT32 and mkntfs (ntfs-3g) for
# NTFS; neither port exists in this tree, so only exFAT and ext4 are
# available at runtime.

pkg_build() {
	# install.sh writes straight into /usr, so lay the files out here,
	# following the mapping the Debian package uses.
	install -d "$PKG/usr/bin" \
		"$PKG/usr/lib/mintstick" \
		"$PKG/usr/share/applications" \
		"$PKG/usr/share/icons" \
		"$PKG/usr/share/kde4/apps/solid/actions" \
		"$PKG/usr/share/mintstick" \
		"$PKG/usr/share/nemo/actions" \
		"$PKG/usr/share/polkit-1/actions" || return 1

	install -m755 mintstick mint-iso-verify bin/* "$PKG/usr/bin/" || return 1
	install -m644 lib/*.py "$PKG/usr/lib/mintstick/" || return 1
	install -m644 share/mintstick/* "$PKG/usr/share/mintstick/" || return 1
	install -m644 share/applications/* "$PKG/usr/share/applications/" || return 1
	install -m644 share/polkit/* "$PKG/usr/share/polkit-1/actions/" || return 1
	install -m644 share/nemo/actions/* "$PKG/usr/share/nemo/actions/" || return 1
	install -m644 share/kde4/* "$PKG/usr/share/kde4/apps/solid/actions/" || return 1
	cp -r share/icons/* "$PKG/usr/share/icons/" || return 1
}
