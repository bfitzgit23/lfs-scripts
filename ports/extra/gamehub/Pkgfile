# Depends: graphite2 json-glib keyutils krb5 libgee polkit webkitgtk
description="All your games in one place Steam, GoG, Humble, etc"
homepage="https://tkashkin.tk/projects/gamehub/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gamehub
vrsn=0.16.3-2
version=0.16.3.2
release=1
source=(https://github.com/tkashkin/GameHub/archive/${vrsn}-master/$name-${vrsn}-master.tar.gz)
renames=(gamehub-.tar.gz)

pkg_build() {
	venom-meson $SRC/GameHub-${vrsn}-master build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
