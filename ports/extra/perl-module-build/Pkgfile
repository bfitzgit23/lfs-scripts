maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-module-build
version=0.4234
release=1
source=(https://cpan.metacpan.org/authors/id/L/LE/LEONT/Module-Build-$version.tar.gz)
renames=(perl-module-build-0.4234.tar.gz)

pkg_build() {
	if [ -d Module-Build-$version ]; then
		cd Module-Build-$version
	fi
	perl Build.PL --installdirs=vendor
	./Build
 	./Build install --destdir=$PKG 
}
