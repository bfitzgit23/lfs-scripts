# Depends: libxscrnsaver nss libnotify libappindicator cups
description="Unofficial client of whatsapp"
homepage="https://gitlab.com/zerkc/whatsdesk/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=whatsdesk-bin
version=0.3.12
release=1
source=(https://zerkc.gitlab.io/whatsdesk/whatsdesk_${version}_amd64.deb)
renames=(whatsdesk-bin-0.3.12_amd64.deb)

pkg_build() {
	bsdtar -xvf ${name}-${version}_amd64.deb -C $SRC
	bsdtar -xv -C ${PKG} -f ${SRC}/data.tar.xz
	mkdir -p ${PKG}/usr/bin/
	ln -s /opt/whatsdesk/whatsdesk ${PKG}/usr/bin/whatsdesk
}
