# Depends: jq grim slurp wl-clipboard libnotify imagemagick
description="A utility to easily take screenshots in Hyprland using your mouse"
homepage="https://github.com/Gustash/Hyprshot"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
 

name=hyprshot
version=1.3.0
release=1
source=(https://github.com/Gustash/Hyprshot/archive/$version.tar.gz)
renames=(hyprshot-1.3.0.tar.gz)

pkg_build() {
	if [ -d Hyprshot-$version ]; then
		cd Hyprshot-$version
	fi
	mkdir -p $PKG/usr/bin
	cp hyprshot $PKG/usr/bin/
}
