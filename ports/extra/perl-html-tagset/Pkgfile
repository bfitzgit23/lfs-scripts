# Depends: perl
description="Data tables useful in parsing HTML"
homepage="https://metacpan.org/pod/HTML::Tagset"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-html-tagset
version=3.24
release=1
source=(https://www.cpan.org/authors/id/P/PE/PETDANCE/HTML-Tagset-$version.tar.gz)
renames=(perl-html-tagset-3.24.tar.gz)

pkg_build() {
	cd HTML-Tagset-$version
	perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
}
