# Depends: perl
description="Simple NUMA policy support"
homepage="https://github.com/numactl/numactl"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=numactl
version=2.0.19
release=2
source=(https://github.com/numactl/numactl/archive/refs/tags/v$version.tar.gz)
renames=(numactl-2.0.19.tar.gz)

pkg_build() {
	
	NOCONFIGURE=1 ./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install

	# conflict with man-pages package
	rm -rf $PKG/usr/share/man/man2
}
