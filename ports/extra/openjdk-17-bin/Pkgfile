# Depends: venom-java-manager
description="Temurin 17 (OpenJDK 17 Java binaries by Adoptium, formerly AdoptOpenJDK)"
homepage="https://github.com/adoptium/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=openjdk-17-bin
version=17.0.19+10
vrsn=$(printf "$version" | sed 's/+/_/g')
release=1
source=(https://github.com/adoptium/temurin${version%%.*}-binaries/releases/download/jdk-$version/OpenJDK${version%%.*}U-jdk_x64_linux_hotspot_$vrsn.tar.gz)
renames=(openjdk-17-bin-17.0.19+10.tar.gz)

pkg_build() {
	install -dm 755 "${PKG}/usr/lib/jvm/java-${version%%.*}-openjdk"
	cp --reflink=auto -a "${SRC}/jdk-$version"/* "${PKG}/usr/lib/jvm/java-${version%%.*}-openjdk"

	# Exclude for revdep
	install -d $PKG/etc/revdep.d
	echo "/usr/lib/jvm/java-${version%%.*}-openjdk/" > $PKG/etc/revdep.d/$name.conf
}

