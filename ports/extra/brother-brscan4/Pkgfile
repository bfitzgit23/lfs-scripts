# Depends: avahi sane
description="SANE drivers from Brother for compatible models"
homepage="http://support.brother.com"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=brother-brscan4
version=0.4.11_1
vrsn=$(printf "$version" | sed 's/_/-/g')
release=2
source=(https://download.brother.com/welcome/dlf105203/brscan4-${vrsn}.x86_64.rpm)
renames=(brother-brscan4-0.4.11_1.rpm)

pkg_build() {
	cp -r $SRC/etc $PKG
	cp -r $SRC/opt $PKG
	cp -r $SRC/usr $PKG

	mv $PKG/usr/lib64 $PKG/usr/lib

  	[ -d $PKG ] && cd $PKG; cd usr/lib/sane
  	ln -sf libsane-brother4.so.1.0.7 libsane-brother4.so.1
  	ln -sf libsane-brother4.so.1 libsane-brother4.so
}
