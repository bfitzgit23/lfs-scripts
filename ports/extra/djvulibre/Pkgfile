# Depends: hicolor-icon-theme libtiff
description="Library for reading DjVu files"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
homepage="https://djvu.sourceforge.net"

name=djvulibre
version=3.5.30
release=1
source="https://sourceforge.net/projects/djvu/files/DjVuLibre/$version/$name-$version.tar.gz"

pkg_build() {
	./configure --prefix=/usr \
	        --libdir=/usr/lib \
	        --disable-static \
	        --disable-desktopfiles
	make
	make DESTDIR=$PKG install
}
