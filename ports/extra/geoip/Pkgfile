# Depends: geoip-database
description="Non-DNS IP-to-country resolver C library & utils"
homepage="https://www.maxmind.com/app/c"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=geoip
version=1.6.12
release=1
source=(https://github.com/maxmind/$name-api-c/archive/v$version/$name-$version.tar.gz)
renames=(geoip-1.6.12.tar.gz)

pkg_build() {
	cd $name-api-c-$version

	autoreconf -vi

	./configure             \
	--prefix=/usr           \
	--mandir=/usr/share/man \
	--sysconfdir=/etc/geoip

	make
	make DESTDIR=$PKG install
}
