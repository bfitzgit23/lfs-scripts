# Depends on: glib

name=json-glib
version=1.8.0
release=2
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz json-glib-1.8.0-gir-annotations.patch)

# meson's GIR step runs g-ir-scanner with --warn-error, and the (closure)
# annotations json-glib 1.8.0 puts on plain data parameters are rejected by
# gobject-introspection 1.8x, which aborted the build.  Two independent
# defences, because earlier attempts were silently ignored here:
#  - pkgmk's _patch() applies every *.patch listed in source before the
#    build starts, so the annotation fix needs no hook and no pkg_build();
#  - build_opt switches the GIR off when the driver passes options through.
# With either one the build completes; neither changes the installed API.
build_opt="-Dintrospection=disabled"
