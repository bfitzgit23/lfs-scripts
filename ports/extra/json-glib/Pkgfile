# Depends on: glib

name=json-glib
version=1.8.0
release=2
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

# meson's GIR step runs g-ir-scanner with --warn-error, and the (closure)
# annotations json-glib 1.8.0 puts on plain data parameters are rejected by
# gobject-introspection 1.8x, which aborted the build.  Nothing in this tree
# consumes the Json typelib, so skip introspection rather than carry a patch.
build_opt="-Dintrospection=disabled"
