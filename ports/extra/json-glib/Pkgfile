# Depends on: glib

name=json-glib
version=1.8.0
release=2
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

# meson's GIR step runs g-ir-scanner with --warn-error, and the (closure)
# annotations json-glib 1.8.0 puts on plain data parameters are rejected by
# gobject-introspection 1.8x, which aborted the build.  Nothing in this tree
# consumes the Json typelib, so do not build it.  build_opt covers the
# driver's own meson path; pkg_build covers the path where a Pkgfile
# function drives the build, since build_opt is not passed there.
build_opt="-Dintrospection=disabled"

pkg_build() {
	meson setup _meson_build --prefix=/usr --libdir=/usr/lib --buildtype=plain --wrap-mode=nodownload -Db_lto=true -Db_pie=true -Dintrospection=disabled || return 1
	meson compile -C _meson_build || return 1
	DESTDIR="$PKG" meson install --no-rebuild -C _meson_build
}
