# Depends: perl
description="Charset Information for MIME"
homepage="https://metacpan.org/release/MIME-Charset/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-mime-charset
version=1.013.1
release=1
source=(https://cpan.metacpan.org/authors/id/N/NE/NEZUMI/MIME-Charset-$version.tar.gz)
renames=(perl-mime-charset-1.013.1.tar.gz)

pkg_build() {
	if [ -d MIME-Charset-$version ]; then
		cd MIME-Charset-$version
	fi
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
	find $PKG \( -name perllocal.pod -o -name .packlist \) -delete
}
