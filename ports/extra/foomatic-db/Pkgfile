# Depends: cups perl perl
description="OpenPrinting printer support database "
homepage="http://www.linuxprinting.org/foomatic.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=foomatic-db
version=20260209
release=1
commit=d4774d0c39bcdf970ccb335452f48d9241ec1f71
source=(https://github.com/OpenPrinting/foomatic-db/archive/$commit.tar.gz)
renames=(foomatic-db-20260209-d4774d0c39bcdf970ccb335452f48d9241ec1f71.tar.gz)

pkg_build() {
	if [ -d $name-$commit ]; then cd $name-$commit; fi
	./make_configure
	./configure --prefix=/usr \
		--disable-gzip-ppds \
		--disable-ppds-to-cups \
		--with-drivers=NOOBSOLETES,NOEMPTYCMDLINE
	make DESTDIR=$PKG install
   
	# add some docs
	install -Dm644 USAGE $PKG/usr/share/doc/${name}/USAGE
	install -Dm644 README $PKG/usr/share/doc/${ame}/README
}
