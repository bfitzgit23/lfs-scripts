# Depends: gtkmm3 jsoncpp spdlog pulseaudio libnl libappindicator libmpdclient playerctl gtk-layer-shell
description="Highly customizable Wayland bar for Sway and Wlroots based compositors"
homepage="https://github.com/Alexays/Waybar"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
 

name=waybar
version=0.16.0
release=1
backup=/etc/xdg/waybar/config
backup=/etc/xdg/waybar/style.css
source=(https://github.com/Alexays/Waybar/archive/$version.tar.gz)
renames=(waybar-0.16.0.tar.gz)

pkg_build() {
	venom-meson Waybar-$version build \
		-Dcpp_std=c++20 \
		-Dexperimental=true \
		-Dcava=disabled \
		-Dlogind=disabled \
		-Dman-pages=disabled \
		-Dsystemd=disabled \
		-Dtests=disabled 
          meson compile -C build
          DESTDIR=$PKG meson install --no-rebuild -C build 
}


   
