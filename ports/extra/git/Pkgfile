name=git
version=2.56.1
release=1
source=(https://www.kernel.org/pub/software/scm/$name/$name-$version.tar.xz)

pkg_build() {
	# This tree's pkgutils runs pkg_build (the build() driver in the
	# extension), so a plain build() here would never be called.

	# git ships no configure script; `make configure` generates one with
	# autoconf. Without it, fall back to make variables so the installed
	# tree still lands in /usr/bin and /usr/lib/git-core instead of git's
	# built-in prefix=/usr/local + libexec/git-core defaults.
	if command -v autoconf >/dev/null 2>&1; then
		make configure
	fi

	if [ -x ./configure ]; then
		./configure \
			--prefix=/usr \
			--sysconfdir=/etc \
			--localstatedir=/var \
			--mandir=/usr/share/man \
			--libexecdir=/usr/lib \
			--with-gitconfig=/etc/gitconfig
	else
		build_opt="prefix=/usr sysconfdir=/etc localstatedir=/var
			mandir=/usr/share/man gitexecdir=/usr/lib/git-core
			template_dir=/usr/share/git-core/templates
			localedir=/usr/share/locale"
	fi

	# 2.56 compiles a Rust library in unless NO_RUST is set, so the build
	# stops with "missing cargo" on a system without a Rust toolchain. The
	# Makefile keeps the C implementations when NO_RUST is defined.
	make NO_RUST=1 $build_opt || return $?
	make DESTDIR=$PKG NO_RUST=1 $build_opt install
}
