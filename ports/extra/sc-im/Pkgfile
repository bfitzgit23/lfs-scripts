# Depends: lua libxml2 libzip
description="A spreadsheet program based on SC"
homepage="https://github.com/andmarti1424/sc-im"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sc-im
version=0.8.5
release=1
source=(https://github.com/andmarti1424/sc-im/archive/refs/tags/v$version.tar.gz)
renames=(sc-im-0.8.5.tar.gz)

pkg_build() {
	[ -d $name-$version ] && cd $name-$version; cd src
	sed -i 's|prefix  = /usr/local|prefix  = /usr|g' Makefile
	make
	make PREFIX=$PKG/usr DESTDIR=$PKG install
}
