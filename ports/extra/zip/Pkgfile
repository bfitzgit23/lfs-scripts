# Depends: bzip2

name=zip
version=3.0
release=1
source=(https://downloads.sourceforge.net/sourceforge/infozip/${name}${version//./}.tar.gz)

pkg_build() {
	# unix/configure tests memset() with "int main(){ char k; memset(&k,0,0);
	# return 0; }", including no string.h, so under C23 the implicit declaration
	# fails the probe and the build gets -DZMEM.  zip.h then declares its own
	# "char *memcpy(char *, char *, unsigned)", which conflicts with glibc.
	#
	# Pin C17 in both places it is read: CC, which the probes use, and LOCAL_ZIP,
	# which feeds CFLAGS_NOOPT and ends up in the generated flags file.
	rm -f flags    # stale configure output would carry -DZMEM over

	make -f unix/Makefile LOCAL_ZIP="$CFLAGS -std=gnu17" CC="${CC:-cc} -std=gnu17" prefix=/usr generic || return 1

	make -f unix/Makefile INSTALL=install prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 install || return 1
}
