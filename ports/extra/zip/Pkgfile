# Depends: bzip2

name=zip
version=3.0
release=1
source=(https://downloads.sourceforge.net/sourceforge/infozip/${name}${version//./}.tar.gz
        zip-3.0-no-zmem-fallback.patch
        zip-3.0-zmem-prototypes.patch
        zip-3.0-timezone-include-time.patch)

pkg_build() {
	# zip's ZMEM fallback compiles its own memset/memcpy/memcmp in fileio.c as
	# K&R definitions and declares them with pre-ANSI prototypes in zip.h, both
	# of which a current compiler rejects.  unix/configure selects it whenever
	# its memset probe fails, and that probe includes no <string.h>, so it fails
	# for reasons that have nothing to do with memset.
	#
	# zip-3.0-no-zmem-fallback.patch removes the probe, zip-3.0-zmem-prototypes
	# .patch makes the declarations harmless if ZMEM is defined anyway.  Pinning
	# C17 for the remaining probes (CC) and for the compiled CFLAGS (LOCAL_ZIP,
	# which feeds CFLAGS_NOOPT and the flags file configure writes) keeps the
	# other include-less probes from misfiring too.
	rm -f flags    # stale configure output would carry -DZMEM over

	make -f unix/Makefile LOCAL_ZIP="$CFLAGS -std=gnu17" CC="${CC:-cc} -std=gnu17" prefix=/usr generic || return 1

	make -f unix/Makefile INSTALL=install prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 install || return 1
}
