maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gnumeric
version=1.12.61
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr
	make
	make PREFIX=$PKG/usr DESTDIR=$PKG install
}
