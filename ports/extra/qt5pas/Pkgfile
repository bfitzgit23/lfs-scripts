# Depends: qt5
description="Free Pascal Qt5 binding library updated by lazarus IDE"
homepage="https://gitlab.com/freepascal.org/lazarus"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=qt5pas
version=4.4
release=1
lz_tag=3_8
lz_version=3.8.0
source=(https://gitlab.com/freepascal.org/lazarus/lazarus/-/archive/lazarus_${lz_tag}/lazarus-lazarus_${lz_tag}.tar.bz2)
renames=(lazarus-3.8.0.tar.bz2)

pkg_build() {
    cd lazarus-lazarus_${lz_tag}/lcl/interfaces/qt5/cbindings
    qmake-qt5 
    make 
    make  INSTALL_ROOT=$PKG install
}
