description="A free and open source SVG icon theme for Linux, based on Paper Icon Set and Papirus"
homepage="https://github.com/pop-os/icon-theme"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pop-icon-theme
version=3.5.1
release=1
source=(https://github.com/pop-os/icon-theme/archive/refs/tags/v$version.tar.gz)
renames=(pop-icon-theme-3.5.1.tar.gz)

pkg_build() {

	if [ -d icon-theme-$version ]; then
		cd icon-theme-$version
	fi
	venom-meson build
	meson compile -C build
	DESTDIR=$PKG ninja -C build install
}
