# Depends: appstream-glib uv
description="Cantarell font family"
homepage="https://gitlab.gnome.org/GNOME/cantarell-fonts"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ttf-cantarell
_name=cantarell-fonts
version=0.311
release=1
source=(https://gitlab.gnome.org/GNOME/cantarell-fonts/-/archive/$version/$_name-$version.tar.gz)
renames=(ttf-cantarell-0.311.tar.gz)

pkg_build() {
	if [ -d $_name-$version ]; then
		cd $_name-$version
	fi
	uv sync
	. $SRC/$_name-$version/.venv/bin/activate
	venom-meson build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
