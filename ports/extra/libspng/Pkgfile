# Depends: meson zlib
description="modern alternative to libpng"
homepage="https://github.com/randy408/libspng"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libspng
version=0.7.4
release=1
source=(https://github.com/randy408/libspng/archive/refs/tags/v$version.tar.gz)
renames=(libspng-0.7.4.tar.gz)

pkg_build() {
	venom-meson $SRC/$name-$version build \
	    -D build_examples=false		
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
