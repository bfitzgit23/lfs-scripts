# Depends: perl
description="The World-Wide Web library for Perl"
homepage="https://metacpan.org/release/libwww-perl/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-libwww
version=6.83
release=1
source=(https://cpan.metacpan.org/authors/id/O/OA/OALDERS/libwww-perl-$version.tar.gz)
renames=(perl-libwww-6.83.tar.gz)

pkg_build() {
        if [ -d libwww-perl-$version ]; then
        	cd libwww-perl-$version
        fi
	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
        make DESTDIR=$PKG install

}

