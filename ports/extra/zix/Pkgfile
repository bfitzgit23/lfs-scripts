# Depends: meson ninja
description="A lightweight C library of portability wrappers and data structures"
homepage="https://github.com/drobilla/zix"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=zix
version=0.8.2
release=1
source=(https://github.com/drobilla/zix/archive/refs/tags/v$version.tar.gz)
renames=(zix-0.8.2.tar.gz)

pkg_build() {
	venom-meson $SRC/$name-$version build \
		-Ddocs=disabled \
		-Dhtml=disabled \
		-Dtests=disabled \
		-Dtests_cpp=disabled 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
