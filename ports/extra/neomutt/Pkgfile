# Depends: lua libidn krb5 gpgme
description="A version of mutt with added features"
homepage="https://neomutt.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=neomutt
version=20260616
release=1
source="$name-$version.tar.gz::https://github.com/neomutt/neomutt/archive/refs/tags/$version.tar.gz"

pkg_build() {

	./configure \
	        --prefix=/usr \
	        --sysconfdir=/etc \
	        --libexecdir=/usr/lib \
	        --gpgme \
	        --enable-lua \
	        --gss \
	        --ssl \
	        --with-ui=ncurses \
	        --with-idn=/usr \
        	--gdbm \
		--disable-nls \
		--disable-doc
	make
	make DESTDIR=$PKG install

}
