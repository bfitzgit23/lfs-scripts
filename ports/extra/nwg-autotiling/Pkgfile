# Depends: python3-setuptools python3-wheel python3-i3ipc python3-gpep517 python3-installer
description="Script for sway and i3 to automatically switch the horizontal / vertical window split orientation"
homepage="https://github.com/nwg-piotr/autotiling"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=nwg-autotiling
version=1.9.4
release=1
source=(https://github.com/nwg-piotr/autotiling/archive/v$version.tar.gz)
renames=(nwg-autotiling-1.9.4.tar.gz)

pkg_build() {
	if [ -d autotiling-$version ]; then
		cd autotiling-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
