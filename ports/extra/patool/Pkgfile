# Depends: python3-setuptools python3-gpep517 python3-installer
description="Portable command line archive file manager"
homepage="https://wummel.github.io/patool/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=patool
version=4.1.0
release=1
source="https://github.com/wummel/$name/releases/download/$version/$name-$version.tar.gz"
pkg_build() {
	if [ -d patool-$version ]; then
		cd patool-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl

	chmod -R go-w,a+r,u+w $PKG
}
