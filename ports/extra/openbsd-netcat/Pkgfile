# Depends: libbsd
description="TCP/IP swiss army knife. OpenBSD variant."
homepage="https://salsa.debian.org/debian/netcat-openbsd"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=openbsd-netcat
version=1.234_2
release=1
source_version=$(printf '%s' "$version" | awk '{sub("_", "-"); print}')
source=(https://salsa.debian.org/debian/netcat-openbsd/-/archive/debian/$source_version/netcat-openbsd-debian-$source_version.tar.gz)
renames=(openbsd-netcat-1.234_2.tar.gz)

pkg_build() {
	cd netcat-openbsd-debian-$source_version
	
	while read patch
	do
		patch -Np1 -i debian/patches/$patch
	done < debian/patches/series
	
	make \
		CFLAGS="$CFLAGS -DDEBIAN_VERSION=\"\\\"$source_version\\\"\" -I/usr/include/libbsd" \
		LDFLAGS="$LDFLAGS -lbsd"
	
	install -Dm0755 nc $PKG/usr/bin/nc
	install -Dm0644 nc.1 $PKG/usr/share/man/man1/nc.1
}
