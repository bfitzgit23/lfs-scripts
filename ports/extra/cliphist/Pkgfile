# Depends: go wl-clipboard xdg-utils
description="wayland clipboard manager"
homepage="https://github.com/sentriz/cliphist"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=cliphist
version=0.7.0
release=1
source="https://github.com/sentriz/cliphist/archive/v$version/$name-$version.tar.gz"

pkg_build() {

	export CGO_CPPFLAGS="$CPPFLAGS"
	export CGO_CFLAGS="$CFLAGS"
	export CGO_CXXFLAGS="$CXXFLAGS"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

	go build -ldflags "-linkmode external -extldflags '$LDFLAGS'" -o $name
	install -Dm0755 -t $PKG/usr/bin/ $name
}
