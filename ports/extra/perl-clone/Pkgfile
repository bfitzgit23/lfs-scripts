# Depends: perl
description="Recursively copy Perl datatypes"
homepage="https://github.com/garu/Clone"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-clone
version=0.50
release=1
source=(https://cpan.metacpan.org/authors/id/A/AT/ATOOMIC/Clone-$version.tar.gz)
renames=(perl-clone-0.50.tar.gz)

pkg_build() {
        cd Clone-$version
	PERL_MM_USE_DEFAULT=1	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
        make DESTDIR=$PKG install
	find "$PKG" -name '.packlist' -or -name '*.pod' | xargs rm

}

