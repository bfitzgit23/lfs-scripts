name=x265
version=20230215
release=2
source=(https://anduin.linuxfromscratch.org/BLFS/$name/$name-$version.tar.xz)
# source/CMakeLists.txt still declares cmake_minimum_required(VERSION 2.8.8),
# and CMake 4 refuses anything below 3.5 outright; pin the policy baseline so
# the configure step is accepted without patching the bundled CMake files.
build_opt="-DGIT_ARCHETYPE=1 -DCMAKE_POLICY_VERSION_MINIMUM=3.5"

pre_build() {
 cd source
}
