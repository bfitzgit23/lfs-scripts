name=x265
version=20230215
release=3
source=(https://anduin.linuxfromscratch.org/BLFS/$name/$name-$version.tar.xz
	x265-cmake4.patch)
# source/CMakeLists.txt forces CMP0025 and CMP0054 to OLD, which CMake 4 no
# longer honours (it reports them as unset), and declares
# cmake_minimum_required(2.8.8), which CMake 4 refuses outright; the patch
# drops the overrides and raises both minimums to 3.5.
build_opt="-DGIT_ARCHETYPE=1"

pre_build() {
 cd source
}
