# Depends: python3 python3-gpep517 python3-installer python3-setuptools
description="A utility to accurately report the in core memory usage for a program"
homepage="https://github.com/pixelb/ps_mem"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ps_mem
version=3.14
release=1
source=(https://github.com/pixelb/$name/archive/v$version/$name-v$version.tar.gz)
renames=(ps_mem-3.14.tar.gz)

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
