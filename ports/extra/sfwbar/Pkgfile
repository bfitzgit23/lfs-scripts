# Depends: gtk-layer-shell json-c
description="S* Floating Window Bar"
homepage="https://github.com/LBCrion/sfwbar"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sfwbar
version=1.0_beta17
release=1
source=(https://github.com/LBCrion/sfwbar/archive/refs/tags/v$version.tar.gz)
renames=(sfwbar-1.0_beta17.tar.gz)

pkg_build() {
	export CFLAGS="$CFLAGS -Wno-incompatible-pointer-types"
	export LDFLAGS="-Wl,-O1,--as-needed"

	venom-meson $name-$version build -Db_lto=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm $PKG/usr/share/sfwbar/icons/weather/LICENSE
}
