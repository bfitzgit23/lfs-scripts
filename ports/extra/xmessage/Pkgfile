# Depends: libxaw
description="Display a message or query in a window"
homepage="https://xorg.freedesktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xmessage
version=1.0.7
release=1
source="http://ftp.x.org/pub/individual/app/xmessage-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

