# Depends: glslang pkgconf wlroots
description="Drop-in replacement for the wlroots scene API"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
homepage="https://github.com/wlrfx/scenefx"

name=scenefx
version=0.4.1
release=1
source=(https://github.com/wlrfx/scenefx/archive/refs/tags/${version}.tar.gz)
renames=(scenefx-0.4.1.tar.gz)

pkg_build() {
	venom-meson $name-$version build \
		-Dwerror=false \
		-Db_ndebug=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
