# Depends: gobject-introspection
description="MPRIS command-line controller for music players"
homepage="https://github.com/altdesktop/playerctl"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=playerctl
version=2.4.1
release=2
source=(https://github.com/altdesktop/playerctl/archive/v$version.tar.gz)
renames=(playerctl-2.4.1.tar.gz)

pkg_build() {
	venom-meson $SRC/$name-$version build \
		-Dgtk-doc=false \
                -Dbash-completions=true \
		-Dintrospection=true 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
