description="DSP library derived from Speex"
homepage="https://www.speex.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=speexdsp
version=1.2.1
release=1
source=(https://github.com/xiph/speexdsp/archive/refs/tags/SpeexDSP-1.2.1.tar.gz)
renames=(speexdsp-1.2.1.tar.gz)

pkg_build() {
	if [ -d $name-SpeexDSP-$version ]; then
		if [ -d $name-SpeexDSP-$version ]; then cd $name-SpeexDSP-$version; fi
	fi
	./autogen.sh
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share
}
