# Depends: gtklock
description="gtklock module adding power controls to the lockscreen"
homepage="https://github.com/jovanlanik/gtklock-powerbar-module"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gtklock-powerbar-module
version=4.0.0
release=1
source=(https://github.com/jovanlanik/gtklock-powerbar-module/archive/refs/tags/v$version.tar.gz)
renames=(gtklock-powerbar-module-4.0.0.tar.gz)

pkg_build() {
	venom-meson $name-$version build
	meson compile -C build
        DESTDIR=$PKG meson install --no-rebuild -C build
}
