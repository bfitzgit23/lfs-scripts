# Depends: perl-uri
description="Low-level HTTP connection (client)"
homepage="https://metacpan.org/release/Net-HTTP/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-net-http
version=6.24
release=1
source=(https://cpan.metacpan.org/authors/id/O/OA/OALDERS/Net-HTTP-$version.tar.gz)
renames=(perl-net-http-6.24.tar.gz)

pkg_build() {
	cd Net-HTTP-$version
	PERL_MM_USE_DEFAULT=1 perl -I. Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
	find $PKG \( -name perllocal.pod -o -name .packlist \) -delete
}
