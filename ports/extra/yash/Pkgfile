# Depends: ncurses
description="Yet Another SHell is a POSIX-compliant command line shell"
homepage="https://github.com/magicant/yash"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=yash
version=2.61
release=1
source=(https://github.com/magicant/${name}/archive/${version}.tar.gz)
renames=(yash-2.61.tar.gz)

pkg_build() {

	export XML_CATALOG_FILES=/etc/xml/catalog
	./configure \
		--prefix=/usr \
		--disable-nls 
	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/share/man/ja
}
