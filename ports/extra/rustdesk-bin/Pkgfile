# Depends: alsa-lib curl gst-plugins-base gtk3 libayatana-appindicator libva libxcb libxfixes xdotool
# description	: Remote desktop software (prebuilt binary)
# homepage	: https://github.com/rustdesk/rustdesk
# maintainer	: Venom Linux Team, venomlinux at disroot dot org

description="Remote desktop software (prebuilt binary)"
name=rustdesk-bin
version=1.5.3
release=1
build_work=disk
# The release binaries are already stripped and libapp.so is a Dart AOT
# snapshot, so keep the whole rustdesk tree out of the stripping pass.
nostrip="usr/share/rustdesk"
source="https://github.com/rustdesk/rustdesk/releases/download/$version/rustdesk-$version-0-x86_64.pkg.tar.zst"

pkg_build() {
	local _usr

	# pkgmk unpacks the release package; the Arch build keeps a plain usr tree
	# either at the top of $SRC or inside a single directory.
	_usr=$(find . -mindepth 1 -maxdepth 2 -type d -name usr -print -quit)
	[ -n "$_usr" ] || {
		echo "rustdesk-bin: staged usr tree is missing" >&2
		return 1
	}
	[ -x "$_usr/share/rustdesk/rustdesk" ] || {
		echo "rustdesk-bin: staged rustdesk executable is missing" >&2
		return 1
	}

	install -d "$PKG" || return 1
	cp -a "$_usr" "$PKG/usr" || return 1

	# The release keeps the launcher in /usr/share/rustdesk, while the desktop
	# entry and the service both call /usr/bin/rustdesk.
	install -d "$PKG/usr/bin" || return 1
	rm -f "$PKG/usr/bin/rustdesk"
	ln -s /usr/share/rustdesk/rustdesk "$PKG/usr/bin/rustdesk" || return 1

	# Some release packages keep the desktop entries under rustdesk/files.
	if [ ! -e "$PKG/usr/share/applications/rustdesk.desktop" ] &&
	   [ -e "$PKG/usr/share/rustdesk/files/rustdesk.desktop" ]; then
		install -Dm644 "$PKG/usr/share/rustdesk/files/rustdesk.desktop" \
			"$PKG/usr/share/applications/rustdesk.desktop" || return 1
	fi

	# Upstream only ships a systemd unit; BFSOS runs sysvinit.
	if scratch isinstalled sysvinit; then
		install -Dm755 "$SRC/rc.rustdesk" "$PKG/etc/rc.d/rustdesk" || return 1
	fi
}
