name=liba52
version=0.7.4
release=1
# liba52.sourceforge.io is gone; Debian's orig tarball is the same 0.7.4 tree.
source=(http://deb.debian.org/debian/pool/main/a/a52dec/a52dec_0.7.4.orig.tar.gz)
build_opt="--enable-shared"

pre_build() {
	export CFLAGS="$CFLAGS -fPIC"
}

pkg_build() {
	./configure --prefix=/usr $build_opt
	make
	make DESTDIR=$PKG install
}

post_build() {
	cp liba52/a52_internal.h $PKG/usr/include/a52dec
}
