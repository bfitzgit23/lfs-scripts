# Depends: yelp-xsl python3-lxml
description="Collection of tools for building and converting documentation"
homepage="https://gitlab.gnome.org/GNOME/yelp-tools"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=yelp-tools
version=42.1
release=1
source="http://ftp.gnome.org/pub/gnome/sources/yelp-tools/${version%.*}/yelp-tools-$version.tar.xz"

pkg_build() {
  venom-meson build -D help=true
  meson compile -C build
  meson test -C build --print-errorlogs
  meson install --no-rebuild -C build --destdir $PKG
}
