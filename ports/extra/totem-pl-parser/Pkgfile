# Depends: libxml2 libarchive libgcrypt gobject-introspection meson
description="Simple GObject-based library to parse and save a host of playlist formats"
homepage="https://gitlab.gnome.org/GNOME/totem-pl-parser"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=totem-pl-parser
version=3.26.7
vrsn=$(printf "$version" | sed 's/\./_/g')
release=6
source=(https://gitlab.gnome.org/GNOME/totem-pl-parser/-/archive/$version/$name-$version.tar.gz)
renames=(totem-pl-parser-3.26.7.tar.bz2)

pkg_build() {
	venom-meson $SRC/$name-$version build -D enable-gtk-doc=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
