# Depends: gtk3
description="Simple and lightweight GTK calendar"
homepage="https://dmedvinsky.github.io/gsimplecal/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gsimplecal
version=2.5.2
release=1
source=(https://github.com/dmedvinsky/$name/archive/v$version.tar.gz)
renames=(gsimplecal-2.5.2.tar.gz)

pkg_build() {
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
