# Depends on: libxslt docbook-xsl elinks

name=xmlto
version=0.0.29
release=3
# pagure.io was retired in 2026 and serves no release tarballs any more; the
# Debian orig tarball is the upstream one, unchanged.
source=(https://deb.debian.org/debian/pool/main/x/xmlto/${name}_$version.orig.tar.bz2)

pkg_build() {
	# The orig tarball ships configure.ac only (no generated configure), and
	# 0.0.29 is the release whose flex-generated xmlif was regenerated so it
	# still compiles with current gcc.
	autoreconf -fi || return 1

	./configure --prefix=/usr --sysconfdir=/etc --mandir=/usr/share/man || return 1

	# 0.0.28 shipped pre-rendered man pages; 0.0.29 does not, so "make
	# install" renders man/man1/{xmlto,xmlif}.1 by running the xmlto it has
	# just configured, and that runs xsltproc with --nonet.  Two http URLs
	# therefore have to resolve locally:
	#   - the stylesheet in format/docbook/man,
	#     http://docbook.sourceforge.net/release/xsl/current/manpages/docbook.xsl
	#   - the DocBook DTD in the DOCTYPE of doc/*.xml,
	#     http://www.oasis-open.org/docbook/xml/4.2/docbookx.dtd
	# Neither resolves through /etc/xml/catalog unless docbook-xml set it up
	# and its delegate entries match, which is where "failed to load external
	# entity .../docbook.xsl" comes from.  Write a catalogue into the build
	# directory that points those prefixes straight at the installed files, so
	# the render only depends on docbook-xsl and docbook-xml being installed.
	_bfs_xsl_dir=
	for _bfs_dir in /usr/share/xml/docbook/xsl-stylesheets-[0-9]*; do
		[ -f "$_bfs_dir/manpages/docbook.xsl" ] && _bfs_xsl_dir=$_bfs_dir
	done
	_bfs_dtd_dir=/usr/share/xml/docbook/xml-dtd-4.2

	_bfs_manopts=
	if [ -n "$_bfs_xsl_dir" ] && [ -f "$_bfs_dtd_dir/docbookx.dtd" ]; then
		_bfs_catalog=$PWD/.xmlto-catalog
		xmlcatalog --noout --create "$_bfs_catalog" || return 1
		xmlcatalog --noout --add rewriteURI \
			"http://docbook.sourceforge.net/release/xsl/current" \
			"$_bfs_xsl_dir" "$_bfs_catalog" || return 1
		xmlcatalog --noout --add rewriteURI \
			"http://docbook.sourceforge.net/release/xsl/${_bfs_xsl_dir##*-}" \
			"$_bfs_xsl_dir" "$_bfs_catalog" || return 1
		xmlcatalog --noout --add rewriteURI \
			"http://www.oasis-open.org/docbook/xml/4.2" \
			"$_bfs_dtd_dir" "$_bfs_catalog" || return 1
		_bfs_catalogs=$_bfs_catalog
		for _bfs_extra in /etc/xml/docbook-xsl /etc/xml/docbook-xml /etc/xml/catalog; do
			[ -f "$_bfs_extra" ] && _bfs_catalogs="$_bfs_catalogs $_bfs_extra"
		done
		export XML_CATALOG_FILES=$_bfs_catalogs
	else
		# Without docbook-xsl and docbook-xml the pages cannot be rendered
		# offline, so install xmlto without them rather than failing.
		echo "xmlto: docbook-xsl/docbook-xml not installed, skipping man pages" >&2
		_bfs_manopts="dist_man1_MANS= man1_MANS="
	fi

	make $_bfs_manopts || return 1
	make DESTDIR=$PKG install $_bfs_manopts || return 1
}
