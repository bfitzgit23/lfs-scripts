# Depends: gnome-themes-extra murrine sassc
description="A GTK theme based on the Catppuccin colour palette"
homepage="https://github.com/Fausto-Korpsvart/Catppuccin-GTK-Theme"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=catppuccin-gtk-icon-theme
rname=Catppuccin-GTK-Theme
version=250821
commit=98c2f63f7c9e55da69575378094f2987eb6b0b20
release=1
source=(https://github.com/Fausto-Korpsvart/Catppuccin-GTK-Theme/archive/$commit.tar.gz)
renames=(catppuccin-gtk-icon-theme-250821.tar.gz)

pkg_build() {
	[ -d $rname-$commit ] && cd $rname-$commit; cd icons
	install -dm 755 $PKG/usr/share/icons
	cp -r * $PKG/usr/share/icons/
}
