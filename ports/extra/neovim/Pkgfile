# Depends: pynvim unzip
description="neovim  "
homepage="https://github.com/neovim/neovim"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=neovim
version=0.12.3
release=1
source=(https://github.com/$name/$name/archive/refs/tags/v$version.tar.gz)
renames=(neovim-0.12.3.tar.gz)

pkg_build() {
	make CMAKE_INSTALL_PREFIX=/usr USE_BUNDLED=1 CMAKE_BUILD_TYPE=Release
	make DESTDIR=$PKG install

	rm -f $PKG/usr/share/nvim/runtime/ftplugin/systemd.vim \
	      $PKG/usr/share/nvim/runtime/syntax/systemd.vim
}
