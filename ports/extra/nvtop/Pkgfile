# Depends: cmake libdrm ninja
description="GPUs process monitoring for AMD, Intel and NVIDIA"
homepage="https://github.com/Syllo/nvtop"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=nvtop
version=3.3.2
release=1
source="https://github.com/Syllo/nvtop/archive/$version/nvtop-$version.tar.gz"
pkg_build() {
	CFLAGS="$CFLAGS -flto=auto -DNDEBUG" \
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=None \
		-DAMDGPU_SUPPORT=ON \
		-DINTEL_SUPPORT=ON \
		-DMSM_SUPPORT=OFF \
		-DNVIDIA_SUPPORT=ON \
		-Wno-dev
	cmake --build build
        DESTDIR=$PKG cmake --install build
}
