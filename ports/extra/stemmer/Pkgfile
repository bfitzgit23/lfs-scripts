description="Stemming library supporting several languages"
homepage="https://snowballstem.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=stemmer
version=3.1.1
release=1
source="https://snowballstem.org/dist/libstemmer_c-$version.tar.gz"

pkg_build() {
	# build() has already entered the extracted libstemmer_c tree
	make CFLAGS="$CFLAGS -fPIC" || return 1

	install -d $PKG/usr/lib $PKG/usr/include || return 1
	${CC:-gcc} -shared -Wl,-soname,libstemmer.so.0 -Wl,--whole-archive libstemmer.a -Wl,--no-whole-archive -o $PKG/usr/lib/libstemmer.so.0.0.0 || return 1
	ln -s libstemmer.so.0.0.0 $PKG/usr/lib/libstemmer.so.0
	ln -s libstemmer.so.0 $PKG/usr/lib/libstemmer.so
	install -Dm644 include/libstemmer.h $PKG/usr/include/libstemmer.h
}
