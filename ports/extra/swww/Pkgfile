# Depends: rust lz4 wayland-protocols wlroots
description="Efficient animated wallpaper daemon for wayland, controlled at runtime"
homepage="https://github.com/LGFae/swww"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=swww
version=0.11.2
release=1
source="$name-$version.tar.gz::https://github.com/LGFae/$name/archive/refs/tags/v$version.tar.gz"

pkg_build() {
	export CARGO_HOME="$SOURCE_DIR/cargo"
	cargo fetch --locked
  cargo build --release
  install -Dt $PKG/usr/bin target/release/$name
  
  #Copy daemon too
  install -Dt $PKG/usr/bin target/release/$name-daemon
}
