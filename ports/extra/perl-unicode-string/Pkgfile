# Depends: perl
description="String of Unicode characters for perl (UCS2/UTF16)"
homepage="https://metacpan.org/release/Unicode-String"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-unicode-string
version=2.10
release=1
source=(https://cpan.metacpan.org/authors/id/G/GA/GAAS/GAAS/Unicode-String-$version.tar.gz)
renames=(perl-unicode-string-2.10.tar.gz)

pkg_build() {
	if [ -d Unicode-String-$version ]; then
		cd Unicode-String-$version
	fi
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
	find $PKG \( -name perllocal.pod -o -name .packlist \) -delete
}
