# Depends: ffmpeg faad2 libmad libmpcdec flac
description="Feature-rich ncurses-based music player"
homepage="https://cmus.github.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=cmus
version=2.13.0
release=1
source="https://github.com/cmus/cmus/archive/v$version/$name-$version.tar.gz"

pkg_build() {

	./configure prefix=/usr
	make
	make DESTDIR=$PKG install
}
