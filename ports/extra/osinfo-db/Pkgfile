# Depends: osinfo-db-tools
description="The osinfo database"
homepage="https://libosinfo.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=osinfo-db
version=20260812
release=1
# releases.pagure.org stopped serving libosinfo files; the release tarballs now
# hang off the GitLab release of the same date.
source="https://gitlab.com/libosinfo/$name/-/releases/v$version/downloads/$name-$version.tar.xz"
noextract="$name-$version.tar.xz"

pkg_build() {
	osinfo-db-import --root $PKG --system $name-$version.tar.xz
}
