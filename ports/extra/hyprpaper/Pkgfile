# Depends: libglvnd libjpeg-turbo pango wayland-protocols hyprlang
description="A blazing fast wayland wallpaper utility with IPC controls"
homepage="https://github.com/hyprwm/hyprpaper hyprgraphics"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
 

name=hyprpaper
version=0.8.5
release=1
source=(https://github.com/hyprwm/hyprpaper/archive/v$version.tar.gz)
renames=(hyprpaper-0.8.5.tar.gz)

pkg_build() {
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev
	make protocols
	make -C build all
	install -Dm0755 -t $PKG/usr/bin/ build/$name
}
