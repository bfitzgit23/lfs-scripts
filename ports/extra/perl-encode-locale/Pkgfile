# Depends: perl
description="Determine the locale encoding"
homepage="https://search.cpan.org/dist/Encode-Locale"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-encode-locale
version=1.05
release=1
source=(https://cpan.metacpan.org/authors/id/G/GA/GAAS/Encode-Locale-$version.tar.gz)
renames=(perl-encode-locale-1.05.tar.gz)

pkg_build() {
        if [ -d Encode-Locale-$version ]; then
        	cd Encode-Locale-$version
        fi
	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
        make DESTDIR=$PKG install
}

