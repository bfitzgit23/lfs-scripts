# Depends: libqalculate gtk3 python3
description="GTK frontend for libqalculate"
homepage="https://qalculate.github.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=qalculate-gtk
version=5.11.0
release=1
source=(https://github.com/Qalculate/qalculate-gtk/archive/refs/tags/v$version.tar.gz)
renames=(qalculate-gtk-5.11.0.tar.gz)

pkg_build() {
	autoreconf -fvi
	./configure --prefix=/usr --libexecdir=/usr/lib
	make
	make DESTDIR=$PKG install
}
