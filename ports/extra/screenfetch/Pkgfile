description="CLI Bash script to show system/theme info in screenshots"
homepage="https://github.com/KittyKatt/screenFetch"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=screenfetch
version=3.9.9
release=1
source=(https://github.com/KittyKatt/screenFetch/archive/v$version.tar.gz)
renames=(screenfetch-3.9.9.tar.gz)

pkg_build() {
	if [ -d screenFetch-$version ]; then
		cd screenFetch-$version
	fi

	install -Dm755 $name-dev $PKG/usr/bin/$name
	install -Dm644 $name.1   $PKG/usr/share/man/man1/$name.1 
}
