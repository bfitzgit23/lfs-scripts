# Depends: e2fsprogs
description="Checks and undeletes partitions + PhotoRec, signature based recovery tool"
homepage="https://www.cgsecurity.org/index.html?testdisk.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=testdisk
version=7.2
release=1
source="https://www.cgsecurity.org/$name-$version.tar.bz2"

pkg_build() {

	./configure \
		--prefix=/usr \
		--without-ewf \
		--enable-sudo
	make
	make DESTDIR=$PKG install

}
