description="Font from the Ionic mobile framework "
homepage="https://github.com/ionic-team/ionicons"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ttf-ionicons
version=7.1.2
release=1
source=(https://github.com/ionic-team/ionicons/archive/v$version.tar.gz)
renames=(ttf-ionicons-7.1.2.tar.gz)

pkg_build() {
	if [ -d ionicons-$version ]; then
		cd ionicons-$version
	fi
	install -Dm644 docs/fonts/ionicons.ttf -t "$PKG/usr/share/fonts/TTF/"
}
