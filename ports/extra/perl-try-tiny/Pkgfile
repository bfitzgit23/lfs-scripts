# Depends: perl
description="Minimal try/catch with proper localization of $@"
homepage="https://search.cpan.org/dist/Try-Tiny"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-try-tiny
version=0.32
release=1
source=(https://cpan.metacpan.org/authors/id/E/ET/ETHER/Try-Tiny-$version.tar.gz)
renames=(perl-try-tiny-0.32.tar.gz)

pkg_build() {
        if [ -d Try-Tiny-$version ]; then
        	cd Try-Tiny-$version
        fi
	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
        make DESTDIR=$PKG install

}

