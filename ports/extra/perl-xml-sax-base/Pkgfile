# Depends: perl
description="Base class SAX Drivers and Filters"
homepage="https://search.cpan.org/dist/XML-SAX-Base"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-xml-sax-base
version=1.09
release=2
source=(http://search.cpan.org/CPAN/authors/id/G/GR/GRANTM/XML-SAX-Base-$version.tar.gz)
renames=(perl-xml-sax-base-1.09.tar.gz)

pkg_build() {
	if [ -d XML-SAX-Base-$version ]; then
		cd XML-SAX-Base-$version
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make install DESTDIR=$PKG

	find $PKG -name '.packlist' -delete
	find $PKG -name '*.pod' -delete
}
