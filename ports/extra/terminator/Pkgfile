# Depends: vte3 python3-psutil gsettings-desktop-schemas keybinder3 python3-configobj python3-gpep517 python3-installer python3-setuptools
description="Terminal emulator that supports tabs and grids"
homepage="https://github.com/gnome-terminator/terminator"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=terminator
version=2.1.6
release=1
source="https://github.com/gnome-terminator/terminator/releases/download/v$version/$name-$version.tar.gz"

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
	rm -rf $PKG/usr/share/icons/hicolor/icon-theme.cache

}
