description="Fresh and simple personality icon theme"
homepage="https://github.com/vinceliuice/vimix-icon-theme"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=vimix-icon-theme
_version=2025-02-10
version=2025.08.26
release=2
source="https://github.com/vinceliuice/$name/archive/$_version/$name-$version.tar.gz"

pkg_build() {
	cd Vimix-icon-theme-$_version
	sed '/gtk-update-icon-cache/d' -i install.sh
	install -dm755 "$PKG/usr/share/icons"
	./install.sh -a -d "$PKG/usr/share/icons"

	rm -f $PKG/usr/share/icons/Vimi*/symbolic/mimetypes/text-x-systemd-unit-symbolic.svg
}
