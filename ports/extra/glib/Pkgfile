# Depends on: pcre2 libxslt

# glib writes GLib-2.0.gir and GObject-2.0.gir only when g-ir-scanner is
# already installed, and gobject-introspection itself needs glib first.  A
# clean bootstrap is therefore two passes: glib, then
# gobject-introspection, then rebuild glib so the GIRs appear - packages that
# scan against GLib (json-glib and friends) fail without them.

name=glib
version=2.90.1
release=1
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz
	0001-glib-compile-schemas-Remove-noisy-deprecation-warnin.patch)
# glib 2.90 writes its man pages with rst2man: keep that optional so a build box
# without python3-docutils still configures. gtk_doc is now called documentation.
build_opt="
	-Dman-pages=auto
	-Ddocumentation=false
	-Dselinux=disabled
	-Dtests=false
"
