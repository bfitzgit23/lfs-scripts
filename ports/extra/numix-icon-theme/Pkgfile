# Depends: gtk3
description="Base icon theme from the Numix project"
homepage="https://github.com/numixproject"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=numix-icon-theme
version=25.12.15
release=2
source=(https://github.com/numixproject/numix-icon-theme/archive/$version.tar.gz)
renames=(numix-icon-theme-25.12.15.tar.gz)

pkg_build() {
	install -dm 755 $PKG/usr/share/icons
	cp -dr --no-preserve='ownership' Numix Numix-Light $PKG/usr/share/icons/
	
	rm -f $PKG/usr/share/icons/Numix/*/mimetypes/text-x-systemd-unit.svg
}

