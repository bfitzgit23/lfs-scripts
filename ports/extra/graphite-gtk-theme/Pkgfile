# Depends: gnome-themes-extra gtk-engine-murrine sassc
description="Graphite gtk theme"
homepage="https://github.com/vinceliuice/Graphite-gtk-theme"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=graphite-gtk-theme
rname=Graphite-gtk-theme
version=2025.07.06
vrsn=$(printf "$version" | sed 's/\./-/g')
release=1
source=(https://github.com/vinceliuice/Graphite-gtk-theme/archive/refs/tags/$vrsn.tar.gz
	Graphite-backgrounds.xml)
renames=(graphite-gtk-theme-2025.07.06.tar.gz SKIP)

pkg_build() {
	cd Graphite-gtk-theme-${vrsn}

	    # wallpapers
	wdir="$PKG/usr/share/backgrounds/Graphite"
	wpdir="$PKG/usr/share/gnome-background-properties/"
	mkdir -p $wdir $wpdir
	cp $SRC/Graphite-backgrounds.xml $wpdir
	cp wallpaper/wallpapers*/* $wdir
	
	install -dm 755 $PKG/usr/share/icons
	./install.sh -t all -s compact -d $PKG/usr/share/icons  --tweaks nord
	./install.sh -t all -s compact -d $PKG/usr/share/icons  --tweaks normal
}
