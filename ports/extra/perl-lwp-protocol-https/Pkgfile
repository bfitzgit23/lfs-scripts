# Depends: perl-libwww perl-io-socket-ssl perl-net-http
description="Provide https support for LWP::UserAgent"
homepage="https://metacpan.org/release/LWP-Protocol-https"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-lwp-protocol-https
version=6.17
release=1
source=(https://cpan.metacpan.org/authors/id/O/OA/OALDERS/LWP-Protocol-https-$version.tar.gz)
renames=(perl-lwp-protocol-https-6.17.tar.gz)

pkg_build() {
	if [ -d LWP-Protocol-https-$version ]; then
		cd LWP-Protocol-https-$version
	fi
        perl -I. Makefile.PL INSTALLDIRS=vendor
	make
        make DESTDIR=$PKG install
}

