# Depends: swig
description="Library implementing a curses-based widget set for text terminals"
homepage="http://clifford.at/stfl/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=stfl
version=0.22
release=1
# clifford.at no longer serves the tarballs and the gentoo mirror dropped them;
# Debian's orig tarball is the last packaged upstream release.
source="http://deb.debian.org/debian/pool/main/s/stfl/stfl_0.22.orig.tar.gz"

pkg_build() {
	if [ -d $name-$version ]; then
		if [ -d $name-$version ]; then cd $name-$version; fi
	fi

	sed -i 's|ncursesw/||' stfl_internals.h
	make prefix=/usr FOUND_SWIG=0 DESTDIR=$PKG install

	find $PKG -name perllocal.pod -delete
}
