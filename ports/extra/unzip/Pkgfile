name=unzip
version=60
release=1
source=(https://downloads.sourceforge.net/infozip/${name}${version}.tar.gz
	unzip-6.0-consolidated_fixes-1.patch
	unzip-6.0-localtime-proto.patch
	unzip-6.0-no-dir-fallback.patch)

pkg_build() {
	# unzip declares its API with the __G macro, which globals.h expands to
	# nothing unless REENTRANT is defined, so "int CloseError(__G)" becomes
	# "int CloseError()" and every call with arguments is rejected under C23.
	# Build as C17, where empty parentheses still mean unspecified arguments.
	sed -i 's|^CFLAGS = -O[[:space:]]*$|CFLAGS = -O -std=gnu17|' unix/Makefile || return 1
	sed -i 's|^CF_NOOPT = -I\.|CF_NOOPT = -std=gnu17 -I.|' unix/Makefile || return 1

	# unix/configure probes opendir() with "return closedir(opendir(\".\"));" and no
	# dirent.h include, which C23 rejects, so the probe can end up defining
	# -DNO_DIR.  The no-dir-fallback patch makes that harmless on Linux.
	rm -f flags    # stale configure output would carry -DNO_DIR over

	make -f unix/Makefile generic CC="${CC:-cc} -std=gnu17" || return 1

	make prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 -f unix/Makefile install || return 1
}
