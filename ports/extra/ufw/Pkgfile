# Depends: iptables python3-setuptools
description="Uncomplicated and easy to use CLI tool for managing a netfilter firewall"
homepage="https://launchpad.net/ufw"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ufw
version=0.36.2
release=1
backup="etc/ufw/before.rules
        etc/ufw/before6.rules
        etc/ufw/after.rules
        etc/ufw/after6.rules
        etc/ufw/ufw.conf
        etc/ufw/user.rules
        etc/ufw/sysctl.conf
        etc/ufw/user6.rules
        etc/default/ufw"
source="https://launchpad.net/$name/0.36/$version/+download/$name-$version.tar.gz"

pkg_build() {
	python3 ./setup.py build
	python3 ./setup.py install --root=$PKG

	# rc service
	scratch isinstalled sysvinit && {
        	mkdir -p $PKG/etc/rc.d 
        	install -Dm755 /lib/ufw/ufw-init $PKG/etc/rc.d/ufw 
	} || continue
}
