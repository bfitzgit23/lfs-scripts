# Depends: meson pango gdk-pixbuf startup-notification libxkbcommon xcb-util-wm xcb-util-cursor
description="A window switcher, Application launcher and dmenu replacement"
homepage="https://github.com/davatorium/rofi"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=rofi
version=2.1.1
release=1
source="https://github.com/davatorium/$name/releases/download/$version/$name-$version.tar.xz"

pkg_build() {

	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
