# Depends: mangohud lazarus ttf-ubuntu-font-family vkbasalt pascube
description="A GUI to help manage Vulkan/OpenGL overlays"
homepage="https://github.com/benjamimgois/goverlay"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=goverlay
version=1.8.4
release=1
source=(https://github.com/benjamimgois/goverlay/archive/$version.tar.gz)
renames=(goverlay-1.8.4.tar.gz)

pkg_build() {
        make LAZBUILDOPTS=--lazarusdir=/usr/lib/lazarus
        make prefix=/usr libexecdir=/lib DESTDIR=$PKG install
}
