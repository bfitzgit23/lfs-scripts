# Depends: clang rust pipewire
description="A simple TUI audio mixer for PipeWire"
homepage="https://github.com/tsowell/wiremix"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=wiremix
version=0.11.0
release=1
source=(https://github.com/tsowell/wiremix/archive/v$version.tar.gz)
renames=(wiremix-0.11.0.tar.gz)

pkg_build() {
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
	cargo build --release --frozen
	install -Dm 755 "target/release/$name" "$PKG/usr/bin/$name"
}
