# Depends: perl
description="Perl extension for the GNU Readline/History Library"
homepage="https://metacpan.org/release/Term-ReadLine-Gnu/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-term-readline-gnu
version=1.47
release=1
source=(https://cpan.metacpan.org/authors/id/H/HA/HAYASHI/Term-ReadLine-Gnu-$version.tar.gz)
renames=(perl-term-readline-gnu-1.47.tar.gz)

pkg_build() {
	if [ -d Term-ReadLine-Gnu-$version ]; then
		cd Term-ReadLine-Gnu-$version
	fi
	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
	make DESTDIR=$PKG install
}
