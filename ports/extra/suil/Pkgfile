# Depends: sratom python3-babel python3-sphinxygen
description="suil library for loading and wrapping lv2 plugins UIs "
homepage="https://drobilla.net/software/suil.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=suil
version=0.10.26
release=1
source="https://download.drobilla.net/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
