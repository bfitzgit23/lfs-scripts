# Depends: tbb
description="A Modern Linker"
homepage="https://github.com/rui314/mold"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mold
version=2.41.0
release=1
source=(https://github.com/rui314/mold/archive/v$version.tar.gz)
renames=(mold-2.41.0.tar.gz)

pkg_build() {
	cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=/usr/lib \
	        -DCMAKE_INSTALL_LIBEXECDIR=/usr/lib \
		-DMOLD_USE_SYSTEM_MIMALLOC=OFF \
		-DMOLD_USE_SYSTEM_TBB=ON \
		-DMOLD_LTO=ON \
		-DMOLD_USE_MOLD=$(scratch isinstalled mold && printf "ON" || printf "OFF")
	cmake --build build
	DESTDIR=$PKG cmake --install build
}

