# Depends: which rust clang lld
description="Mozilla's JavaScript and WebAssembly Engine, written in C++ and Rust "
homepage="https://spidermonkey.dev/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=js140
version=140.2.0
release=1
source=(https://archive.mozilla.org/pub/firefox/releases/${version}esr/source/firefox-${version}esr.source.tar.xz)
renames=(js140-140.2.0.tar.xz)

pkg_build() {
	cd firefox-$version

	# fix build with ICU 76	
	sed -i 's/icu-i18n/icu-uc &/' js/moz.configure

	mkdir obj
	cd obj
	
	export SHELL=/bin/sh

	sh ../js/src/configure \
			 --prefix=/usr \
                         --with-intl-api \
                         --with-system-zlib \
                         --with-system-icu \
                         --disable-jemalloc \
                         --disable-debug-symbols \
                         --enable-readline        
	make
	make DESTDIR=$PKG install

	rm -v $PKG/usr/lib/libjs_static.ajs 
	sed -i '/@NSPR_CFLAGS@/d' $PKG/usr/bin/$name-config
}
