# Depends: perl openssl zlib
description="Perl extension for using OpenSSL"
homepage="https://metacpan.org/release/Net-SSLeay"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-net-ssleay
version=1.96
release=1
source=(https://cpan.metacpan.org/authors/id/C/CH/CHRISN/Net-SSLeay-$version.tar.gz)
renames=(perl-net-ssleay-1.96.tar.gz)

pkg_build() {
	if [ -d Net-SSLeay-$version ]; then
		cd Net-SSLeay-$version
	fi
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install

	# creates file collision among perl modules
	find $PKG -name perllocal.pod -delete
}
