# Depends: openssl
description="A library that simplifies the interaction with PKCS11 providers for end-user applications using a simple API and optional OpenSSL engine"
homepage="https://github.com/OpenSC/pkcs11-helper"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pkcs11-helper
version=1.31.0
release=1
source="https://github.com/OpenSC/pkcs11-helper/archive/pkcs11-helper-${version}.tar.gz"

pkg_build() {
	if [ -d ${name}-${name}-${version} ]; then
		if [ -d ${name}-${name}-${version} ]; then cd ${name}-${name}-${version}; fi
	fi
	libtoolize
	aclocal
	autoheader
	automake --add-missing
	autoreconf -v
	./configure --prefix=/usr
	make
	make DESTDIR=${PKG} install

}
