# Depends: libxml2 qt6-tools
description="A Wayland window-stacking compositor"
homepage="https://github.com/labwc/labwc-tweaks"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=labwc-tweaks
version=0.2.0
release=1
source="https://github.com/labwc/$name/archive/$version/$name-$version.tar.gz"

pkg_build() {
	cmake -S $name-$version -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=None \
		-D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}	
