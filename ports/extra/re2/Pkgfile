# Depends: abseil-cpp
description="Fast, safe, thread-friendly regular expression engine"
homepage="https://github.com/google/re2"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=re2
version=2025.11.05
_version=$(printf '%s' "$version" | sed 's/\./-/g')
release=2
source="https://github.com/google/re2/archive/$_version/$name-$_version.tar.gz"

pkg_build() {
	if [ -d $name-$_version ]; then cd $name-$_version; fi
	make
	make prefix=/usr DESTDIR=$PKG install
}
