# Depends: colord hicolor-icon-theme libhandy sane yelp-tools
description="Simple Scanning Utility (GTK3 version)"
homepage="https://github.com/GNOME/simple-scan"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=simple-scan-gtk3
version=44.0
release=1
source="http://packages.linuxmint.com/pool/upstream/s/${name%-*}/${name%-*}_${version}-${release}+wilma.tar.xz"

pkg_build() {
	venom-meson $SRC/${name%-*} build 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build 
}
