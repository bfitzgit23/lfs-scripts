# Depends: boost cmark flac libmatroska pcre2 libvorbis qt6-multimedia ruby
description="Tools to create, alter and inspect Matroska files."
homepage="https://mkvtoolnix.download/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mkvtoolnix
version=103.0
release=1
source="https://mkvtoolnix.download/sources/$name-$version.tar.xz"

pkg_build() {

	./configure  \
		--prefix=/usr \
		--disable-precompiled-headers \
		--disable-update-check \
		--enable-gui

	rake --multitask --jobs=${MAKEFLAGS}
	rake DESTDIR=$PKG install

	rm -r $PKG/usr/share/locale
	rm -rf $PKG/usr/share/doc
}
