# Depends: coreutils gawk grep pciutils procps-ng sed
description="Script to get system information"
homepage="https://smxi.org/docs/inxi.htm"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=inxi
version=3.3.40.1
_ver=${version%.*}
_sion=${version##*.}
release=1
source=(https://codeberg.org/smxi/inxi/archive/${_ver}-${_sion}.tar.gz)
renames=(inxi-3.3.40.1.tar.gz)

pkg_build() {
	cd $name
	install -D -m755 inxi $PKG/usr/bin/inxi
	install -D -m755 inxi.1 $PKG/usr/share/man/man1/inxi.1
}
