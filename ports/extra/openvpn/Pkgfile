# Depends: lzo iproute2 pkcs11-helper linux-pam python3-docutils libcap-ng
description="An easy-to-use, robust and highly configurable VPN (Virtual Private Network)"
homepage="https://openvpn.net/index.php/open-source.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=openvpn
version=2.7.9
release=1
source="https://github.com/OpenVPN/openvpn/archive/v$version/$name-$version.tar.gz"

pkg_build() {

	sed -i '/^CONFIGURE_DEFINES=/s/set/env/g' configure.ac

	autoreconf -fi
	./configure \
		--prefix=/usr \
		--enable-iproute2 \
		--enable-plugins \
		--enable-pkcs11 \
		--disable-systemd
	make
	make DESTDIR=$PKG install
}
