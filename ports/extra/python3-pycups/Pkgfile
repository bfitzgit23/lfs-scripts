# Depends: cups python3-setuptools python3-gpep517 python3-installer
description="Python bindings for libcups "
homepage="https://github.com/OpenPrinting/pycups"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pycups
version=2.0.4
release=1
source=(https://pypi.python.org/packages/source/p/pycups/pycups-$version.tar.gz)
renames=(python3-pycups-2.0.4.tar.gz)

pkg_build() {
	if [ -d pycups-$version ]; then
		cd pycups-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
