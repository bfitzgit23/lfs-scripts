# Depends: python3
description="Helper application and MIME type associations for file types"
homepage="https://pagure.io/mailcap"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mailcap
version=2.1.54
release=1
backup="etc/mailcap"
# pagure.io went read-only in 2026 and hands out no archives, so take the
# upstream tarball from Fedora's lookaside cache, addressed by its sha512.
source="https://src.fedoraproject.org/repo/pkgs/$name/$name-$version.tar.xz/sha512/a80caba013b644111f163d8ef74fe801d7266cf4edd38ca723f98fb12a103a24e84a8fca0c569beb05ca0f407437ed1282306b30303c38327b744194c6fe80b2/$name-$version.tar.xz"

pkg_build() {
	cd $name-$version
	make
	make install DESTDIR="$PKG" sysconfdir=/etc mandir=/usr/share/man
}
