# Depends on: grub 

name=grub-efi
version=2.14
release=2
source=(https://ftp.gnu.org/gnu/grub/grub-$version.tar.xz
	https://unifoundry.com/pub/unifont/unifont-18.0.01/font-builds/unifont-18.0.01.pcf.gz)
renames=(SKIP unifont-18.0.01.pcf.noextract)
build_opt="--disable-efiemu
	--enable-grub-mount
	--enable-grub-mkfont
	--enable-device-mapper
	--with-platform=efi
	--target=x86_64
	--disable-werror"

pre_build() {
	unset CFLAGS
	unset CXXFLAGS
	mkdir -pv $PKG/usr/share/fonts/unifont
	gunzip -c ../unifont-18.0.01.pcf.noextract > $PKG/usr/share/fonts/unifont/unifont.pcf
}

post_build() {
	rm -rf \
	$PKG/etc \
	$PKG/usr/sbin \
	$PKG/usr/bin \
	$PKG/usr/share/info \
	$PKG/usr/share/locale \
	$PKG/usr/share/grub
}
