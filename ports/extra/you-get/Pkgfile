# Depends: python3-setuptools python3-gpep517 python3-installer
description="A YouTube/Youku/Niconico video downloader written in Python 3"
homepage="https://github.com/soimort/you-get"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=you-get
version=0.4.1743
release=1
source="https://github.com/soimort/you-get/archive/v$version/$name-$version.tar.gz"

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
