# Depends: libcanberra imagemagick python3-pygments libxkbcommon librsync go xxhash simde ttf-nerd-fonts-symbols
description="Kitty is a GPU Accelerated Terminal"

homepage="https://sw.kovidgoyal.net/kitty/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=kitty
version=0.51.0
release=1
source="https://github.com/kovidgoyal/kitty/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	python3 setup.py linux-package --update-check-interval=0
	python3 setup.py linux-package --prefix $PKG/usr
}
