# Depends: cmake alsa-lib glib
description="PulseAudio emulation for ALSA"
homepage="https://github.com/i-rinat/apulse"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=apulse
version=0.1.14
release=1
source=(https://github.com/i-rinat/apulse/archive/v$version.tar.gz)
renames=(apulse-0.1.14.tar.gz)

pkg_build() {
	cmake -B build -S ${name}-${version} -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=/usr/lib \
	        -DCMAKE_INSTALL_LIBEXECDIR=/usr/lib \
	        -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS"
	cmake --build build
	DESTDIR=$PKG cmake --install build
	
	# exclude library for revdep
	install -d $PKG/etc/revdep.d
	echo "/usr/lib/apulse/" > $PKG/etc/revdep.d/$name.conf
}
