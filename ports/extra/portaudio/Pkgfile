# Depends: alsa-lib
description="PortAudio is a cross-platform, open-source C language library for real-time audio input and output"
homepage="https://github.com/PortAudio/portaudio"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=portaudio
version=19.7.0
release=1
source=(https://github.com/PortAudio/portaudio/archive/refs/tags/v$version.tar.gz)
renames=(portaudio-19.7.0.tar.gz)

pkg_build() {
    ./configure --prefix=/usr --enable-cxx --enable-static=no
    make -j1
	make DESTDIR=$PKG install
}
