# Depends: gpgme gspell gst-plugins-good libadwaita libgee libnice libsignal-protocol-c libsoup3 libsrtp qrencode gnutls
description="Modern XMPP (Jabber) chat client written in Vala "
homepage="https://dino.im/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=dino
version=0.5.1
release=1
source="https://github.com/dino/dino/releases/download/v${version}/${name}-${version}.tar.gz"

pkg_build() {
	venom-meson $SRC/$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
