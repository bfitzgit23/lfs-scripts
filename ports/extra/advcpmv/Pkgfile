# Depends: coreutils
description="A patch for GNU Core Utilities cp, mv to add progress bars"
homepage="https://github.com/jarun/advcpmv"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=advcpmv
version=1.0
cuversion=9.11
release=1
source=(https://ftp.osuosl.org/pub/lfs/lfs-packages/13.1/coreutils-$cuversion.tar.xz
	https://raw.githubusercontent.com/jarun/advcpmv/master/$name-$version-$cuversion.patch)

pkg_build() {
	cd coreutils-$cuversion

	export FORCE_UNSAFE_CONFIGURE=1

	patch -p1 -i $SRC/$name-$version-$cuversion.patch

	./configure

	make

	mkdir -p $PKG/usr/bin
	cp src/cp $PKG/usr/bin/advcp
	cp src/mv $PKG/usr/bin/advmv
}
