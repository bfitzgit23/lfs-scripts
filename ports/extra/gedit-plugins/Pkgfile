# Depends: appstream-glib gedit python3-dbus vte3 yelp-tools
description="Collection of plugins for the gedit Text Editor"
homepage="https://wiki.gnome.org/Apps/Gedit/ShippedPlugins"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gedit-plugins
version=50.0
release=1
source="https://gitlab.gnome.org/GNOME/gedit-plugins/-/archive/$version/${name}-$version.tar.bz2"

pkg_build() {
  venom-meson $SRC/$name-$version build
  meson compile -C build
  DESTDIR=$PKG meson install --no-rebuild -C build
}
