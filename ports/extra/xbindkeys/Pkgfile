# Depends: libx11 guile
description="Launch shell commands with your keyboard or your mouse under X"
homepage="https://www.nongnu.org/xbindkeys/xbindkeys.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xbindkeys
version=1.8.7
release=2
source="http://deb.debian.org/debian/pool/main/x/xbindkeys/xbindkeys_$version.orig.tar.gz"

pkg_build() {

	# pick up new guile versions
	autoreconf -vi

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}

