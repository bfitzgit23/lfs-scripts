# Depends on: libxml2 

name=llvm
version=23.1.6
release=4
source=(https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz
	llvm-config.h
	clang-$version-enable_default_ssp-1.patch)
build_opt="-DLLVM_ENABLE_PROJECTS=clang
	-DLLVM_ENABLE_FFI=ON
	-DLLVM_BUILD_LLVM_DYLIB=ON
	-DLLVM_LINK_LLVM_DYLIB=ON
	-DLLVM_ENABLE_RTTI=ON
	-DLLVM_TARGETS_TO_BUILD='host;AMDGPU;BPF'
	-DLLVM_BINUTILS_INCDIR=/usr/include
	-DLLVM_INCLUDE_BENCHMARKS=OFF
	-DCLANG_DEFAULT_PIE_ON_LINUX=ON
	-DLLVM_INCLUDE_UTILS=ON
	-DLLVM_INSTALL_UTILS=ON
	-DLLVM_UTILS_INSTALL_DIR=/usr/bin"
build_type=cmake_build

pre_build() {
	# 23.x ships the llvm-project monorepo: clang/ already sits beside llvm/,
	# cmake/ and third-party/, and clang is enabled with the build_opt above,
	# so nothing is unpacked, moved or rewritten any more. Point scripts using
	# /usr/bin/env python at the system python3, then configure from llvm/,
	# which is the supported entry point (the monorepo root is a stub).
	grep -rl '#!.*python' llvm clang | xargs -r sed -i '1s/python$/python3/'

	export CC=gcc
	export CXX=g++

	cd llvm
}

post_build() {
	# multilib stub
	mv $PKG/usr/include/llvm/Config/llvm-config.h \
	   $PKG/usr/include/llvm/Config/llvm-config-64.h
	cp $SRC/llvm-config.h \
	   $PKG/usr/include/llvm/Config/llvm-config.h
	# pkgmk deletes every *.a from a package, but the cmake exports LLVM installs
	# list each component archive as an imported target and verify that the file
	# exists, so find_package(LLVM) aborts with: The imported target "LLVMDemangle"
	# references the file /usr/lib/libLLVMDemangle.a but this file does not exist.
	# CMake writes that verification as the last block of LLVMExports.cmake and
	# opens it with a fixed marker comment, so drop everything from the marker to
	# the end of the file - matching the loop body instead breaks whenever CMake
	# renames its internal variables - and neutralise any leftover existence
	# test. The imported targets stay defined, and since LLVMConfig.cmake ships
	# LLVM_LINK_LLVM_DYLIB, consumers link the installed libLLVM.so instead.
	for f in $PKG/usr/lib/cmake/llvm/LLVMExports*.cmake; do
		[ -f "$f" ] || continue
		sed -i '/# Loop over all imported files and verify that they actually exist/,$d' "$f"
		sed -i 's/if *( *NOT EXISTS *"\${[A-Za-z_]*}" *)/if(FALSE)/' "$f"
		n=$(grep -c 'NOT EXISTS' "$f" || true)
		echo "  $name: ${f##*/} still has $n existence checks"
	done
}
