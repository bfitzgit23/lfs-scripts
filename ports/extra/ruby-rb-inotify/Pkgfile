# Depends: ruby-ffi
description="Thorough inotify wrapper for Ruby using FFI"
homepage="https://github.com/guard/rb-inotify"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ruby-rb-inotify
version=0.11.1
release=2
source="https://rubygems.org/downloads/${name#*-}-$version.gem"

pkg_build() {
	_gemdir="$(gem env gemdir)"

	gem install \
		--ignore-dependencies \
		--no-user-install \
		--no-document \
		-i "$PKG/$_gemdir" \
		-n "$PKG"/usr/bin \
		${name#*-}-$version.gem

	rm "$PKG/$_gemdir/cache/${name#*-}-$version.gem"
}
