# Depends: python3-setuptools python3-gpep517 python3-installer
description="IMAP and POP3 mail retriever with reliable Maildir and command delivery"
homepage="http://pyropus.ca/software/getmail"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=getmail
version=6.21.02
release=1
source="https://github.com/getmail6/getmail6/archive/v$version/$name-$version.tar.gz"

pkg_build() {
	cd ${name}6-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
