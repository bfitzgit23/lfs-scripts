# Depends: hyprutils libwebp libjxl libspng pango librsvg
description="Hyprland graphics resource utilities"
homepage="https://github.com/hyprwm/hyprgraphics"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=hyprgraphics
version=0.5.1
release=1
source=(https://github.com/hyprwm/hyprgraphics/archive/v$version.tar.gz)
renames=(hyprgraphics-0.5.1.tar.gz)

pkg_build() {
	cmake -S $name-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
