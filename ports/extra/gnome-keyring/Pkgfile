# Depends: gcr3 linux-pam glib
description="Daemon that keeps passwords and other secrets for users"
homepage="https://www.gnome.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gnome-keyring
version=50.0
release=1
source="https://github.com/GNOME/gnome-keyring/archive/$version/$name-$version.tar.gz"

pkg_build() {
	venom-meson $SRC/$name-$version build -Dselinux=disabled -Dsystemd=disabled
	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
