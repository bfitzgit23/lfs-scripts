# Depends: lm_sensors gtk3
description="X11 interface to lm_sensors"
homepage="http://www.linuxhardware.org/xsensors/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xsensors
version=0.80
release=1

source=(https://github.com/Mystro256/$name/archive/$version.tar.gz)
renames=(xsensors-0.80.tar.gz)

pkg_build() {

    ./configure \
	--prefix=/usr

    make
    make DESTDIR=$PKG install
}

