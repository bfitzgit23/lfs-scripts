# Depends: btrfs-progs grub wendy
description="Include btrfs snapshots in GRUB boot options"
homepage="https://github.com/Antynea/grub-btrfs"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=grub-btrfs
version=4.14
release=1
backup="etc/default/grub-btrfs/config"
source=(https://github.com/Antynea/grub-btrfs/archive/refs/tags/v$version.tar.gz
	run.grub-btrfs
	rc.grub-btrfs
	conf)
renames=(grub-btrfs-4.14.tar.gz SKIP SKIP SKIP)

pkg_build() {

	make DESTDIR=$PKG install

	# remove systemd things
	rm -rf $PKG/usr/lib/systemd
	rm -rf $PKG/usr/share/licenses	

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.grub-btrfs $PKG/etc/sv/grub-btrfs/run
		install $SRC/conf $PKG/etc/sv/grub-btrfs/conf
		ln -s /run/runit/supervise.grub-btrfs $PKG/etc/sv/grub-btrfs/supervise
	} || continue
	
	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.grub-btrfs $PKG/etc/rc.d/grub-btrfs || continue
}

