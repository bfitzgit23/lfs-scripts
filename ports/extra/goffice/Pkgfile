# Depends: gtk3 libxslt which libgsf
description="A GLib/GTK set of document-centric objects and utilities library"
homepage="https://gitlab.gnome.org/GNOME/goffice"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=goffice
version=0.10.61
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr
	make
	make PREFIX=$PKG/usr DESTDIR=$PKG install
}
