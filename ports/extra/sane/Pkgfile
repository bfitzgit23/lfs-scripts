# Depends: libusb libtiff libpng autoconf-archive
description="Scanner Access Now Easy - Scanner driver for Linux "
homepage="https://gitlab.com/sane-project/backends"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sane
version=1.4.0
release=2
source=(https://gitlab.com/sane-project/backends/-/archive/$version/backends-$version.tar.bz2
	$homepage/-/commit/d04d17b456d9847021b6df6eb08a3419a75172cf.patch)
renames=(sane-1.4.0.tar.gz SKIP)

pkg_build() {
	if [ -d backends-$version ]; then
		cd backends-$version
	fi
	patch -Np1 -i $SRC/d04d17b456d9847021b6df6eb08a3419a75172cf.patch
	./autogen.sh
    	./configure \
		--prefix=/usr \
                --localstatedir=/var \
                --sysconfdir=/etc \
		--enable-pthread \
		--disable-translations \
                --disable-locking \
                --disable-latex \
                --with-group=scanner \
		--with-libcurl \
                --with-usb    
	make
	make -j1 DESTDIR=$PKG install

	install -D -m 644 tools/udev/libsane.rules $PKG/etc/udev/rules.d/85-libsane.rules

}
