# Depends: libdrm libx11 libxcb libxext libxfixes libxshmfence libxxf86vm llvm python3-mako python3-markupsafe python3-yaml libglvnd libxrandr spirv-tools spirv-llvm-translator 

name=mesa
version=26.3.1
release=2
source=(https://archive.mesa3d.org/$name-$version.tar.xz)

[ -f /usr/lib/pkgconfig/wayland-client.pc ] && wayland=",wayland"

# The shared meson wrapper builds with LTO; mesa refuses to build that way.
build_opt="
	-Db_lto=false
	-Dplatforms=x11$wayland
	-Dgallium-drivers=auto
	-Dvulkan-drivers=""
	-Dvalgrind=disabled
	-Dlibunwind=disabled
	-Dglvnd=true
"
