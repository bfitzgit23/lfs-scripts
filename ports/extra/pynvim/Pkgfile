# Depends: python3-greenlet python3-msgpack python3-gpep517 python3-installer python3-setuptools
description="Python client for Neovim"
homepage="https://github.com/neovim/pynvim"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pynvim
version=0.6.0
release=1
source="https://pypi.io/packages/source/p/$name/$name-$version.tar.gz"

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}

