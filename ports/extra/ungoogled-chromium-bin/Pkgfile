# Depends: alsa-lib cups desktop-file-utils gtk3 hicolor-icon-theme libxkbcommon nss pciutils minizip openh264
description="Google Chromium, sans integration with Google (portable ungoogled binary version)"
homepage="https://github.com/ungoogled-software/ungoogled-chromium"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ungoogled-chromium-bin
version=149.0.7827.196
build=1
arch="x86_64"
release=1
_source1=https://mirror1.artixlinux.org/repos/galaxy/os/${arch}/${name%-bin}-${version}-${build}-${arch}.pkg.tar.zst 
_source2=https://github.com/ungoogled-software/ungoogled-chromium-archlinux/releases/download/$version-$build/${name%-bin}-${version}-${build}-x86_64.pkg.tar.zst
source=($name-$version-${build}.tar.zst::$_source2 chromium.desktop)

pkg_build() {
	cp -R "${SRC}/usr/" "${PKG}/usr"

	chown root "$PKG/usr/lib/chromium/chrome-sandbox"
	chmod 4755 "$PKG/usr/lib/chromium/chrome-sandbox"

	# desktop
	install -d $PKG/usr/share/applications
	install -m644 $SRC/chromium.desktop $PKG/usr/share/applications/chromium
}

