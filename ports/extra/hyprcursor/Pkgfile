# Depends: gdb hyprlang libzip librsvg tomlplusplus
description="The hyprland cursor format, library and utilities"
homepage="https://github.com/hyprwm/hyprcursor"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=hyprcursor
version=0.1.14
release=1
source=(https://github.com/hyprwm/hyprcursor/archive/refs/tags/v$version.tar.gz)
renames=(hyprcursor-0.1.14.tar.gz)

pkg_build() {
	cmake -S $name-$version -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		--no-warn-unused-cli \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
