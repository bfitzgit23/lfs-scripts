# Depends: python3-setuptools python3-pafy python3-gpep517 python3-installer
description="Yewtube, forked from mps-youtube, is a Terminal based YouTube player and downloader"
homepage="https://github.com/mps-youtube/yewtube"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mps-youtube
version=2.13.1
release=1
source=(https://github.com/mps-youtube/yewtube/archive/v$version.tar.gz)
renames=(mps-youtube-2.13.1.tar.gz)

pkg_build() {
	cd yewtube-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
