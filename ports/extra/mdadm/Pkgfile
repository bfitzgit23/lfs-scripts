description="Multiple device (RAID) admin tool"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
homepage="http://neil.brown.name/blog/mdadm" 

name=mdadm
version=4.6
release=1
source=(https://git.kernel.org/pub/scm/utils/mdadm/mdadm.git/snapshot/$name-$version.tar.gz
	run.mdadm)

pkg_build() {
	make CXFLAGS="$CFLAGS" BINDIR=/usr/bin UDEVDIR=/usr/lib/udev everything
	make INSTALL=/usr/bin/install BINDIR=/usr/bin DESTDIR="$PKG" UDEVDIR=/usr/lib/udev install

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run
		ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
	} || continue
}
