# Depends: cairomm-gtk4 glibmm-gtk4 pango
description="C++ interface to pango"
homepage="https://gitlab.gnome.org/GNOME/pangomm"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=pangomm-gtk4
nm=pangomm
version=2.56.1
release=1
source=(https://ftp.gnome.org/pub/GNOME/sources/$nm/${version%.*}/$nm-$version.tar.xz)
renames=(pangomm-gtk4-2.56.1.tar.xz)

pkg_build() {
	venom-meson $SRC/$nm-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
