# Depends: wayland meson
description="Utility to manage outputs of a Wayland compositor"
homepage="https://sr.ht/~emersion/wlr-randr/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=wlr-randr
version=0.5.0
release=1
source=(https://gitlab.freedesktop.org/emersion/$name/-/releases/v$version/downloads/$name-$version.tar.gz)
renames=(wlr-randr-0.5.0.tar.gz)
      
pkg_build() {
	  venom-meson ${name}-${version} build
          meson compile -C build
          DESTDIR=$PKG meson install --no-rebuild -C build
}
