description="MJWM can create JWM's menu from (freedesktop) desktop files and the generated file can be include in the rootmenu section of your jwm config file."
homepage="https://github.com/chiku/mjwm"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mjwm
version=5.1.0
release=1
source=(https://github.com/chiku/$name/archive/refs/tags/v$version.tar.gz)
renames=(mjwm-5.1.0.tar.gz)

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var
	make
	make DESTDIR=$PKG install
}
