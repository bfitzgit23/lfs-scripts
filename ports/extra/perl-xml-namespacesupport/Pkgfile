# Depends: perl
description="Generic namespace helpers (ported from SAX2)"
homepage="https://search.cpan.org/dist/XML-NamespaceSupport"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-xml-namespacesupport
version=1.12
release=2
source=(http://search.cpan.org/CPAN/authors/id/P/PE/PERIGRIN/XML-NamespaceSupport-$version.tar.gz)
renames=(perl-xml-namespacesupport-1.12.tar.gz)

pkg_build() {
	cd XML-NamespaceSupport-$version

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make install DESTDIR=$PKG

	find $PKG -name '.packlist' -delete
	find $PKG -name '*.pod' -delete
}
