# Depends: libxaw bdftopcf mkfontscale
description="console emulator for IBM Mainframes"
homepage="https://github.com/pmattes/x3270"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=x3270
version=4.5ga5
release=1
source=(https://github.com/pmattes/$name/archive/$version.tar.gz)
renames=(x3270-4.5ga5.tar.gz)

pkg_build() {
    ./configure --prefix=/usr --sysconfdir=/etc --disable-tcl3270
    make
    make DESTDIR=$PKG install
}
