# Depends: gegl appstream-glib gtk2 mypaint-brushes1 gexiv2 libgudev libexif libjxl libtiff
description="GNU Image Manipulation Program"
homepage="https://www.gimp.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gimp2
version=2.10.38
release=2
source="https://download.gimp.org/pub/${name%2*}/v${version%.*}/${name%2*}-$version.tar.bz2"

pkg_build() {
	if [ -d ${name%2*}-$version ]; then cd ${name%2*}-$version; fi

	# fix build gcc 14	
	export CFLAGS="${CFLAGS} -Wno-incompatible-pointer-types -Wno-int-conversion"

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib/$name \
		--disable-nls \
		--disable-python \
		--enable-mp \
		--disable-check-update \
		--without-aa 
	make
	make DESTDIR=$PKG install

}
