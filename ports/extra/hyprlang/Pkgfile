# Depends: cmake
description="Implementation library for the hypr config language"
homepage="https://github.com/hyprwm/hyprlang"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=hyprlang
version=0.6.8
release=1
source=(https://github.com/hyprwm/$name/archive/v$version/$name-$version.tar.gz)
renames=(hyprlang-0.6.8.tar.gz)

pkg_build() {
	cmake -B build \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release
	cmake --build build
	DESTDIR=$PKG cmake --install build
}

