description="Full-screen window manager that multiplexes a physical terminal"
homepage="https://www.gnu.org/software/screen/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=screen
version=5.0.2
release=1
source="https://mirrorservice.org/sites/ftp.gnu.org/gnu/screen/screen-5.0.1.tar.gz"

pkg_build() {

	NOCONFIGURE=1 ./autogen.sh	
	./configure --prefix=/usr                     \
	            --infodir=/usr/share/info         \
	            --mandir=/usr/share/man           \
	            --with-socket-dir=/run/screen     \
	            --with-pty-group=5                \
	            --with-sys-screenrc=/etc/screenrc
	sed -i -e "s%/usr/local/etc/screenrc%/etc/screenrc%" etc/*
	sed -i -e "s%/usr/local/etc/screenrc%/etc/screenrc%" doc/*
	make
	make DESTDIR=$PKG install

	#mkdir -p $PKG/etc
	install -Dm 644 etc/etcscreenrc $PKG/etc/screenrc

}
