# Depends: xcb-util-image pixman
description="wallpaper setting utility for X"
homepage="https://github.com/stoeckmann/xwallpaper"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xwallpaper
version=0.7.6
release=1
source="https://github.com/stoeckmann/$name/archive/v$version/$name-v$version.tar.gz"

pkg_build() {
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
