# Depends: python3-setuptools python3-gpep517 python3-installer
description="Command line interface for testing internet bandwidth using speedtest.net"
homepage="https://github.com/sivel/speedtest-cli"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=speedtest-cli
version=2.1.3
release=1
source="$name-$version.tar.gz::https://github.com/sivel/speedtest-cli/archive/v$version.tar.gz"

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
	install -Dm 644 $name.1 -t $PKG/usr/share/man/man1
}
