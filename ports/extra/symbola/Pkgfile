# Depends: fontconfig poppler
description="Unicode font for Latin, IPA Extensions, Greek, Cyrillic and many Symbol Blocks"
homepage="https://dn-works.com/ufas/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=symbola
version=14.00
release=1
# dn-works.com is gone, so take the last archived copy of the 14.00 PDF.
source="https://web.archive.org/web/20240107144224if_/https://dn-works.com/wp-content/uploads/2021/UFAS121921/Symbola.pdf"

pkg_build() {

	pdfdetach -savefile Symbola.otf Symbola.pdf
	install -d $PKG/user/share/fonts/OTF/symbola
	install -Dm644 Symbola.otf $PKG/user/share/fonts/OTF/symbola/
}
