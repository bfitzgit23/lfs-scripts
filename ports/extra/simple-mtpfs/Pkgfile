# Depends: autoconf-archive fuse2 libmtp
description="A FUSE filesystem that supports reading/writing from MTP devices "
homepage="https://github.com/phatina/simple-mtpfs/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=simple-mtpfs
version=0.4.0
release=1
commit=5dfd25c72caf83bc85fc636804f1456bc0f6c1c6
source=(https://github.com/phatina/simple-mtpfs/archive/$commit.tar.gz)
renames=(simple-mtpfs-0.4.0.tar.gz)

pkg_build() {
	if [ -d $name-$commit ]; then cd $name-$commit; fi
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
