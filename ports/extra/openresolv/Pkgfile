description="A framework for managing DNS information"
homepage="https://roy.marples.name/projects/openresolv"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=openresolv
version=3.17.4
release=2
source=(https://github.com/NetworkConfiguration/$name/archive/refs/tags/v$version.tar.gz)
renames=($name-$version.tar.gz)

pkg_build() {

	# NOTE: Don't set --prefix, it should be /.
	./configure \
		--libexecdir=/lib/resolvconf \
		--mandir=/usr/share/man \
		--rundir=/run \
		--sysconfdir=/etc
	make
	make DESTDIR=$PKG install

	rm -f $PKG/lib/resolvconf/systemd-resolved
}
