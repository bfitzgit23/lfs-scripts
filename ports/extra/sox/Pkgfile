# Depends: libsoxr speex
description="The Swiss Army knife of sound processing tools"
homepage="https://sox.sourceforge.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sox
version=14.9.0
release=1
source=(https://codeberg.org/sox_ng/sox_ng/releases/download/${name}_ng-$version/${name}_ng-$version.tar.gz)
renames=(sox-14.9.0.tar.gz)

pkg_build() {
	cd ${name}_ng-$version
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--enable-replace \
		--with-distro="Venom Linux" \
		--with-ffmpeg 
	make 
	make DESTDIR=$PKG install
}
