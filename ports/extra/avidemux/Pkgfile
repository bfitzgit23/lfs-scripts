# Depends: faad2 qt5
description="Video Editor"
homepage="http://avidemux.sourceforge.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=avidemux
version=2.8.1
release=1
source=(https://sourceforge.net/projects/avidemux/files/avidemux/${version}/avidemux_${version}.tar.gz)
renames=(avidemux-2.8.1.tar.gz)

pkg_build() {
	if [ -d ${name}_${version} ]; then cd ${name}_${version}; fi
	mkdir $SRC/tmp
	sed -i -e "s=/tmp/log\$BUILDDIR=$SRC/tmp/log\$BUILDDIR=g" bootStrap.bash
	bash bootStrap.bash --tgz --with-cli --with-plugins --with-core
	mv install/* $PKG
}
