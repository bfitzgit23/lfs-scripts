# Depends: perl-html-parser gtk3 curl
description="Lightweight and fast web browser"
homepage="https://www.netsurf-browser.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=netsurf
version=3.11
release=1
source="http://download.netsurf-browser.org/netsurf/releases/source-full/netsurf-all-$version.tar.gz"

pkg_build() {
	if [ -d $name-all-$version ]; then
		cd $name-all-$version
	fi

	CFLAGS="$CFLAGS -w -Os -funroll-loops" \
	make \
		PREFIX=/usr \
		LIBDIR=lib \
		INCLUDEDIR=include \
		NETSURF_GTK_MAJOR=3 \
		TARGET=gtk3
	make install \
		PREFIX=/usr \
		LIBDIR=lib \
		INCLUDEDIR=include \
		DESTDIR=$PKG \
		NETSURF_GTK_MAJOR=3 \
		TARGET=gtk3
}
