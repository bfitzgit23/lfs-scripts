# Depends: python3-setuptools python3-gpep517 python3-installer
description="Tool to determine what GCC flags -march=native would resolve into"
homepage="https://github.com/hartwork/resolve-march-native"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=resolve-march-native
version=6.1.0
release=1
source=(https://github.com/hartwork/$name/archive/refs/tags/${version}.tar.gz)
renames=(resolve-march-native-6.1.0.tar.gz)

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
