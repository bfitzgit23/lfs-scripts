# Depends: sgml-common
description="A library and a set of tools for validating, parsing and manipulating SGML and XML documents"
homepage="http://openjade.sourceforge.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=opensp
version=1.5.2
release=2
source=(https://downloads.sourceforge.net/openjade/OpenSP-$version.tar.gz)
renames=(opensp-1.5.2.tar.gz)

pkg_build() {
	if [ -d OpenSP-$version ]; then
		cd OpenSP-$version
	fi

	sed -i 's/32,/253,/' lib/Syntax.cxx
	for i in gensyntax.pl unicode.syn; do
	sed -i 's/LITLEN          240 /LITLEN          8092/' \
	    unicode/$i
	done

	rm m4/progtest.m4
	autoreconf -vif

	./configure --prefix=/usr \
		    --disable-static \
		    --disable-doc-build \
		    --disable-nls \
		    --enable-default-catalog=/etc/sgml/catalog \
		    --enable-http \
		    --enable-default-search-path=/usr/share/sgml
	make pkgdatadir=/usr/share/sgml/OpenSP-$version
	make pkgdatadir=/usr/share/sgml/OpenSP-$version DESTDIR=$PKG install

	ln -v -sf onsgmls   $PKG/usr/bin/nsgmls
	ln -v -sf osgmlnorm $PKG/usr/bin/sgmlnorm
	ln -v -sf ospam     $PKG/usr/bin/spam
	ln -v -sf ospcat    $PKG/usr/bin/spcat
	ln -v -sf ospent    $PKG/usr/bin/spent
	ln -v -sf osx       $PKG/usr/bin/sx
	ln -v -sf osx       $PKG/usr/bin/sgml2xml
	ln -v -sf libosp.so $PKG/usr/lib/libsp.so

}
