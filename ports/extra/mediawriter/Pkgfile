# Depends: qt6-imageformats qt6-tools qt6-5compat qt6-svg udisks2
description="Fedora Media Writer - Write Fedora Images to Portable Media"
homepage="https://github.com/FedoraQt/MediaWriter"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mediawriter
_name=MediaWriter
version=5.3.1
release=1
source="https://github.com/FedoraQt/${_name}/archive/${version}.tar.gz"

pkg_build() {
	cmake -S ${_name-}-${version} -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
