# Depends: python3-gobject3 python3-i3ipc python3-cairo python3-certifi python3-dasbus python3-psutil python3-requests wlr-randr python3-gpep517 python3-installer python3-setuptools
description="GTK3-based panel for sway and Hyprland Wayland compositors"
homepage="https://github.com/nwg-piotr/nwg-panel"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=nwg-panel
version=0.10.15
release=1
source="$name-$version.tar.gz::https://github.com/nwg-piotr/$name/archive/refs/tags/v$version.tar.gz
	config"

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
	install -D -t $PKG/usr/share/pixmaps nwg-panel.svg
	install -D -t $PKG/usr/share/pixmaps nwg-shell.svg
	install -D -t $PKG/usr/share/pixmaps nwg-processes.svg
	install -D -t $PKG/usr/share/applications nwg-panel-config.desktop
	install -D -t $PKG/usr/share/applications nwg-processes.desktop
	install -Dm644 $SRC/config $PKG/usr/lib/python*/site-packages/nwg_panel/config/
}
