# Depends: perl-xml-namespacesupport perl-xml-sax-base
description="Simple API for XML"
homepage="https://search.cpan.org/dist/XML-SAX"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-xml-sax
version=1.02
release=2
source="$name-$version.tar.gz::http://search.cpan.org/CPAN/authors/id/G/GR/GRANTM/XML-SAX-$version.tar.gz"

pkg_build() {
	cd XML-SAX-$version

	#patch -Np1 -i $SRC/perl-xml-sax.patch

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	PERLLIB=blib/lib make install DESTDIR=$PKG

	find $PKG -name '.packlist' -delete
	find $PKG -name '*.pod' -delete
}
