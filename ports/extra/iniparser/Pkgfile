# Depends: cmake

name=iniparser
version=4.3.2
release=2
source=(https://github.com/ndevilla/$name/archive/v$version/$name-$version.tar.gz)

pkg_build() {
	# 4.3.x removed the hand-written Makefile; the tree builds with CMake only.
	# BUILD_SHARED_LIBS/static: ship the shared library alone, as the old port
	# did, so the package does not grow a .a and a target file for it.
	cmake -B build -S . \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_STATIC_LIBS=OFF \
		-DBUILD_DOCS=OFF \
		-DBUILD_EXAMPLES=OFF \
		-DBUILD_TESTING=OFF || return 1

	cmake --build build -j"${JOBS:-1}" || return 1

	DESTDIR="$PKG" cmake --install build || return 1
}
