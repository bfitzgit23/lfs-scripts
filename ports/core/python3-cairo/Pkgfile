# Depends: python3 meson cairo
description="Python3 bindings to Cairo"
homepage="https://pycairo.readthedocs.io/en/latest/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-cairo
version=1.29.0
release=1
source=(https://github.com/pygobject/pycairo/releases/download/v$version/pycairo-$version.tar.gz)
renames=(python3-cairo-1.29.0.tar.gz)

pkg_build() {

	venom-meson pycairo-$version build \
	-Dtests=false
	meson compile -C build
	DESTDIR=$PKG meson install -C build
	python3 -m compileall $PKG/usr/lib

}
