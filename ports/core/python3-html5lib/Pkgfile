# Depends: python3-setuptools python3-packaging python3-webencodings python3-gpep517 python3-installer
description="A Python HTML parser/tokenizer based on the WHATWG HTML5 spec."
homepage="https://github.com/html5lib/html5lib-python"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-html5lib
version=1.1
release=5
source=(https://github.com/html5lib/html5lib-python/archive/$version/html5lib-python-$version.tar.gz
	python-3.14-compatibility.patch setuptools.patch)
renames=(python3-html5lib-1.1.tar.gz SKIP SKIP)

pkg_build() {
	if [ -d html5lib-python-$version ]; then
		cd html5lib-python-$version
	fi

	#Fix build with python 3.14
	patch -Np1 -i $SRC/python-3.14-compatibility.patch

	# Fix build with setuptools
	patch -Np1 -i $SRC/setuptools.patch

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2

	python3 -m installer -d $PKG .dist/*.whl
}
