# Depends: python3 python3-gpep517 python3-installer python3-setuptools
description="Cryptographic library for Python"
homepage="https://www.pycryptodome.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pycryptodome
_name=${name#*-}
_n=${_name%${_name#?}}
version=4.5.0
release=1
source=(https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-pycryptodome-4.5.0.tar.gz)

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
