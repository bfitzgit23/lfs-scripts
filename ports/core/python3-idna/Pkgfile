# Depends: python3-gpep517 python3-flit-core
description="Internationalized Domain Names in Applications (IDNA)"
homepage="https://github.com/kjd/idna"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-idna
_name=${name#*-}
_n=${_name%${_name#?}}
version=3.20
release=1
source=(https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-idna-3.20.tar.gz)

pkg_build() {
	    gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
		.dist/*.whl
}
