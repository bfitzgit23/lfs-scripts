# Depends: libdrm mesa eudev xorg-server
description="X.org vmware video driver"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xf86-video-vmware
version=13.4.0
release=1
source=(http://ftp.x.org/pub/individual/driver/$name-$version.tar.xz
	gcc8.diff)

pkg_build() {

	patch -Np0 -i $SRC/gcc8.diff

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
