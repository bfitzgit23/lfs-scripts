# Depends: python3-setuptools python3-gpep517 python3-installer
description="Python library for ISO 639 standard"
homepage="https://github.com/noumar/iso639"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-iso-639
_name=${name#*-}
_n=${_name%${_name#?}}
version=0.4.5
release=1
source=(https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-iso-639-0.4.5.tar.gz)

pkg_build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
