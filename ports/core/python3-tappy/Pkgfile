# Depends: python3-hatchling python3-babel python3-pyaml python3-more-itertools
description="Test Anything Protocol (TAP) tools for Python"
homepage="https://pypi.python.org/pypi/tap.py"
maintainer="CELESTIFYX Team <celestifyx@gmail.com>"

name=python3-tappy
version=3.2.1
release=1
source=(https://files.pythonhosted.org/packages/source/t/tap_py/tap_py-${version}.tar.gz)
renames=(python3-tappy-3.2.1.tar.gz)

pkg_build() {
    cd tap_py-${version}

    python3 -m build --wheel --no-isolation
    python3 -m unittest discover -v
    python3 -m installer --destdir="${PKG}" dist/*.whl
}
