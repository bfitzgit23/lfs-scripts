# Depends: python3-gpep517 python3-flit-core
description="Backported and Experimental Type Hints for Python 3.5+"
homepage="https://github.com/python/typing/tree/master/typing_extensions"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-typing_extensions
version=4.16.0
release=1
source=(https://pypi.org/packages/source/t/typing_extensions/typing_extensions-$version.tar.gz)
renames=(python3-typing_extensions-4.16.0.tar.gz)

pkg_build() {
	if [ -d typing_extensions-$version ]; then
		cd typing_extensions-$version
	fi

	gpep517 build-wheel \
                --wheel-dir .dist \
                --output-fd 3 3>&1 >&2

        python3 -m installer -d $PKG \
                .dist/*.whl
}
