# Depends: python3-setuptools python3-gpep517 python3-wheel
description="Python implementation of the geodesic routines in GeographicLib"
homepage="https://geographiclib.sourceforge.io/1.50/python/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-geographiclib
nm=geographiclib
version=2.1
release=2
source="https://files.pythonhosted.org/packages/source/g/$nm/$nm-$version.tar.gz"

pkg_build() {
	if [ -d $nm-$version ]; then
		cd $nm-$version
	fi
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" \
		.dist/*.whl
}


