# Depends: cmake ninja ffmpeg libjpeg-turbo libpng
description="Lightweight video thumbnailer that can be used by file managers"
homepage="https://github.com/dirkvdb/ffmpegthumbnailer"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ffmpegthumbnailer
version=2.3.0
release=1
source=(https://github.com/dirkvdb/ffmpegthumbnailer/archive/refs/tags/v$version.tar.gz)
renames=(ffmpegthumbnailer-2.3.0.tar.gz)

pkg_build() {
	cmake  -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DENABLE_GIO=ON \
		-DENABLE_THUMBNAILER=ON \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
