# Depends: python3-setuptools python3-six python3-gpep517 python3-installer
description="Python 3+ compatible port of the configobj library"
homepage="https://github.com/DiffSK/configobj"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-configobj
version=5.0.9
release=1
source="https://github.com/DiffSK/configobj/archive/v$version/configobj-$version.tar.gz"

pkg_build() {
  if [ -d configobj-$version ]; then
    cd configobj-$version
  fi
  gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
  python3 -m installer -d $PKG .dist/*.whl
}
