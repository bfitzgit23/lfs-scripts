# Depends: dbus libmd egl-wayland pixman libxkbfile libepoxy libxfont2 libxcvt libtirpc libxshmfence
description="Compact xserver to run under wayland for compatibility"
homepage="https://www.x.org/wiki"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xwayland
version=24.1.12
release=1
source=(https://gitlab.freedesktop.org/xorg/xserver/-/archive/$name-$version/xserver-$name-$version.tar.gz)
renames=($name-$version.tar.gz)

pkg_build() {

        venom-meson $SRC/xserver-$name-$version build \
		-Db_lto=true \
		-Dipv6=true \
		-Dxvfb=false \
		-Dxdmcp=false \
		-Dxcsecurity=true \
		-Ddri3=true \
		-Dglamor=true \
		-Dsha1=libmd \
		-Dxkb_dir=/usr/share/X11/xkb \
		-Dxkb_output_dir=/var/lib/xkb 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
        
	rm $PKG/usr/lib/xorg/protocol.txt
	rmdir $PKG/usr/lib/xorg
	rm $PKG/usr/share/man/man1/Xserver.1

}
