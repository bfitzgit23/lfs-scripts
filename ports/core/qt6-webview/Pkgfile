# Depends: qt6-webengine
description="Provides a way to display web content in a QML application"
homepage="https://www.qt.io"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=qt6-webview
version=6.11.1
release=1
source=(https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtwebview-everywhere-src-$version.tar.xz)
renames=(qt6-webview-6.11.1.tar.xz)

pkg_build() {
	cmake -B build -S qtwebview-everywhere-src-$version -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D QT_USE_CCACHE=$(scratch isinstalled ccache && printf "ON" || printf "OFF")
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
