# Depends: qt6-quicktimeline
description="Qt module and API for defining 3D content in Qt Quick"
homepage="https://www.qt.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=qt6-quick3d
version=6.11.1
release=1
source=(https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtquick3d-everywhere-src-$version.tar.xz)
renames=(qt6-quick3d-6.11.1.tar.xz)

pkg_build() {
	cmake -S qtquick3d-everywhere-src-$version -B build  -G Ninja \
		-D QT_USE_CCACHE=$(scratch isinstalled ccache && printf "ON" || printf "OFF") \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS"
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
