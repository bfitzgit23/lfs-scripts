# Depends: python3-setuptools python3-gpep517
description="A minimal static theme for Sphinx"
homepage="https://gitlab.com/lv2/sphinx_lv2_theme"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-sphinx-lv2-theme
_name=sphinx_lv2_theme
version=1.4.6
release=3
source=(https://gitlab.com/lv2/${_name}/-/archive/v$version/${_name}-v$version.tar.gz)
renames=(python3-sphinx-lv2-theme-1.4.6.tar.gz)

pkg_build() {
	if [ -d $_name-v$version ]; then cd $_name-v$version; fi

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}
