# Depends: doxygen python3-sphinx python3-gpep517
description="Python module/script that generates Sphinx markup to describe a C API, from an XML description extracted by Doxygen"
homepage="https://gitlab.com/drobilla/sphinxygen"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-sphinxygen
version=1.0.12
release=1
source=(https://gitlab.com/drobilla/sphinxygen/-/archive/v$version/${name#*-}-v$version.tar.gz)
renames=(python3-sphinxygen-1.0.12.tar.bz2)

pkg_build() {
	cd ${name#*-}-v$version

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}
