# Depends: expat libgcrypt gnutls zlib
description="A portable middleware for email access"
homepage="https://www.etpan.org/libetpan.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libetpan
version=1.10.1
release=1
source=(https://github.com/dinhviethoa/$name/archive/$version.tar.gz)
renames=(libetpan-1.10.1.tar.gz)

pkg_build() {
  
	NOCONFIGURE=1 ./autogen.sh
	./configure --prefix=/usr \
	    --disable-static \
	    --disable-db \
	    --with-openssl=no \
	    --with-gnutls=yes
	make
	make DESTDIR=$PKG install
}

