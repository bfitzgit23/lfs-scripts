# Depends: glad lcms2 shaderc vulkan-icd-loader
description="Reusable library for GPU-accelerated video/image rendering primitives"
homepage="https://github.com/haasn/libplacebo"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libplacebo
version=7.360.1
release=1
source=(https://github.com/haasn/libplacebo/archive/v$version.tar.gz)
renames=(libplacebo-7.360.1.tar.gz)

pkg_build() {
	CXXFLAGS="$CXXFLAGS -I/usr/include/glslang"
	venom-meson $SRC/$name-$version build \
		-Dvulkan=enabled \
		-Dshaderc=enabled \
		-Dlcms=enabled \
		-Dd3d11=disabled \
		-Ddemos=false \
		-Dtests=false
	meson compile -C build 
	DESTDIR=$PKG meson install --no-rebuild -C build
}

