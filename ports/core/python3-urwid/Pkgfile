# Depends: python3-typing-extensions python3-setuptools-scm python3-wheel python3-gpep517
description="Curses-based user interface library"
homepage="https://urwid.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-urwid
version=5.1.3
release=1
source=(https://pypi.python.org/packages/source/u/urwid/urwid-$version.tar.gz)
renames=(python3-urwid-5.1.3.tar.gz)

pkg_build() {
	cd urwid-$version
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" \
		.dist/*.whl

}
