# Depends: python3 python3-gpep517 python3-installer python3-setuptools
description="A small Python module for determining appropriate platform-specific dirs, e.g. a 'user data dir'"
homepage="https://github.com/ActiveState/appdirs"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-appdirs
version=1.4.4
release=1
source="$name-$version.tar.gz::https://pypi.io/packages/source/a/appdirs/appdirs-$version.tar.gz"

pkg_build() {
	cd appdirs-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}

