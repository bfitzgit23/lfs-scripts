# Depends: python3-six python3-setuptools python3-gpep517 python3-installer
description="WebSocket client library for Python"
homepage="https://github.com/websocket-client/websocket-client"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-websocket-client
version=1.9.2
release=1
source=(https://pypi.io/packages/source/w/websocket-client/websocket_client-$version.tar.gz)
renames=(python3-websocket-client-1.9.2.tar.gz)

pkg_build() {
	if [ -d websocket_client-$version ]; then
		cd websocket_client-$version
	fi

	sed -i "s/'backports.ssl_match_hostname'//" setup.py
	
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
