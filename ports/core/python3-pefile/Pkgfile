# Depends: python3-setuptools python3-gpep517
description="Python PE parsing module"
homepage="https://github.com/erocarrera/pefile"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pefile
version=2024.8.26
release=2
source=(https://github.com/erocarrera/pefile/archive/v$version/python-setuptools-$version.tar.gz)
renames=(python3-pefile-2024.8.26.tar.gz)

pkg_build() {
	cd pefile-$version
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	python3 -m installer -d $PKG \
		.dist/*.whl
}

