# Depends: qt6-declarative
description="Static and runtime integration of SCXML models into Qt6 code"
homepage="https://www.qt.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=qt6-scxml
version=6.11.1
release=1
source=(https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtscxml-everywhere-src-$version.tar.xz)
renames=(qt6-scxml-6.11.1.tar.xz)

pkg_build() {
	cmake -S qtscxml-everywhere-src-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DQT_USE_CCACHE=$(scratch isinstalled ccache && printf "ON" || printf "OFF") 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
