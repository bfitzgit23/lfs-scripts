# Depends: python3-setuptools python3-gpep517 python3-installer
description="Python3 library to access freedesktop.org standards"
homepage="http://freedesktop.org/Software/pyxdg"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-xdg
version=0.28
release=2
source=(https://pypi.org/packages/source/p/pyxdg/pyxdg-$version.tar.gz)
renames=(python3-xdg-0.28.tar.gz)

pkg_build() {
	cd pyxdg-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}

