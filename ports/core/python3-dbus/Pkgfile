# Depends: dbus python3 dbus-glib python3-pyproject-metadata
description="Python3 bindings to the D-Bus"
homepage="http://dbus.freedesktop.org/releases/dbus-python"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-dbus
version=1.4.0
release=1
source=(http://dbus.freedesktop.org/releases/dbus-python/dbus-python-$version.tar.xz)
renames=(python3-dbus-1.4.0.tar.gz)

pkg_build() {
	export PYTHON=/usr/bin/python3


	venom-meson dbus-python-$version build \
		-Dtests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build


	/usr/bin/python3 $SRC/dbus-python-$version/tools/generate-pkginfo.py $version PKG-INFO
	/usr/bin/python3 -m compileall -d /usr/lib $PKG/usr/lib
	/usr/bin/python3 -O -m compileall -d /usr/lib $PKG/usr/lib


}
