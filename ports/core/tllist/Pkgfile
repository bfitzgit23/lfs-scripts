# Depends: meson ninja
description="A typed linked list C header file only library"
homepage="https://codeberg.org/dnkl/tllist"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=tllist
version=1.1.0
release=1
source=(https://codeberg.org/dnkl/tllist/archive/$version.tar.gz)
renames=(tllist-1.1.0.tar.gz)

pkg_build() {

  venom-meson $SRC/$name build 
  meson compile -C build
  DESTDIR=$PKG meson install --no-rebuild -C build
  rm -r $PKG/usr/share
}
