# Depends: python3-alabaster python3-docutils python3-imagesize python3-jinja2 python3-packaging python3-pygments python3-requests python3-snowballstemmer python3-sphinxcontrib-applehelp python3-sphinxcontrib-devhelp python3-sphinxcontrib-htmlhelp python3-sphinxcontrib-jsmath python3-sphinxcontrib-qthelp python3-sphinxcontrib-serializinghtml python3-sphinxcontrib-websupport python3-gpep517 python3-flit-core python3-roman-numerals
description="The Sphinx documentaion generator"
homepage="https://www.sphinx-doc.org/en/master/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-sphinx
_name=sphinx
version=9.2.0
release=1
source=(https://github.com/sphinx-doc/sphinx/archive/v$version.tar.gz)
renames=(python3-sphinx-9.2.0.tar.gz)

pkg_build() {
	if [ -d $_name-$version ]; then
		if [ -d $_name-$version ]; then cd $_name-$version; fi
	fi

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	   python3 -m installer -d $PKG \
			.dist/*.whl
}
