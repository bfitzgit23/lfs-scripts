 # include <termcap.h>
 #elif defined HAVE_CURSES_TGETENT
 # include <curses.h>
 # ifndef _XOPEN_CURSES
 #  include <term.h>
 # endif
+#elif defined HAVE_TGETENT
+/* configure sets HAVE_TGETENT without HAVE_TERMCAP_TGETENT when tgetent()
