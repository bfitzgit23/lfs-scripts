# Depends: python3-setuptools python3-gpep517 python3-wheel python3-packaging
description="Simple powerful testing with Python"
homepage="https://pytest.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pytest
version=9.2.0
release=1
source=(https://files.pythonhosted.org/packages/source/p/pytest/pytest-$version.tar.gz)
renames=(python3-pytest-9.2.0.tar.gz)

pkg_build() {
	if [ -d pytest-$version ]; then
		cd pytest-$version
	fi
	sed -e "/^\[metadata\]/a version = $version" -i setup.cfg
		gpep517 build-wheel \
			--wheel-dir .dist \
			--output-fd 3 3>&1 >&2

		python3 -m installer -d "$PKG" \
			.dist/pytest*.whl




}
