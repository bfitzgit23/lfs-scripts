# Depends: python3-setuptools python3-gpep517 python3-installer
description="Self-contained ISO 3166-1 country definitions"
homepage="https://github.com/deactivated/python-iso3166"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-iso3166
_name=${name#*-}
_n=${_name%${_name#?}}
version=3.0.0
release=1
source=(https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-iso3166-3.0.0.tar.gz)

pkg_build() {
	cd ${name#*-}-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
