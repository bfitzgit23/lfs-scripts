# Depends: giflib libxml2 gnutls imagemagick libxpm
description="The extensible, customizable, self-documenting real-time display editor"
homepage="https://www.gnu.org/software/emacs/emacs.html"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=emacs
version=30.2
release=1
source="https://mirrorservice.org/sites/ftp.gnu.org/gnu/emacs/emacs-30.2.tar.xz"

pkg_build() {

	IMAGEMAGICK_CFLAGS=-I/usr/include/ImageMagick-7 \
	IMAGEMAGICK_LIBS="-lMagickCore-7.Q16HDRI -lMagick++-7.Q16HDRI -lMagickWand-7.Q16HDRI" \
	./configure --prefix=/usr \
		    --libexecdir=/usr/lib \
		    --with-gnutls=ifavailable \
		    --with-tiff=no \
		    --localstatedir=/var	
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/lib/systemd

}
