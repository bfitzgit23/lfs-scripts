# Depends: python3-gpep517 python3-flit-core
description="Visually (c)lean, responsive, configurable theme for Sphinx."
homepage="https://alabaster.readthedocs.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-alabaster
version=1.0.0
release=2
source=(https://github.com/bitprophet/${name#*-}/archive/$version/${name#*-}-$version.tar.gz)
renames=(python3-alabaster-1.0.0.tar.gz)

pkg_build() {
	cd ${name#*-}-$version

	    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG .dist/*.whl
}
