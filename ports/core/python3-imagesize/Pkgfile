# Depends: python3-setuptools python3-gpep517 python3-installer
description="Getting image size from png/jpeg/jpeg2000/gif file."
homepage="https://github.com/shibukawa/imagesize_py/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-imagesize
version=2.0.1
release=1
source=(https://files.pythonhosted.org/packages/source/i/imagesize/${name#*-}-$version.tar.gz)
renames=(python3-imagesize-2.0.1.tar.gz)

pkg_build() {

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl

	chmod -R go-w,a+r,u+w $PKG
}
