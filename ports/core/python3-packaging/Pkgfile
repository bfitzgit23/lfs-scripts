# Depends: python3-gpep517 python3-flit-core
description="Core utilities for Python packages"
homepage="https://github.com/pypa/packaging"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-packaging
_name=${name#*-}
_n=${_name%${_name#?}}
version=26.3
release=1
source=(https://github.com/pypa/packaging/archive/refs/tags/$version.tar.gz)
renames=(python3-packaging-26.3.tar.gz)

pkg_build() {
	    gpep517 build-wheel \
		    --wheel-dir .dist \
		    --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}
