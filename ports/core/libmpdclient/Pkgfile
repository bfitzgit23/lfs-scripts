# Depends: meson
description="Asynchronous API library for interfacing MPD in the C, C++ & Objective C languages"
homepage="https://www.musicpd.org/libs/libmpdclient/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libmpdclient
version=2.25
release=1
source=(https://github.com/MusicPlayerDaemon/libmpdclient/archive/v$version.tar.gz)
renames=(name-2.25.tar.gz)

pkg_build() {
	venom-meson build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

}
