# Depends: python3-setuptools python3-gpep517 python3-installer
description="Efficient binary serialization format"
homepage="https://pypi.org/project/msgpack/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-msgpack
version=1.2.4
release=1
source=(https://files.pythonhosted.org/packages/source/m/msgpack/msgpack-$version.tar.gz)
renames=(python3-msgpack-1.2.4.tar.gz)

pkg_build() {
	if [ -d msgpack-$version ]; then
		cd msgpack-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
