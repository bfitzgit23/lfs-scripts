name=linux-pam
version=1.7.2
release=1
# 1.7.x is meson-only: the autotools flags this port used for 1.5.3 map onto
# meson options. --disable-regenerate-docu becomes docs=disabled and
# --enable-securedir=/lib/security becomes securedir; the extension already
# passes --prefix=/usr and --libdir=/usr/lib to meson setup.
source=(https://github.com/$name/$name/releases/download/v$version/Linux-PAM-$version.tar.xz
	other
	system-account
	system-auth
	system-password
	system-session)
build_opt="-D docs=disabled -D securedir=/lib/security"

post_build() {
	# The helper goes to sbindir, i.e. /usr/sbin. The old autotools path here
	# was $PKG/sbin, which never existed, so the setuid bit was never set.
	chmod -v 4755 $PKG/usr/sbin/unix_chkpwd || return $?

	install -v -m755 -d $PKG/etc/pam.d || return $?
	for i in other system-account system-auth system-password system-session; do
		install -m644 $SRC/$i $PKG/etc/pam.d/$i || return $?
	done
}
