# Depends: python3-pytz python3-setuptools python3-gpep517 python3-wheel
description="A collection of tools for internationalizing Python applications"
homepage="http://babel.pocoo.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-babel
version=2.18.0
release=1
source="https://github.com/python-babel/babel/archive/v$version/$name-$version.tar.gz"


pkg_build() {
  if [ -d babel-$version ]; then
  	cd babel-$version
  fi

	/usr/bin/python3 setup.py import_cldr
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl

}
