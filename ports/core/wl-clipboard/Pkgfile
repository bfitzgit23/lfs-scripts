# Depends: meson wayland-protocols
description="Wayland clipboard utilities"
homepage="https://github.com/bugaevc/wl-clipboard/archive/refs/tags/v2.1.0.tar.gz"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=wl-clipboard
version=2.3.0
release=1
source=(https://github.com/bugaevc/$name/archive/refs/tags/v$version.tar.gz)
renames=(wl-clipboard-2.3.0.tar.gz)


pkg_build() {
	venom-meson $SRC/$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
