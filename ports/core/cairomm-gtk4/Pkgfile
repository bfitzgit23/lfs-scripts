# Depends: cairo libsigc++3
description="Provides a C++ interface to Cairo"
homepage="https://www.cairographics.org/cairomm/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=cairomm-gtk4
nm=cairomm
version=1.18.1
release=1
source=(https://cairographics.org/releases/$nm-$version.tar.xz)
renames=(cairomm-gtk4-1.18.1.tar.xz)

pkg_build() {
	venom-meson $nm-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
