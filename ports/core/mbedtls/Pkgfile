# Depends: cmake ninja python3
description="Cryptographic library for embedded systems"
homepage="https://tls.mbed.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mbedtls
version=3.6.6
release=1
_framework=893ad9e8450a8e7459679d952abd5d6df26c41c4
source="https://github.com/ARMmbed/mbedtls/archive/v$version/$name-$version.tar.gz
	https://github.com/Mbed-TLS/mbedtls-framework/archive/$_framework/mbedtls-framework-$_framework.tar.gz"

pkg_build() {
	rm -rf $name-$version/framework
	mv mbedtls-framework-$_framework $name-$version/framework

	cmake -S $name-$version -B build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-D USE_SHARED_MBEDTLS_LIBRARY=ON \
		-D USE_STATIC_MBEDTLS_LIBRARY=ON \
		-D INSTALL_MBEDTLS_HEADERS=ON \
		-D MBEDTLS_FATAL_WARNINGS=OFF \
		-D ENABLE_TESTING=OFF \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
