# Depends: python3-setuptools-scm python3-gpep517 python3-wheel
description="Plugin and hook calling mechanisms for python"
homepage="https://github.com/pytest-dev/pluggy"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pluggy
version=1.7.0
release=1
source="https://files.pythonhosted.org/packages/source/p/pluggy/pluggy-$version.tar.gz"

pkg_build() {
	if [ -d pluggy-$version ]; then
		cd pluggy-$version
	fi


	SETUPTOOLS_SCM_PRETEND_VERSION="$version" \
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" \
		.dist/*.whl

}
