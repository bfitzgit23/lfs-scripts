# Depends: meson mm-common
description="Implements a typesafe callback system for standard C++"
homepage="https://libsigcplusplus.github.io/libsigcplusplus/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libsigc++3
bname=libsigc++
version=3.8.1
release=1
source=(https://github.com/libsigcplusplus/libsigcplusplus/archive/$version.tar.gz)
renames=(libsigc++3-3.8.1.tar.gz)

pkg_build() {
	venom-meson libsigcplusplus-$version build \
		-Dbuild-documentation=false \
		-Dbuild-examples=false \
		-Dbuild-tests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
