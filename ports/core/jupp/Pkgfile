description="Portable version of JOE’s Own Editor"
homepage="https://www.mirbsd.org/jupp.htm"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=jupp
version=3.1jupp41
release=1
source=(http://www.mirbsd.org/MirOS/dist/jupp/joe-$version.tgz)
renames=(jupp-3.1jupp41.tar.gz)

pkg_build() {
	if [ -d $name ]; then cd $name; fi
	chmod +x configure
	./configure --prefix=/usr \
		sysconfdir=/etc
	make
	make DESTDIR=$PKG install
}
