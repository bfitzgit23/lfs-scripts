description="Fast merging drop-in replacement for slocate"
homepage="https://pagure.io/mlocate"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mlocate
version=0.26
release=2
source=(https://deb.debian.org/debian/pool/main/m/mlocate/mlocate_$version.orig.tar.gz
	mlocate 
	updatedb.conf)

pkg_build() {
	sed -i '/^groupname /s/mlocate/locate/' Makefile.in
	./configure --prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var/lib \
		--disable-nls
	make
	make DESTDIR=$PKG install

	install -D -m 0755 $SRC/mlocate $PKG/etc/cron/daily/mlocate
	install -m 0644 $SRC/updatedb.conf $PKG/etc
}

