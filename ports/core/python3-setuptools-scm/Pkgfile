# Depends: python3-setuptools python3-packaging python3-wheel python3-gpep517
description="Handles managing your python package versions in scm metadata"
homepage="https://github.com/pypa/setuptools_scm"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-setuptools-scm
version=10.3.4
release=1
source=(https://files.pythonhosted.org/packages/source/s/setuptools_scm/setuptools_scm-$version.tar.gz)
renames=(python3-setuptools-scm-10.3.4.tar.gz)

pkg_build() {
	if [ -d setuptools_scm-$version ]; then
		cd setuptools_scm-$version
	fi
	
gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
python3 -m installer -d $PKG  .dist/*.whl
}
