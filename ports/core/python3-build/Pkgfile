# Depends: python3-packaging python3-gpep517 python3-pyproject-hooks
description="A simple, correct PEP517 package builder"
homepage="https://github.com/pypa/build"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-build
version=1.6.1
release=1
source=(https://github.com/pypa/build/archive/refs/tags/$version/py3-build-$version.tar.gz)
renames=(python3-build-1.6.1.tar.gz)

pkg_build() {
  cd build-$version

		gpep517 build-wheel \
			--wheel-dir .dist \
			--output-fd 3 3>&1 >&2

		python3 -m installer -d $PKG \
			.dist/build*.whl		
}
