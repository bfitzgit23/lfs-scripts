# Depends: python3-setuptools python3-gpep517 python3-installer
description="Pure python module for (de)serialization to and from VDF that works just like json"
homepage="https://github.com/ValvePython/vdf"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-vdf
version=3.4
release=1
source=(https://pypi.python.org/packages/source/v/vdf/vdf-$version.tar.gz)
renames=(python3-vdf-3.4.tar.gz)

pkg_build() {
	if [ -d vdf-$version ]; then
		cd vdf-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
	chmod 644 $PKG/usr/lib/python3.*/site-packages/vdf-$version-*/*
}
