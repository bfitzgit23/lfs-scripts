# Depends: python3-setuptools python3-gpep517 python3-installer
description="Python bindings for the Linux input subsystem "
homepage="https://github.com/gvalkov/python-evdev"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-evdev
version=2.0.0
release=1
source=(https://github.com/gvalkov/python-evdev/archive/refs/tags/v$version.tar.gz)
renames=(python3-evdev-2.0.0.zip)

pkg_build() {
  if [ -d python-evdev-$version ]; then
    cd python-evdev-$version
  fi
  gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
  python3 -m installer -d $PKG .dist/*.whl
}
