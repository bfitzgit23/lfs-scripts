description="Get information about a class and its structure"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
homepage="https://search.cpan.org/dist/Class-Inspector" 

name=perl-class-inspector
version=1.36
release=1
source=(https://search.cpan.org/CPAN/authors/id/P/PL/PLICEASE/Class-Inspector-$version.tar.gz)
renames=(perl-class-inspector-1.36.tar.gz)

pkg_build() {
	if [ -d Class-Inspector-$version ]; then
		cd Class-Inspector-$version
	fi
	perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
}
