name=python
version=3.14.7
release=1
source=(https://www.$name.org/ftp/$name/$version/Python-$version.tar.xz
	Python-3.14.7-openssl_4-1.patch
	pyconfig.h)
build_opt="--without-ensurepip
	--enable-shared
	--with-system-expat
	--with-system-ffi
	--enable-optimizations"

bootstrap_opt="--without-ensurepip"

pre_build() {
	# OpenSSL 4.0 removed SSLv3_method()/TLSv1_method()/TLSv1_1_method()/
	# TLSv1_2_method(), made ASN1_STRING opaque and constified several X509
	# accessors, so Modules/_ssl.c in 3.14.7 no longer compiles against it.
	# This is the LFS 13.1 backport of the upstream fixes ("openssl_4"). It
	# needs no explicit patch call here: the extension's _patch() walks
	# source=() and applies it from $SRC before this runs, i.e. still before
	# the tests are removed (the patch also touches Lib/test/test_ssl.py).
	# Patching it again from $PKGMK_SOURCE_DIR only fails, because pkgmk keeps
	# port-local files in $SRC and never in $PKGMK_SOURCE_DIR: download_source()
	# resolves a source entry without a URL to the bare filename (a file in the
	# port directory) and unpack_source() copies it into $PKGMK_WORK_DIR/src.

	# make's module check loads every extension module and reports nothing when
	# one of them segfaults: the whole build dies with "Makefile:
	# checksharedmods: Segmentation fault" and no module name. Run it with
	# --debug, which logs each module and its path before importing it, and
	# with faulthandler, which dumps the Python stack on the crash.
	sed -i 's|^	@$(RUNSHARED) $(PYTHON_FOR_BUILD) $(srcdir)/Tools/build/check_extension_modules.py$|	@$(RUNSHARED) $(PYTHON_FOR_BUILD) -X faulthandler $(srcdir)/Tools/build/check_extension_modules.py --debug|' Makefile.pre.in
	export PYTHONFAULTHANDLER=1

	# Remove tests
	rm -rvf Lib/test Lib/*/test Lib/*/tests Lib/*/idle_test
}

post_build() {
	mv $PKG/usr/include/python${version%.*}/pyconfig.h \
	   $PKG/usr/include/python${version%.*}/pyconfig-64.h
	install -m 0644 $SRC/pyconfig.h $PKG/usr/include/python${version%.*}/
	ln -s python3 $PKG/usr/bin/python
}
