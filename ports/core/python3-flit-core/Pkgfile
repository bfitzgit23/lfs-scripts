# Depends: python3-installer
description="Simplified packaging of Python modules"
homepage="https://github.com/takluyver/flit"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-flit-core
version=4.2.0
release=1
source=(https://github.com/takluyver/flit/archive/$version/flit-$version.tar.gz
	vendor-licence.patch.manual)
renames=(python3-flit-core-4.2.0.tar.gz SKIP)

pkg_build() {
	# pkgmk already cd's into the extracted flit-$version directory before it
	# calls pkg_build, so every path here is relative to that directory.
	rm -f tests/test_sdist.py
	cd flit_core || return 1

	# flit_core 4.2.0 raises ConfigError for a [project.license-files] glob
	# that matches nothing, and vendor/ is dropped below.  The automatic
	# *.patch pass cannot do this: from the tarball root pyproject.toml is
	# flit's own project file, not flit_core's.
	if ! grep -q 'license-files = \["LICENSE\*"\]' pyproject.toml; then
		patch -Np1 -i $SRC/vendor-licence.patch.manual || return 1
	fi

	rm -rf flit_core/vendor/
	python3 build_dists.py || return 1
	python3 -m installer -d "$PKG" \
		dist/flit_core-$version-py3-none-any.whl || return 1
}
