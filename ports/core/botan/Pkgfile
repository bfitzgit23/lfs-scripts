# Depends: sqlite xz
description="Crypto and TLS for Modern C++"
homepage="https://botan.randombit.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=botan
version=3.12.0
release=1
source=(https://botan.randombit.net/releases/Botan-$version.tar.xz)
renames=(botan-3.12.0.tar.xz)

pkg_build() {
	cd Botan-$version

	/usr/bin/python3 ./configure.py --prefix=/usr \
		--with-bzip \
		--with-zlib \
		--with-sqlite3 \
		--with-os-feature=getrandom
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share
}
