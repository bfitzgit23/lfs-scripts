# Depends: python3-gpep517 python3-flit-core
description="General parsing module for Python"
homepage="https://github.com/pyparsing/pyparsing/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pyparsing
version=3.3.3
release=1
source=(https://files.pythonhosted.org/packages/source/p/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-pyparsing-3.3.3.tar.gz)

pkg_build() {
	cd ${name#*-}-$version
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl
}
