description="utility to manage SSH and GPG keys in a convenient and secure manner"
homepage="https://www.funtoo.org/Keychain"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=keychain
version=2.9.8
release=1
source=(https://github.com/funtoo/keychain/archive/refs/tags/$version.tar.gz)
renames=(keychain-2.9.8.tar.gz)

pkg_build() {
	make
	mkdir -p "$PKG"/usr/bin
	cp keychain $PKG/usr/bin/
	mkdir -p "$PKG"/usr/share/man/1
	cp keychain.1 "$PKG"/usr/share/man/1/
}
