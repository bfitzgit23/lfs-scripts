# Depends: python3-installer python3-wheel
description="Icon extractor for Windows PE files (.exe/.dll) with optional thumbnailer functionality"
homepage="https://github.com/jlu5/icoextract"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=icoextract
version=0.3.0
release=1
source="$name-$version.tar.gz::https://github.com/jlu5/icoextract/archive/refs/tags/$version.tar.gz"

pkg_build() {
	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir="${PKG}" dist/*.whl
}
