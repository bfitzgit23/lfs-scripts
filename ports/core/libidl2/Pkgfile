# Depends: glib texinfo
description="A front-end for CORBA 2.2 IDL and Netscape's XPIDL"
homepage="http://www.gnome.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libidl2
version=0.8.14
release=1
source=(https://ftp.gnome.org/pub/gnome/sources/libIDL/${version%.*}/libIDL-$version.tar.bz2)
renames=(libidl2-0.8.14.tar.bz2)

pkg_build() {
	cd libIDL-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install

}
