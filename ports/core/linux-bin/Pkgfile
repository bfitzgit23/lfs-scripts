# Depends on: mkinitramfs
description="Linux kernel, Arch Linux prebuilt image and modules (no compile)"
homepage="https://archlinux.org/packages/core/x86_64/linux/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=linux-bin
version=7.3.4
release=1

# This is Arch Linux's own 7.3.4 build, so a machine never has to spend 30-60
# minutes compiling the kernel. pkgmk has no unpack rule for a .pkg.tar.zst, so
# the archive is only copied into $SRC and unpacked in pkg_build. Arch keeps the
# kernel image inside the module directory, so it is installed as
# /boot/vmlinuz-linux too, where this distribution's boot loader looks for it.
source=(https://geo.mirror.pkgbuild.com/core/os/x86_64/linux-7.3.4.arch1-2-x86_64.pkg.tar.zst)

pkg_build() {
	cd "$SRC" || return 1

	archive=$(ls *.pkg.tar.zst 2>/dev/null | head -n1)
	if [ -z "$archive" ]; then
		echo "$name: no Arch package in $SRC" >&2
		return 1
	fi

	bsdtar -xf "$archive" || return 1
	rm -f "$archive" .PKGINFO .BUILDINFO .MTREE .INSTALL .Changelog

	kver=$(ls usr/lib/modules | head -n1)
	install -Dm644 usr/lib/modules/$kver/vmlinuz boot/vmlinuz-linux

	# boot entry for grub-mkconfig
	install -d $PKG/etc/grub.d
	cat > $PKG/etc/grub.d/40_linux-bin <<'EOT'
#!/bin/sh
# Boot entry for the linux-bin kernel, read by grub-mkconfig.
set -e

. /usr/share/grub/grub-mkconfig_lib

img=/boot/vmlinuz-linux
[ -f "$img" ] || exit 0

kver=@KVER@

initrd=/boot/initrd-$kver.img
[ -f "$initrd" ] || initrd=/boot/initrd.img
[ -f "$initrd" ] || initrd=

echo "menuentry \"StormFS (linux-bin $kver)\" --class linux --class os {"
prepare_grub_to_access_device "$(grub-probe -t device /boot)" | sed "s/^/\t/"
echo "\tlinux $(grub-mkrelpath "$img") root=UUID=$(grub-probe -t fs_uuid /) rw ${GRUB_CMDLINE_LINUX}"
if [ -n "$initrd" ]; then
	echo "\tinitrd $(grub-mkrelpath "$initrd")"
fi
echo "}"
EOT
	sed -i "s|@KVER@|$kver|g" $PKG/etc/grub.d/40_linux-bin
	chmod 755 $PKG/etc/grub.d/40_linux-bin

	for f in *; do
		mv "$f" "$PKG"/
	done
}
