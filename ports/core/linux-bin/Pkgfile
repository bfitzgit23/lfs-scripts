# Depends on: mkinitramfs
description="Linux kernel, prebuilt image and modules (no compile)"
homepage="https://www.kernel.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=linux-bin
version=7.3.4
release=1

# This port ships the kernel the `linux` port builds, so a machine never has to
# spend 30-60 minutes compiling one. There is no URL on purpose: build `linux`
# once on a machine with a toolchain, then pack the result.
#
#   prt-get install linux
#   tar -cJpf linux-bin-7.3.4-1.tar.xz -C / \
#           boot/vmlinuz-linux boot/config-linux lib/modules/7.3.4-LFS
#
# Copy that tarball into PKGMK_SOURCE_DIR (the port directory, unless
# /etc/pkgmk.conf says otherwise) on every machine that should install the
# kernel without building it. Give source= a URL if you publish it instead.
source=($name-$version-$release.tar.xz)

pkg_build() {
	cd "$SRC" || return 1

	if [ ! -d boot ] || [ ! -d lib ]; then
		echo "$name: $SRC has no boot/ and lib/, see the tarball recipe above" >&2
		return 1
	fi

	mv boot lib "$PKG"/
}
