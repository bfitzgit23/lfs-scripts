# Depends on: mkinitramfs
description="Linux kernel, prebuilt image and modules (no compile)"
homepage="https://www.kernel.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=linux-bin
version=7.3.4
release=1

# This port repackages the kernel the `linux` port built, so a machine
# never has to spend 30-60 minutes compiling one. Nothing is downloaded:
# build `linux` once, then drop the package pkgmk produced next to this
# Pkgfile on every machine that should install the kernel without building it.
#
#   prt-get install linux
#   cp /var/cache/pkg/packages/linux#7.3.4-1.pkg.tar.xz /usr/ports/core/linux-bin/
#
# pkgmk only looks for a source without a URL in the port directory itself.
source=(linux#7.3.4-1.pkg.tar.xz)

pkg_build() {
	cd "$SRC" || return 1

	if [ ! -f .PKGINFO ]; then
		echo "$name: $SRC is not a built linux package, see the header" >&2
		return 1
	fi

	# drop the package metadata, pkgmk writes its own
	for f in *; do
		mv "$f" "$PKG"/
	done
}
