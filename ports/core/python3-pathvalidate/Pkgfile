# Depends: python3-setuptools python3-gpep517 python3-wheel
description="Sanitize/validate strings in filenames/file-paths/etc"
homepage="https://github.com/thombashi/pathvalidate"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pathvalidate
version=3.3.1
release=1
source=(https://github.com/thombashi/pathvalidate/releases/download/v$version/pathvalidate-$version.tar.gz)
renames=(python3-pathvalidate-3.3.1.tar.gz)


pkg_build() {
	cd pathvalidate-$version
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl
}
