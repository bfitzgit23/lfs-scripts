# Depends: python3-setuptools python3-gpep517 python3-installer
description="Python Lex & Yacc"
homepage="https://pypi.org/project/ply/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-ply
version=3.11
release=3
source=(https://files.pythonhosted.org/packages/e5/69/882ee5c9d017149285cab114ebeab373308ef0f874fcdac9beb90e0ac4da/ply-$version.tar.gz)
renames=(python3-ply-3.11.tar.gz)

pkg_build() {
	if [ -d ${name##python3-}-$version ]; then cd ${name##python3-}-$version; fi

	    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG .dist/*.whl

	    find $PKG/usr/lib/python*/site-packages/ \
		    -maxdepth 1 \
		    -type f \
		    -name "${name#*-}-$version-py*.egg-info" \
		    -delete
}
