# Depends: bubblewrap cairo enchant flite gst-plugins-bad harfbuzz libjxl libnotify libseccomp libsecret libsoup3 libwebp openjpeg2 ruby unifdef which wpebackend-fdo xdg-dbus-proxy gtk3
description="Web content engine for GTK"
homepage="https://webkitgtk.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=webkitgtk
version=2.52.4
release=1
source="https://webkitgtk.org/releases/$name-$version.tar.xz"

pkg_build() {
	# ccache
	PATH="$(echo ${PATH} | awk -v RS=: -v ORS=: '/ccache/ {next} {print}' | sed 's/:*$//')"

	# build with GCC
	export CC=gcc CXX=g++

	export CFLAGS="-O2 -pipe -march=x86-64 -fno-lto"
	export CXXFLAGS="-O2 -pipe -march=x86-64 -std=gnu++20 -fno-lto -Wno-error"

	# clean build cache
	rm -rf build

	# ICU 76 fix
	sed '/U_SHOW_CPLUSPLUS_API/a#define U_SHOW_CPLUSPLUS_HEADER_API 0' \
		-i $name-$version/Source/WTF/wtf/Platform.h

	cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_SKIP_INSTALL_RPATH=ON \
		-DPORT=GTK \
		-DENABLE_JIT=OFF \
		-DENABLE_GAMEPAD=OFF \
		-DENABLE_JOURNALD_LOG=OFF \
		-DENABLE_DOCUMENTATION=OFF \
		-DENABLE_GEOLOCATION=OFF \
		-DENABLE_MINIBROWSER=ON \
		-DUSE_AVIF=OFF \
		-DUSE_GTK4=OFF \
		-DUSE_LIBBACKTRACE=OFF \
		-DUSE_LIBHYPHEN=OFF \
		-DUSE_SOUP2=OFF \
		-DUSE_WOFF2=OFF \
		-DUSE_SYSTEM_SYSPROF_CAPTURE=NO \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
