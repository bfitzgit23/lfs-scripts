# Depends: gdk-pixbuf libx11
description="Deprecated Xlib integration for GdkPixbuf"
homepage="https://gitlab.gnome.org/Archive/gdk-pixbuf-xlib"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gdk-pixbuf-xlib
version=2.40.2
release=1
source="https://gitlab.gnome.org/Archive/$name/-/archive/$version/$name-$version.tar.bz2"

pkg_build() {

	venom-meson $SRC/$name-$version build 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
