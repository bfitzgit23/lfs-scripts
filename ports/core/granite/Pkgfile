# Depends: cairo gdk-pixbuf glib gtk3 libgee pango gobject-introspection meson vala
description="Library that extends Gtk+"
homepage="https://github.com/elementary/granite"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=granite
version=7.8.1
release=1
source=(https://github.com/elementary/granite/archive/refs/tags/$version.tar.gz)
renames=(granite-7.8.1.tar.gz)

pkg_build() {
	
	venom-meson $name-$version build -Ddemo=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}

