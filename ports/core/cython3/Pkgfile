# Depends: python3 python3-gpep517 python3-installer python3-setuptools
description="C-Extensions for Python3"
homepage="https://cython.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=cython3
version=3.2.6
release=2
source=(https://github.com/cython/cython/archive/$version.tar.gz)
renames=(cython3-3.2.6.tar.gz)

pkg_build() {
	# build() already enters the extracted tree when the archive has a top-level directory,
	# so only cd when it did not.
	if [ -d cython-$version ]; then
		cd cython-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
