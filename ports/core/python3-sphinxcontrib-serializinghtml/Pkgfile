# Depends: python3-gpep517 python3-flit-core python3-setuptools
description="sphinx extension which outputs "serialized" HTML files (json and pickle)"
homepage="https://github.com/sphinx-doc/sphinxcontrib-serializinghtml/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-sphinxcontrib-serializinghtml
version=2.0.0
release=2
source=(https://github.com/sphinx-doc/${name#*-}/archive/$version/${name#*-}-$version.tar.gz)
renames=(python3-sphinxcontrib-serializinghtml-2.0.0.tar.gz)

pkg_build() {

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}
