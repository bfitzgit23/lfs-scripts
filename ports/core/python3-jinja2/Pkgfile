# Depends: python3-gpep517 python3-wheel python3-flit-core
description="A simple pythonic template language written in Python"
homepage="https://palletsprojects.com/p/jinja/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-jinja2
version=3.1.6
release=1
source=(https://github.com/pallets/jinja/archive/refs/tags/$version.tar.gz)
renames=(python3-jinja2-3.1.6.tar.gz)

pkg_build() {
	if [ -d jinja-$version ]; then
		cd jinja-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" .dist/*.whl
}
