# Depends: python3-gpep517 python3-setuptools
description="Python 3.x SIP bindings for C and C++ libraries (PyQt5 version)"
homepage="https://www.riverbankcomputing.com/software/sip/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-sip-pyqt5
version=12.20.1
release=1
source=(https://pypi.python.org/packages/source/P/PyQt5-sip/pyqt5_sip-$version.tar.gz)
renames=(python3-sip-pyqt5-12.20.1.tar.gz)

pkg_build() {
	if [ -d pyqt5_sip-$version ]; then
		cd pyqt5_sip-$version
	fi

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}
