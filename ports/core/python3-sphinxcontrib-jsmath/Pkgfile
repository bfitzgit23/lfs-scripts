# Depends: python3-setuptools python3-gpep517 python3-installer
description="sphinx extension which renders display math in HTML via JavaScript"
homepage="https://github.com/sphinx-doc/sphinxcontrib-jsmath/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-sphinxcontrib-jsmath
version=2.0.0
release=2
source=(https://github.com/sphinx-doc/${name#*-}/archive/$version/${name#*-}-$version.tar.gz)
renames=(python3-sphinxcontrib-jsmath-2.0.0.tar.gz)

pkg_build() {

	sed -i '/^tag_build =/s/= .*$/=/' setup.cfg
	sed -i '/^tag_date =/s/true/false/' setup.cfg

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl

	chmod -R go-w,a+r,u+w $PKG
}
