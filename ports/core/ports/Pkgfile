name=ports
version=1.7
release=3
source=(https://crux.nu/files/tools/ports/$name-$version.tar.gz
	repokey.pub
	git-driver
	core.httpup
	extra.httpup
	contrib.httpup
	multilib.httpup
	opt.httpup
	nonfree.httpup
	mate.httpup
	xfce.httpup
	kde-lxqt.httpup
	s6.httpup
	venom-core.git
	venom-community.git
	venom-multilib.git
	venom-nonfree.git
	venom-mate.git
	venom-kde-lxqt.git
	venom-xfce.git
	venom-s6.git)

post_build() {
	# ports(8) picks a collection up by matching the driver name to the
	# config suffix, so the git driver is what enables `ports -u` below.
	install -D -m 0755 $SRC/git-driver $PKG/etc/ports/drivers/git

	# httpup collections: every port tree this repository ships, served from
	# the fixed trees in this repository (each tree carries its own REPO
	# index, regenerated by ports/repgen.sh).
	for collection in core extra contrib multilib opt nonfree mate xfce kde-lxqt s6; do
		install -m 0644 $SRC/$collection.httpup $PKG/etc/ports/
	done

	# venomlinux collections, synchronised with git
	for collection in core community multilib nonfree mate kde-lxqt xfce s6; do
		install -m 0644 $SRC/venom-$collection.git $PKG/etc/ports/
	done
}
