name=ports
version=1.6
release=3
source=(https://crux.nu/files/tools/ports/$name-$version.tar.gz
	repokey.pub
	git-driver
	venom-core.git
	venom-community.git
	venom-multilib.git
	venom-nonfree.git
	venom-mate.git
	venom-kde-lxqt.git
	venom-xfce.git
	venom-s6.git)

post_build() {
	# ports(8) picks a collection up by matching the driver name to the
	# config suffix, so the git driver is what enables `ports -u` below.
	install -D -m 0755 $SRC/git-driver $PKG/etc/ports/drivers/git

	# venomlinux collections, synchronised with git
	for collection in core community multilib nonfree mate kde-lxqt xfce s6; do
		install -m 0644 $SRC/venom-$collection.git $PKG/etc/ports/
	done
}
