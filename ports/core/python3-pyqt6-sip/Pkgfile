# Depends: python3-build python3-installer python3-setuptools python3-wheel
description="The sip module support for PyQt6"
homepage="https://pypi.org/project/PyQt6-sip/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pyqt6-sip
version=13.13.1
release=1
source=(https://pypi.python.org/packages/source/P/PyQt6-sip/pyqt6_sip-$version.tar.gz)
renames=(python3-pyqt6-sip-13.13.1.tar.gz)

pkg_build() {
	if [ -d pyqt6_sip-$version ]; then
		cd pyqt6_sip-$version
	fi
	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir=$PKG dist/*.whl
}
