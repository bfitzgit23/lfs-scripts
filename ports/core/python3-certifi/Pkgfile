# Depends: python3-setuptools python3-gpep517  python3-wheel
description="Python package for providing Mozilla's CA Bundle"
homepage="https://github.com/certifi/python-certifi"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-certifi
version=2026.10.23
release=1
source=(https://pypi.io/packages/source/c/certifi/certifi-$version.tar.gz)
renames=(python3-certifi-2026.10.23.tar.gz)

pkg_build() {
	
	cd certifi-$version

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" \
		.dist/*.whl


}
