# Depends: qt6-base
description="Provides access to hardware and virtual serial ports"
homepage="https://www.qt.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=qt6-serialport
version=6.11.1
release=1
source=(https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtserialport-everywhere-src-$version.tar.xz)
renames=(qt6-serialport-6.11.1.tar.xz)

pkg_build() {
	cmake -S qtserialport-everywhere-src-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DQT_USE_CCACHE=$(scratch isinstalled ccache && printf "ON" || printf "OFF") \
		-DINSTALL_PUBLICBINDIR=usr/bin
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
