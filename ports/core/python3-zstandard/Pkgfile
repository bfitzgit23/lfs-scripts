# Depends: python3-setuptools python3-gpep517 python3-installer
description="Python bindings to the Zstandard (zstd) compression library"
homepage="https://github.com/indygreg/python-zstandard"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-zstandard
version=0.25.0
release=1
source=(https://github.com/indygreg/python-zstandard/archive/$version.tar.gz)
renames=(python3-zstandard-0.25.0.tar.gz)

pkg_build() {
	if [ -d python-zstandard-$version ]; then
		cd python-zstandard-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
