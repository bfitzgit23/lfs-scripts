# Depends: dbus-glib libxml2 gtk3 polkit gobject-introspection
description="Configuration database system used by many GNOME applications"
homepage="https://ftp.gnome.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gconf
version=3.2.6
release=3
source=(https://ftp.gnome.org/pub/gnome/sources/GConf/${version%.*}/GConf-$version.tar.xz)
renames=(gconf-3.2.6.tar.xz)

pkg_build() {
	if [ -d GConf-$version ]; then
		cd GConf-$version
	fi

	# fix build with GCC 14
	export CFLAGS="${CFLAGS} -Wno-incompatible-pointer-types"
	./configure --prefix=/usr \
	            --sysconfdir=/etc \
		    --libexecdir=/usr/lib/$name \
	            --disable-orbit \
	            --disable-static
	make
	make DESTDIR=$PKG install

	ln -s gconf.xml.defaults \
	      $PKG/etc/gconf/gconf.xml.system

}
