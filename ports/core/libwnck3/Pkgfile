# Depends: gtk3 startup-notification gobject-introspection meson
description="Window Navigator Construction Kit"
homepage="https://gitlab.gnome.org/GNOME/libwnck"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libwnck3
version=43.3
release=1
source="https://gitlab.gnome.org/GNOME/libwnck/-/archive/$version/libwnck-$version.tar.gz"

pkg_build() {
	venom-meson $SRC/libwnck-$version build -Dgtk_doc=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
