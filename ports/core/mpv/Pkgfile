# Depends: ffmpeg luajit libcdio-paranoia libxpresent libxscrnsaver libplacebo mesa
description="A free, open source, and cross-platform media player"
homepage="https://mpv.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mpv
version=0.41.0
release=2
source=(https://github.com/mpv-player/mpv/archive/v$version/$name-$version.tar.gz
	0001-clipboard-wayland-prevent-reading-from-hung-up-fd.patch)

pkg_build() {
	patch -d $name-$version -Np1 -i $SRC/0001-clipboard-wayland-prevent-reading-from-hung-up-fd.patch
	venom-meson $name-$version build \
		-D libmpv=true \
		-D libarchive=enabled \
		-D cdda=enabled \
		-D lua=luajit 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
