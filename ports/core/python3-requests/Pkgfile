# Depends: python3-chardet python3-idna python3-urllib3 python3-setuptools python3-gpep517 python3-installer
description="Python HTTP for Humans"
homepage="https://requests.readthedocs.io"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-requests
_name=${name#*-}
_n=${_name%${_name#?}}
version=2.34.2
release=1
source=(https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-requests-2.34.2.tar.gz)

pkg_build() {
	cd ${name#*-}-$version

	sed -e '/certifi/d' -i setup.py

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
