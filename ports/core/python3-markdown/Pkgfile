# Depends: python3-setuptools python3-gpep517
description="Python implementation of markdown"
homepage="https://pypi.org/project/markdown"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-markdown
version=3.11.3
release=1
source=(https://github.com/Python-Markdown/markdown/archive/refs/tags/$version.tar.gz)
renames=(python3-markdown-3.11.3.tar.gz)
pkg_build() {
	cd markdown-$version

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	python3 -m installer -d $PKG \
		.dist/*.whl
}
