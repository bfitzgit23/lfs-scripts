# Depends: libsoup3 python3-tappy python3-gobject3 python3-dbus stemmer json-glib asciidoc
description="Low-footprint RDF triple store with SPARQL 1.1 interface"
homepage="https://tinysparql.org/"
maintainer="CELESTIFYX Team <celestifyx@gmail.com>"

name=tinysparql
version=3.11.1
release=1

source=(https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz
    disable-cli-test.patch
    gh-ci-timeout.patch)
renames=(tinysparql-3.11.1.tar.gz SKIP SKIP)

pkg_build() {
    if [ -d ${name}-${version} ]; then
    	if [ -d ${name}-${version} ]; then cd ${name}-${version}; fi
    fi

    patch -Np1 -i "${SRC}/disable-cli-test.patch"
    patch -Np1 -i "${SRC}/gh-ci-timeout.patch"

    venom-meson build \
		-Dtests_tap_protocol=true \
		-Ddocs=false \
		-Dman=true \
		-Dsystemd_user_services=false

    meson compile -C build
    meson install -C build --destdir "${PKG}"
}
