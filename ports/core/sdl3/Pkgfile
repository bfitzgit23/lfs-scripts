# Depends: libx11 libxext libxrandr libxscrnsaver libxfixes libxi libxinerama wayland-protocols cmake libxkbcommon ninja
description="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 2)"
homepage="https://www.libsdl.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sdl3
version=3.4.10
release=1
source=(https://github.com/libsdl-org/SDL/releases/download/release-$version/SDL3-$version.tar.gz)
renames=(sdl3-3.4.10.tar.gz)

pkg_build() {

	CFLAGS="${CFLAGS} -ffat-lto-objects"
	cmake -S SDL3-$version -B build -G Ninja \
			-D CMAKE_BUILD_TYPE=None \
			-D CMAKE_INSTALL_PREFIX=/usr \
			-D SDL_STATIC=OFF \
			-D SDL_RPATH=OFF
	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -r $PKG/usr/share/licenses/
}
