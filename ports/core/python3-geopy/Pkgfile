# Depends: python3-geographiclib python3-gpep517
description="Geocoding library for Python"
homepage="https://github.com/geopy/geopy"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-geopy
nm=geopy
version=2.5.0
release=3
source=(https://github.com/geopy/geopy/archive/$version.tar.gz)
renames=(python3-geopy-2.5.0.tar.gz)

pkg_build() {
	if [ -d $nm-$version ]; then
		if [ -d $nm-$version ]; then cd $nm-$version; fi
	fi
	    gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	    python3 -m installer -d $PKG \
		    .dist/*.whl
}
