# Depends: cmake ninja
description="C library for x86 CPU detection and feature extraction"
homepage="https://github.com/anrieff/libcpuid"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libcpuid
version=0.8.2
release=1
source="https://github.com/anrieff/libcpuid/releases/download/v$version/$name-$version.tar.gz"

pkg_build() {
         cmake -S $SRC/$name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DLIBCPUID_ENABLE_DOCS=OFF \
		-DLIBCPUID_BUILD_DRIVERS=OFF \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
