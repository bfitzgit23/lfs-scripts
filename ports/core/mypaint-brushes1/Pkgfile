# Depends: libmypaint
description="Brushes used by MyPaint and other software using libmypaint (v1.x)"
homepage="https://github.com/mypaint/mypaint-brushes"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=mypaint-brushes1
version=1.3.1
release=2
source="https://github.com/mypaint/mypaint-brushes/archive/v${version}/${name}-${version}.tar.gz"

pkg_build() {
	if [ -d ${name%1}-$version ]; then cd ${name%1}-$version; fi

	autoreconf -fiv
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
