# Depends: python3-setuptools python3-toml python3-gpep517 python3-installer
description="Cheap builder for pyproject-based build systems"
homepage="https://github.com/mgorny/pyproject2setuppy"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pyproject2setuppy
version=22
release=1
source=(https://github.com/mgorny/pyproject2setuppy/archive/v$version/pyproject2setuppy-$version.tar.gz)
renames=(python3-pyproject2setuppy-22.tar.gz)

pkg_build() {
	cd pyproject2setuppy-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
