# Depends: python3 python3-gpep517 python3-installer python3-setuptools
description="Python3 compatibility library"
homepage="https://pypi.python.org/pypi/six/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-six
version=1.17.0
release=1
source=(https://pypi.io/packages/source/s/six/six-$version.tar.gz)
renames=(python3-six-1.17.0.tar.gz)

pkg_build() {
	if [ -d six-$version ]; then
		cd six-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
