# Depends: libx11 libxext libxfixes libxrandr
description="Xlib-based library for the X Present Extension"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxpresent"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
_name=libXpresent

name=libxpresent
version=1.0.2
release=1
source=(https://www.x.org/archive/individual/lib/$_name-$version.tar.xz)
renames=(libxpresent-1.0.2.tar.xz)

pkg_build() {
	if [ -d $_name-$version ]; then
		if [ -d $_name-$version ]; then cd $_name-$version; fi
	fi
	./configure \
		--prefix=/usr \
		--libexecdir /usr/lib \
		--disable-static
	make
	make DESTDIR=$PKG install
}
