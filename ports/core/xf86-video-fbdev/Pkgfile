# Depends: xorg-server xorgproto
description="X.org framebuffer video driver"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xf86-video-fbdev
version=0.5.1
release=1
source="http://ftp.x.org/pub/individual/driver/$name-$version.tar.xz"

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
