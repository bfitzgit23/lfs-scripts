# Depends: clang
description="General-purpose scalable concurrent malloc implementation"
homepage="http://www.canonware.com/jemalloc/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=jemalloc
version=5.3.1
release=2
source="https://github.com/jemalloc/jemalloc/releases/download/$version/$name-$version.tar.bz2"

pkg_build() {
	./configure \
		--prefix=/usr \
		--disable-cxx \
		--enable-prof \
		--enable-autogen
	make
	make DESTDIR=$PKG install
}
