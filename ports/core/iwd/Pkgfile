# Depends: readline dbus
description="Wireless daemon for Linux"
homepage="https://iwd.wiki.kernel.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=iwd
version=3.12
release=1
source=(https://www.kernel.org/pub/linux/network/wireless/$name-$version.tar.xz
	run.$name
	rc.$name)

pkg_build() {

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/sbin \
		--localstatedir=/var \
		--sysconfdir=/etc \
		--disable-systemd-service

	make
	make DESTDIR=$PKG install

	install -d -m 0700 $PKG/var/lib/iwd
	install -d -m 0700 $PKG/etc/iwd

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run
		ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
	} || continue

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.$name $PKG/etc/rc.d/$name || continue
}
