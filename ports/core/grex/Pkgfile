# Depends: rust
description="A command-line tool for generating regular expressions from user-provided input strings "
homepage="https://github.com/pemistahl/grex"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=grex
version=1.4.6
release=1
source=(https://github.com/pemistahl/grex/archive/v$version.tar.gz)
renames=(grex-1.4.6.tar.gz)

pkg_build() {

	cargo fetch --locked --target "x86_64-unknown-linux-gnu"
	cargo build --frozen --release
	install -D -m 755 target/release/$name -t $PKG/usr/bin
	install -D -m 644 README.md -t $PKG/usr/share/$name
}
