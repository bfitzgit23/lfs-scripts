# Depends: python3-gpep517 python3-flit-core
description="A lil' TOML parser"
homepage="https://github.com/hukkin/tomli"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-tomli
version=2.5.0
release=1
source=(https://github.com/hukkin/tomli/archive/$version/tomli-$version.tar.gz)
renames=(python3-tomli-2.5.0.tar.gz)

pkg_build() {
	cd tomli-$version
	
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	python3 -m installer -d "$PKG" \
		.dist/tomli-$version-py3-none-any.whl


}
