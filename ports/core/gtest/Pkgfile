# Depends: cmake ninja python3
description="Google C++ test utility"
homepage="https://github.com/google/googletest"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gtest
version=1.18.0
release=1
source=(https://github.com/google/googletest/archive/v$version.tar.gz)
renames=(gtest-1.18.0.tar.gz)

pkg_build() {
	cmake -S $SRC/googletest-$version -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=On \
		-DPYTHON_EXECUTABLE=python3 \
		-Dgtest_build_tests=ON \
		-DBUILD_GMOCK=ON
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
