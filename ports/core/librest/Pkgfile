description="Gives more easily access to internet services which says be 'RESTful'"
homepage="http://www.gnome.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=librest
version=0.10.2
release=1

source="https://gitlab.gnome.org/GNOME/librest/-/archive/$version/$name-$version.tar.gz"

pkg_build() {
	venom-meson $SRC/$name-$version build -Dgtk_doc=false -Dvapi=true
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build 
}
