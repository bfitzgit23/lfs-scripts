name=kmod
version=34.2
release=1
source=(https://www.kernel.org/pub/linux/utils/kernel/$name/$name-$version.tar.xz)
build_type=configure_build
# kmod 34 also ships a meson.build. pkgmk tests meson.build first, but the
# base toolchain has no meson and build_opt below is autotools syntax.
build_opt="--disable-manpages --with-openssl --with-xz --with-zlib"

post_build() {
	mkdir -p $PKG/sbin $PKG/bin
	for target in depmod insmod modinfo modprobe rmmod; do
	  ln -s /usr/bin/kmod $PKG/sbin/$target
	done
	
	ln -s kmod $PKG/usr/bin/lsmod
}
