# Depends: sdl2-compat python3-setuptools python3-gpep517 python3-installer
description="Python ctypes wrapper around SDL2"
homepage="https://github.com/py-sdl/py-sdl2"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pysdl2
version=0.9.17
release=2
source=(https://github.com/py-sdl/py-sdl2/archive/refs/tags/$version.tar.gz)
renames=(python3-pysdl2-0.9.17.tar.gz)

pkg_build() {
	if [ -d py-sdl2-$version ]; then
		cd py-sdl2-$version
	fi

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
