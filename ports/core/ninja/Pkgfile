name=ninja
version=1.13.2
release=1
source=(https://github.com/ninja-build/$name/archive/refs/tags/v$version.tar.gz)

# Ninja has no configure script or Makefile: configure.py rebuilds the binary
# from source. LFS 13.1 builds it the same way.
pkg_build() {
	python3 configure.py --bootstrap --verbose || return $?

	install -Dm755 ninja $PKG/usr/bin/ninja || return $?
	install -Dm644 misc/bash-completion $PKG/usr/share/bash-completion/completions/ninja || return $?
	install -Dm644 misc/zsh-completion $PKG/usr/share/zsh/site-functions/_ninja || return $?
}
