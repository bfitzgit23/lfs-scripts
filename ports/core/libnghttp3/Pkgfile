description="Framing layer of HTTP/3 is implemented as a reusable C library"
homepage="https://github.com/ngtcp2/nghttp3"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libnghttp3
version=1.17.0
release=1
source=(https://github.com/ngtcp2/nghttp3/releases/download/v${version}/nghttp3-${version}.tar.xz)
renames=(libnghttp3-1.17.0.tar.xz)

pkg_build() {
	if [ -d nghttp3-$version ]; then
		cd nghttp3-$version
	fi
	autoreconf -i
	  ./configure \
	    --prefix=/usr \
	    --disable-examples \
	    --disable-python-bindings \
	    --enable-lib-only
	make
	make DESTDIR=$PKG install
}
