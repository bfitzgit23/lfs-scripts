# Depends: python3-setuptools python3-gpep517 python3-installer
description="C parser and AST generator written in Python"
homepage="https://pypi.org/project/pycparser/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pycparser
version=3.12
release=1
source=(https://github.com/eliben/${name#*-*}/archive/release_v$version.tar.gz)
renames=(python3-pycparser-3.12.tar.gz)

pkg_build() {
	cd ${name#*-}-release_v$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
