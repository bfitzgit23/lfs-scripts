# Depends: python3-gpep517 python3-setuptools
description="sphinx extension which renders HTML help files"
homepage="https://github.com/sphinx-doc/sphinxcontrib-htmlhelp/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-sphinxcontrib-htmlhelp
_name=sphinxcontrib_htmlhelp
version=2.1.0
release=2
source=(https://pypi.org/packages/source/s/$_name/$_name-$version.tar.gz)
renames=(python3-sphinxcontrib-htmlhelp-2.1.0.tar.gz)

pkg_build() {
	if [ -d $_name-$version ]; then
		if [ -d $_name-$version ]; then cd $_name-$version; fi
	fi

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}
