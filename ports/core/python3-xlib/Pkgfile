# Depends: python3-six python3-setuptools-scm python3-pip python3-gpep517 python3-installer
description="A fully functional X client library for Python programs"
homepage="https://github.com/python-xlib/python-xlib"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-xlib
version=0.33
release=2
source=(https://github.com/python-xlib/python-xlib/archive/$version/python-$version.tar.gz)
renames=(python3-xlib-0.33.tar.gz)

pkg_build() {
	if [ -d python-xlib-$version ]; then
		cd python-xlib-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
