# Depends: bash-completion docbook-xsl itstool libfyaml librsvg libsoup3 libxmlb libxslt lmdb stemmer zstd
description="Provides a standard for creating app stores across distributions"
homepage="https://www.freedesktop.org/wiki/Distributions/AppStream/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=appstream
version=1.1.3
release=1
source=(https://www.freedesktop.org/software/appstream/releases/AppStream-$version.tar.xz)
renames=(appstream-1.1.3.tar.xz)

pkg_build() {
	export XML_CATALOG_FILES=/etc/xml/catalog

	venom-meson $SRC/AppStream-$version build \
		-Ddocs=false \
		-Dapidocs=false \
		-Dinstall-docs=false \
		-Dcompose=true \
		-Dgir=true \
		-Dqt=$(scratch isinstalled qt6-base && printf "true" || printf  "false") \
		-Dvapi=false \
		-Dstemming=false \
		-Dapt-support=false \
		-Dsystemd=false \
		-Dblake3-support=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -rf $PKG/usr/share/installed-tests/
}
