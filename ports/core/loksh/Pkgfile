# Depends: ncurses
description="A Linux port of OpenBSD's ksh"
homepage="https://github.com/dimkr/loksh/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=loksh
version=7.9
release=1
source="https://github.com/dimkr/loksh/releases/download/$version/$name-$version.tar.xz"

pkg_build() {
 	venom-meson $SRC/$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}

