# Depends: python3-setuptools python3-gpep517 python3-installer
description="Snowball stemming library collection for Python."
homepage="https://github.com/shibukawa/snowball_py/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-snowballstemmer
version=3.1.1
release=1
source=(https://pypi.org/packages/source/S/Snowballstemmer/${name#*-}-$version.tar.gz)
renames=(python3-snowballstemmer-3.1.1.tar.gz)

pkg_build() {
	cd ${name#*-}-$version

	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
