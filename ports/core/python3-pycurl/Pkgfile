# Depends: curl python3-gpep517 python3-installer python3-setuptools
description="A Python 3.x interface to libcurl"
homepage="http://pycurl.sourceforge.net/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pycurl
version=7.49.0
_ver=7_46_0
release=1
source=(https://github.com/pycurl/pycurl/archive/REL_${_ver}/python-pycurl-$version.tar.gz)
renames=(python3-pycurl-7.49.0.tar.gz)

pkg_build() {
	cd pycurl-REL_${_ver}
	export PYCURL_SSL_LIBRARY=openssl
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
	rm -rf $PKG/usr/share/doc
}
