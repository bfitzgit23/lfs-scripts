# Depends: cmake ninja
description="Parses so-called cue sheets and handles the parsed data"
homepage="https://github.com/lipnitsk/libcue/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libcue
version=2.4.3
release=2
source=(https://github.com/lipnitsk/libcue/archive/v$version.tar.gz)
renames=(libcue-2.4.3.tar.gz)

pkg_build() {
	export CFLAGS="$CFLAGS -fPIC"

	cmake -S $SRC/$name-$version -B build -G Ninja \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5  \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
