# Depends: autoconf automake libtool
description="portable NetBSD-compatibility library"
homepage="https://github.com/archiecobbs/libnbcompat"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libnbcompat
version=1.0.2
release=1
source=(https://github.com/archiecobbs/libnbcompat/archive/refs/tags/${version}.tar.gz)
renames=(libnbcompat-1.0.2.tar.gz)

pkg_build() {
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
