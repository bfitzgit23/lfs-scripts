description="An implementation of the XDG Base Directory specifications"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libxdg-basedir
version=1.2.3
release=1
source="https://github.com/devnev/$name/archive/$name-$version.tar.gz"

pkg_build() {
	if [ -d $name-$name-$version ]; then
		if [ -d $name-$name-$version ]; then cd $name-$name-$version; fi
	fi

	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}

