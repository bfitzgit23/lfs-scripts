# Depends: glib gobject-introspection vala meson
description="A GObject library to create cabinet files"
homepage="https://wiki.gnome.org/msitools"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gcab
version=1.6
release=2
source="https://download.gnome.org/sources/gcab/$version/gcab-$version.tar.xz"

pkg_build() {
	venom-meson -Ddocs=false -Dtests=false build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
