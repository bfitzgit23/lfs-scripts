# Depends: python3-hatchling python3-setuptools python3-gpep517
description="Hatch plugin for versioning with your preferred VCS"
homepage="https://github.com/ofek/hatch-vcs"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-hatch-vcs
version=0.5.0
release=1
source="https://github.com/ofek/hatch-vcs/archive/v$version/hatch-vcs-$version.tar.gz"

pkg_build() {
  if [ -d hatch-vcs-$version ]; then
  	cd hatch-vcs-$version
  fi
	    gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	    python3 -m installer -d $PKG .dist/*.whl
}
