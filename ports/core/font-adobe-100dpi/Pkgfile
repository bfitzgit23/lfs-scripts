# Depends: util-macros mkfontscale bdftopcf
description="X.org 100dpi fonts"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=font-adobe-100dpi
version=1.0.4
release=1
source="https://www.x.org/archive/individual/font/$name-$version.tar.xz"

pkg_build() {

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
