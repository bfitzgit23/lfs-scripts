# Depends: python3-setuptools python3-gpep517
description="Python module for character encoding auto-detection"
homepage="https://github.com/chardet/chardet"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-chardet
_name=${name#*-}
_n=${_name%${_name#?}}
version=7.7.0
release=1
source=(https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-chardet-7.7.0.tar.gz)

pkg_build() {
	gpep517 build-wheel \
		    --wheel-dir .dist \
		    --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		    .dist/*.whl
}
