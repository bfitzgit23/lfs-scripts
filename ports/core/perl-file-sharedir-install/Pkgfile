description="File::ShareDir::Install - Install read-only data files from a distribution"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
homepage="https://search.cpan.org/dist/File-ShareDir-Install" 

name=perl-file-sharedir-install
version=0.14
release=1
source=(https://cpan.org/modules/by-module/File/File-ShareDir-Install-$version.tar.gz)
renames=(perl-file-sharedir-install-0.14.tar.gz)

pkg_build() {
	if [ -d File-ShareDir-Install-$version ]; then
		cd File-ShareDir-Install-$version
	fi
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
}
