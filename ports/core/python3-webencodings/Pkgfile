# Depends: python3-setuptools python3-gpep517 python3-installer
description="Character encoding for the web."
homepage="https://github.com/gsnedders/python-webencodings"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-webencodings
version=0.6.1
release=2
source="https://files.pythonhosted.org/packages/source/w/webencodings/webencodings-$version.tar.gz"

pkg_build() {

		gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
		python3 -m installer -d $PKG .dist/*.whl
}
