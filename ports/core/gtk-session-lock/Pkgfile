# Depends: meson gobject-introspection gtk3 vala wayland-protocols
description="A library to create screen lockers for Wayland using the ext-session-lock protocol"
homepage="https://github.com/Cu3PO42/gtk-session-lock"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gtk-session-lock
version=0.2.0
release=1
source=(https://github.com/Cu3PO42/gtk-session-lock/archive/v${version}.tar.gz)
renames=(gtk-session-lock-0.2.0.tar.gz)

pkg_build() {
	venom-meson $SRC/$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
