# Depends: meson ninja
description="Varlink C library and command line tool"
homepage="https://github.com/varlink/libvarlink"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libvarlink
version=24.0.1
release=1
source=(https://github.com/varlink/libvarlink/archive/refs/tags/v$version.tar.gz)
renames=(libvarlink-24.0.1.tar.gz)

pkg_build() {
	venom-meson $SRC/$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
