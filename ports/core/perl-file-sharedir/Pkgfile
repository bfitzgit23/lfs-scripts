# Depends: perl-class-inspector
description="Locate per-dist and per-module shared files"
maintainer="Venom Linux Team, venomlinux at disroot dot org"
homepage="https://metacpan.org/dist/File-ShareDir" 

name=perl-file-sharedir
version=1.118
release=1
source=(https://cpan.org/modules/by-module/File/File-ShareDir-$version.tar.gz)
renames=(perl-file-sharedir-1.118.tar.gz)

pkg_build() {
	if [ -d File-ShareDir-$version ]; then
		cd File-ShareDir-$version
	fi
	perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
}
