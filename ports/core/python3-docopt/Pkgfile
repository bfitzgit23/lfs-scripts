# Depends: python3-setuptools python3-gpep517 python3-installer
description="Pythonic argument parser that will make you smile"
homepage="https://pypi.org/project/docopt"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-docopt
version=0.6.2
release=1
source=(https://files.pythonhosted.org/packages/a2/55/8f8cab2afd404cf578136ef2cc5dfb50baa1761b68c9da1fb1e4eed343c9/docopt-$version.tar.gz)
renames=(python3-docopt-0.6.2.tar.gz)

pkg_build() {
	if [ -d docopt-$version ]; then
		cd docopt-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
