name=gettext
version=1.0
release=1
source=(https://ftp.osuosl.org/pub/lfs/lfs-packages/13.1/$name-$version.tar.xz
	gettext-0.22-disable-libtextstyle.patch)
build_opt="
	--disable-csharp
	--disable-java
	--with-included-glib
	--with-included-libcroco
	--with-included-libunistring
	--with-included-libxml
	--without-included-gettext
"

pkg_build() {
	./configure \
		--prefix=/usr \
		--enable-{shared,static} \
		--disable-{csharp,java,nls} \
		--without-{emacs,git} \
		--with-included-{glib,libcroco,libxml,libunistring}
	make
	make DESTDIR=$PKG install
}


bootstrap_build() {
	# gettext installs Emacs Lisp (gettext-tools/emacs/Makefile) and, when
	# configure finds an emacs on PATH, byte-compiles it during make with
	# `$(EMACS) --batch --no-site-file`. An emacs that is not GNU Emacs (a
	# wrapper, mg, ...) rejects those long options with
	# "emacs: invalid option -- '-'". The bootstrap needs no po-mode:
	# --without-emacs makes configure set EMACS=no, which turns the
	# byte-compile and lisp install rules into no-ops.
	./configure --disable-shared --without-emacs
	make -j1
	cp -v gettext-tools/src/msgfmt \
	      gettext-tools/src/msgmerge \
	      gettext-tools/src/xgettext \
	      $TOOLS/bin
}
