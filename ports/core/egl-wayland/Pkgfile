# Depends: eglexternalplatform mesa wayland-protocols
description="The EGLStream-based Wayland external platform"
homepage="https://github.com/NVIDIA/egl-wayland/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=egl-wayland
version=1.1.21
release=1
source="https://github.com/NVIDIA/egl-wayland/archive/$version/$name-$version-$release.tar.gz"

pkg_build() {
	venom-meson $SRC/$name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}

