# Depends: python3-setuptools python3-gpep517 python3-installer
description="SVG optimizer/cleaner that reduces their size by optimizing structure and removing unnecessary data"
homepage="https://github.com/scour-project/scour"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-scour
version=0.38.2
release=1
source=(https://github.com/scour-project/scour/archive/v$version/scour-v$version.tar.gz)
renames=(python3-scour-0.38.2.tar.gz)

pkg_build() {
	if [ -d scour-$version ]; then
		cd scour-$version
	fi
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
