# Depends: python3-setuptools python3-gpep517 python3-installer
description="SOCKS4, SOCKS5 or HTTP proxy (Anorov fork PySocks replaces socksipy)"
homepage="https://github.com/Anorov/PySocks"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pysocks
version=1.7.1
release=1
source=(https://pypi.io/packages/source/P/PySocks/PySocks-$version.tar.gz)
renames=(python3-pysocks-1.7.1.tar.gz)

pkg_build() {
	cd PySocks-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
