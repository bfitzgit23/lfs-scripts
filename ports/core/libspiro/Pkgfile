description="Simplifies the drawing of beautiful curves"
homepage="https://github.com/fontforge/libspiro"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libspiro
version=20240903
release=1
source=(https://github.com/fontforge/$name/releases/download/$version/$name-dist-$version.tar.gz)
renames=(libspiro-20240903.tar.gz)

pkg_build() {

	autoreconf -i
	automake --foreign -Wall

	export LDFLAGS=
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
