# Depends: python3-gpep517 python3-setuptools python3-wheel python3-flit-core
description="Integer to Roman numerals converter"
homepage="https://pypi.org/project/roman-numerals"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-roman-numerals
version=4.1.0
release=1
source=(https://github.com/AA-Turner/roman-numerals/archive/v$version.tar.gz)
renames=(python3-roman-numerals-4.1.0.tar.gz)

pkg_build() {
	cd python
	cp ../LICENCE* ./
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	/usr/bin/python3 -m installer -d $PKG .dist/*.whl
}
