description="Thin wrapper over POSIX syscalls"
homepage="https://github.com/sionescu/libfixposix/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libfixposix
version=0.5.1
release=1
source=(https://github.com/sionescu/libfixposix/archive/v$version.tar.gz)
renames=(libfixposix-0.5.1.tar.gz)

pkg_build() {
	autoreconf -fiv
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
