# Depends: fuse3 glib
description="Remote filesystem in userspace using SSH"
homepage="https://github.com/libfuse/sshfs "
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sshfs-fuse
version=3.7.6
release=1
source="https://github.com/libfuse/sshfs/releases/download/sshfs-$version/sshfs-$version.tar.xz"

pkg_build() {
	venom-meson  $SRC/sshfs-$version  build \
		--buildtype=release

	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install --no-rebuild -C build
}
