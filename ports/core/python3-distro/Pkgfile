# Depends: python3-gpep517
description="Linux OS platform information API "
homepage="https://github.com/python-distro/distro"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-distro
version=1.9.0
release=3
source=(https://github.com/nir0s/distro/archive/v${version}/python-distro-${version}.tar.gz)
renames=(python3-distro-1.9.0.tar.gz)

pkg_build() {
	if [ -d distro-$version ]; then
		cd distro-$version
	fi
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	python3 -m installer -d $PKG \
		.dist/distro-*.whl
}
