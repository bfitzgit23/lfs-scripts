# Depends: libidn2 libxcrypt bash-completion
description="Intelligent WHOIS client"
homepage="https://github.com/rfc1036/whois"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=whois
version=5.6.6
release=1
source=(https://ftp.debian.org/debian/pool/main/w/whois/whois_$version.tar.xz)
renames=(whois-5.6.6.tar.xz)

pkg_build() {
	cd work
	make CONFIG_FILE='/etc/whois.conf' whois
	make DESTDIR=$PKG install
	install -Dm644 whois.conf -t $PKG/etc
}
