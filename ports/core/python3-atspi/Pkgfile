# Depends: at-spi2-core python3-gobject3
description="Python3 bindings for the core components of the GNOME Accessibility"
homepage="https://gitlab.gnome.org/GNOME/pyatspi2"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-atspi
version=2.58.2
release=1
source=(https://download.gnome.org/sources/pyatspi/${version%.*}/pyatspi-$version.tar.xz)
renames=(python3-atspi-2.58.2.tar.gz)

pkg_build() {
	venom-meson pyatspi-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
