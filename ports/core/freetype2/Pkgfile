# Depends: meson libpng
description="Font rasterization library"
homepage="https://downloads.sourceforge.net/freetype"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=freetype2
version=2.14.3
release=1
source=(https://downloads.sourceforge.net/freetype/freetype-$version.tar.xz
	freetype2.sh)

pkg_build() {
	venom-meson build -Dfreetype2:default_library=shared
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	install -Dt $PKG/etc/profile.d -m644 $SRC/freetype2.sh
}
