# Depends: python3-setuptools python3-gpep517 python3-installer
description="Setuptools extension for CalVer package versions"
homepage="https://github.com/di/calver"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-calver
version=2025.10.20
release=1
source="https://pypi.org/packages/source/c/calver/calver-$version.tar.gz"

pkg_build() {
  if [ -d calver-$version ]; then
    cd calver-$version
  fi

  gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
  python3 -m installer -d $PKG .dist/*.whl
}
