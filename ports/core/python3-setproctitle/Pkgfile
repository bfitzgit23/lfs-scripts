# Depends: python3 procps-ng python3-gpep517 python3-installer python3-setuptools
description="Allows a python process to change its process title "
homepage="https://github.com/dvarrazzo/py-setproctitle"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-setproctitle
version=1.3.8
release=1
source=(https://files.pythonhosted.org/packages/source/s/setproctitle/setproctitle-$version.tar.gz)
renames=(python3-setproctitle-1.3.8.tar.gz)

pkg_build() {
	cd setproctitle-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
