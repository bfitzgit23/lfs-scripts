# Depends: libogg
description="Low-latency audio communication codec"
homepage="https://gitlab.xiph.org/xiph/celt/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=celt
version=0.11.3
commit=6c28805c56d562bec56cc0b31c0d5905ebb5a6ac
release=1
source="https://downloads.xiph.org/releases/celt/$name-$version.tar.gz"
pkg_build() {
	cd $name-$version
	NOCONFIGURE=1 ./autogen.sh
	./configure --prefix=/usr --enable-custom-modes --disable-static
	make
	make DESTDIR=$PKG install
}

