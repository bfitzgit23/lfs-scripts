# Depends: libx11 libxtst
description="X virtual keyboard library"
homepage="https://www.yoctoproject.org/tools-resources/projects/matchbox"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libfakekey
version=0.3
release=1
# yoctoproject's cgit no longer snapshots this; Debian keeps the 0.3 tree.
source="http://deb.debian.org/debian/pool/main/libf/libfakekey/libfakekey_0.3+git20170516.orig.tar.xz"

pkg_build() {
	cd libfakekey
	./autogen.sh
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
	make
	make DESTDIR=$PKG install
}
