# Depends: python3-setuptools python3-gpep517 python3-installer
description="A Python library for parsing and creating TOML"
homepage="https://github.com/uiri/toml"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-toml
version=0.10.2
release=1
source=(https://files.pythonhosted.org/packages/source/t/toml/toml-$version.tar.gz)
renames=(python3-toml-0.10.2.tar.gz)

pkg_build() {
	cd toml-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
