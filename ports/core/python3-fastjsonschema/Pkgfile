# Depends: python3-gpep517 python3-setuptools python3-wheel
description="Fast JSON schema validator"
homepage="https://horejsek.github.io/python-fastjsonschema/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-fastjsonschema
version=2.22.3
release=1
source=(https://github.com/horejsek/python-fastjsonschema/archive/refs/tags/v$version.tar.gz)
renames=(python3-fastjsonschema-2.22.3.tar.gz)

pkg_build() {
	if [ -d python-fastjsonschema-$version ]; then
		cd python-fastjsonschema-$version
	fi

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" \
		.dist/*.whl

}
