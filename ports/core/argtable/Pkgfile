description="argtable command line parser library"
homepage="http://argtable.sourceforge.net"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=argtable
version=2.13
_version=${version%.*}-${version##*.}
release=1
source="https://cytranet.dl.sourceforge.net/project/$name/$name/$name-$version/${name}${_version}.tar.gz"

pkg_build() {
    if [ -d ${name}${_version} ]; then cd ${name}${_version}; fi

    autoreconf -vfi
    ./configure --prefix=/usr
    make PREFIX=/usr
    make PREFIX=/usr DESTDIR=$PKG install
}
