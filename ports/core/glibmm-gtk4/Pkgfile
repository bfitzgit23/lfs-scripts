# Depends: doxygen glib libsigc++3
description="Set of C++ bindings for GLib"
homepage="https://www.gtkmm.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=glibmm-gtk4
version=2.88.0
release=1
source=(https://gitlab.gnome.org/GNOME/${name%-*}/-/archive/$version/${name%-*}-$version.tar.bz2)
renames=(glibmm-gtk4-2.88.0.tar.bz2)

pkg_build() {
	venom-meson $SRC/${name%-*}-$version build -Dmaintainer-mode=true
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
