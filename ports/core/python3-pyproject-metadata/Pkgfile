# Depends: python3-flit-core python3-gpep517
description="PEP 621 metadata parsing"
homepage="https://github.com/FFY00/python-pyproject-metadata"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pyproject-metadata
version=0.12.1
release=1
source="https://pypi.org/packages/source/p/pyproject_metadata/pyproject_metadata-$version.tar.gz"

pkg_build() {
  if [ -d pyproject_metadata-$version ]; then
  	cd pyproject_metadata-$version
  fi

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl
}
