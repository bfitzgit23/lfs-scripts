# Depends: dbus python3-setuptools python3-gobject3 python3-gpep517 python3-installer
description="DBus library in Python 3"
homepage="https://github.com/rhinstaller/dasbus"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-dasbus
version=1.7
release=3
source="dasbus-$version.tar.gz::https://github.com/rhinstaller/dasbus/archive/v${version}.tar.gz"

pkg_build() {
	cd dasbus-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
