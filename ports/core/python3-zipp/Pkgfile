# Depends: python3-gpep517 python3-setuptools-scm
description="Backport of pathlib-compatible object wrapper for zip files"
homepage="https://pypi.org/project/zipp/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-zipp
version=4.1.2
release=1
source="https://pypi.python.org/packages/source/z/zipp/zipp-$version.tar.gz"

pkg_build() {

	 if [ -d zipp-$version ]; then
	 	cd zipp-$version
	 fi
	 export SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver
        gpep517 build-wheel \
                --wheel-dir .dist \
                --output-fd 3 3>&1 >&2

        python3 -m installer -d $PKG \
                .dist/zipp*.whl
}
