# Depends: python3-setuptools python3-gpep517 python3-wheel
description="An ISO 8601 date/time/duration parser and formatter"
homepage="https://github.com/gweis/isodate/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-isodate
version=0.7.2
release=1
source=(https://files.pythonhosted.org/packages/source/i/isodate/isodate-$version.tar.gz)
renames=(python3-isodate-0.7.2.tar.gz)

pkg_build() {
	if [ -d isodate-$version ]; then
		cd isodate-$version
	fi

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl

}
