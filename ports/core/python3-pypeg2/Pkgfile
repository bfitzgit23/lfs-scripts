# Depends: python3 python3-gpep517 python3-installer python3-setuptools
description="An intrinsic PEG Parser-Interpreter for Python"
homepage="https://fdik.org/pyPEG/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pypeg2
version=2.15.2
release=1
source=(https://pypi.python.org/packages/source/p/pyPEG2/pyPEG2-$version.tar.gz)
renames=(python3-pypeg2-2.15.2.tar.gz)

pkg_build() {
	cd pyPEG2-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
