# Depends: cmake ninja glu
description="A multi-platform library for OpenGL, OpenGL ES, Vulkan, window and input"
homepage="https://github.com/glfw/glfw"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=glfw
version=3.5.1
release=1
source=(https://github.com/$name/$name/archive/$version.tar.gz)
renames=(glfw-3.5.1.tar.gz)

pkg_build() {

	cmake -S $SRC/$name-$version -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=On
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
