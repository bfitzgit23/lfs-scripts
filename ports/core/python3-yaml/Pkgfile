# Depends: python3-gpep517 yaml cython3
description="Python bindings for YAML, using fast libYAML library"
homepage="https://github.com/yaml/pyyaml"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-yaml
version=6.0.3
release=2
source=(https://github.com/yaml/pyyaml/archive/$version.tar.gz)
renames=(python3-yaml-6.0.3.tar.gz)

pkg_build() {

	# build() already enters the extracted tree when the archive has a top-level directory,
	# so only cd when it did not.
	if [ -d pyyaml-$version ]; then
		cd pyyaml-$version
	fi
	rm -f ext/_yaml.c

        gpep517 build-wheel \
                --wheel-dir .dist \
                --output-fd 3 3>&1 >&2

        python3 -m installer -d $PKG \
                .dist/*.whl   
}
