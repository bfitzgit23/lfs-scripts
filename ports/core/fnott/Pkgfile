# Depends: dbus fcft wlroots meson tllist scdoc
description="Keyboard driven and lightweight Wayland notification daemon"
homepage="https://codeberg.org/dnkl/fnott"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=fnott
version=1.8.0
release=1
source=(https://codeberg.org/dnkl/fnott/archive/$version.tar.gz)
renames=(fnott-1.8.0.tar.gz)

pkg_build() {
	venom-meson $name build 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
