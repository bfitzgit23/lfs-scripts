# Depends: python3-setuptools python3-gpep517 python3-installer
description="World timezone definitions, modern and historical"
homepage="https://pythonhosted.org/pytz/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pytz
version=2026.6
release=1
source=(https://pypi.io/packages/source/p/pytz/pytz-$version.tar.gz)
renames=(python3-pytz-2026.6.tar.gz)

pkg_build() {
  cd pytz-$version
  gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
  python3 -m installer -d $PKG .dist/*.whl
}
