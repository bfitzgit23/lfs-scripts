description="C library for processing UTF-8 encoded Unicode strings"
homepage="https://github.com/JuliaStrings"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=utf8proc
version=2.12.0
release=1
source=(https://github.com/JuliaStrings/$name/archive/refs/tags/v$version.tar.gz)
renames=(utf8proc-2.12.0.tar.gz)

pkg_build() {
	cmake -S $SRC/$name-$version -B build \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D BUILD_SHARED_LIBS=ON \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
