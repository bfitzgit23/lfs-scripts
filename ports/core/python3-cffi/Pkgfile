# Depends: python3-pycparser python3-gpep517 python3-installer python3-setuptools
description="Foreign Function Interface for Python calling C code"
homepage="http://cffi.readthedocs.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-cffi
version=2.1.1
release=1
source=(https://files.pythonhosted.org/packages/source/c/${name#*-}/${name#*-}-$version.tar.gz)
renames=(python3-cffi-2.1.1.tar.gz)

pkg_build() {
	cd ${name#*-}-$version
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG .dist/*.whl
}
