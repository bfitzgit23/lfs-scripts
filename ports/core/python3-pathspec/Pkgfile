# Depends: python3-setuptools python3-gpep517 python3-installer
description="Utility library for gitignore style pattern matching of file paths"
homepage="https://github.com/cpburnz/python-path-specification"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=python3-pathspec
version=1.1.1
release=1
source="https://pypi.io/packages/source/p/pathspec/pathspec-$version.tar.gz"

pkg_build() {
  if [ -d pathspec-$version ]; then
    cd pathspec-$version
  fi
  gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
  python3 -m installer -d $PKG .dist/*.whl
}
