# Depends: libx11
description="Command-line utility to print information about windows on an X server"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xwininfo
version=1.1.6
release=1
source="http://ftp.x.org/pub/individual/app/xwininfo-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
