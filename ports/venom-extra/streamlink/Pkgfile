# Depends: python3-pysocks python3-websocket-client python3-iso3166 python3-iso-639 python3-requests python3-pycryptodome python3-isodate python3-build python3-wheel
description="CLI program that launches streams from various streaming services in a custom video player (livestreamer fork)"
homepage="https://streamlink.github.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=streamlink
version=8.4.0
release=1
source="https://github.com/$name/$name/releases/download/$version/$name-$version.tar.gz"

pkg_build() {
	sed -i 's/versioningit >=2.0.0, <3/versioningit/' pyproject.toml
	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir=$PKG dist/*.whl
	
}
