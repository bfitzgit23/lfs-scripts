# Depends: fontconfig
description="Patched font JetBrains Mono from the nerd-fonts library"
homepage="https://github.com/ryanoasis/nerd-fonts"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ttf-nerd-jetbrains-mono
version=3.4.0
release=1
source="$name-$version.zip::https://github.com/ryanoasis/nerd-fonts/releases/download/v$version/JetBrainsMono.zip"

pkg_build() {
	find . -iname "*.otf" -not -iname "*Windows Compatible.otf" -execdir install -Dm644 {} "$PKG/usr/share/fonts/OTF/{}" \;
	find . -iname "*.ttf" -not -iname "*Windows Compatible.ttf" -execdir install -Dm644 {} "$PKG/usr/share/fonts/TTF/{}" \;
}
