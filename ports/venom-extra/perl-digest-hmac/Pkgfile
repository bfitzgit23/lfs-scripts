# Depends: perl
description="Keyed-Hashing for Message Authentication"
homepage="http://metacpan.org/release/Digest-HMAC"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=perl-digest-hmac
version=1.05
release=1
source="http://search.cpan.org/CPAN/authors/id/A/AR/ARODLAND/Digest-HMAC-$version.tar.gz"

pkg_build() {
	cd Digest-HMAC-$version

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make OPTIMIZE="$CFLAGS" DESTDIR="$PKG" install

	find "$PKG" -depth \
		-type f \( -name .packlist -o -name \*.bs -o -name perllocal.pod \) -delete , \
		-type f -name autosplit.ix \( -exec grep -q '^[[:space:]]*package' {} \; -o -delete \) , \
		-type d -empty -exec rmdir {} +
}
