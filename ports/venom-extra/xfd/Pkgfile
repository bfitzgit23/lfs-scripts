# Depends: libxaw libxft util-macros libxkbfile
description="Displays all the characters in a font using either the X11 core protocol or libXft2"
homepage="https://xorg.freedesktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xfd
version=1.1.5
release=1
source="https://xorg.freedesktop.org/archive/individual/app/$name-$version.tar.xz"

pkg_build() {
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
