description="Manage installation of multiple softwares in the same directory tree"
homepage="https://mirrorservice.org/sites/ftp.gnu.org/gnu/stow/stow-2.4.1.tar.gz"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=stow
version=2.4.1
release=1
source="https://mirrorservice.org/sites/ftp.gnu.org/gnu/stow/stow-2.4.1.tar.gz"

pkg_build() {

    ./configure --prefix=/usr --sysconfdir=/etc --sbindir=/usr/sbin --disable-nfsv4 --disable-gss
    make
	make PREFIX=$PKG/usr DESTDIR=$PKG install
}
