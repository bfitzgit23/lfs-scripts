# Depends: libx11
description="X Window System image undumping utility"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xwud
version=1.0.7
release=1
source="http://ftp.x.org/pub/individual/app/xwud-$version.tar.gz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

