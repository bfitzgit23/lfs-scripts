# Depends: gsettings-desktop-schemas gtk3 iso-codes itstool libseccomp xkeyboard-config bubblewrap meson
description="Library that provides an API shared by several applications on the GNOME Desktop"
homepage="https://www.gnome.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gnome-desktop
version=44.5
release=2
source="http://ftp.gnome.org/pub/gnome/sources/gnome-desktop/${version%.*}/gnome-desktop-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build \
		-Ddesktop_docs=false \
		-Ddebug_tools=false \
		-Dsystemd=disabled \
		-Dbuild_gtk4=false 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -f $PKG/usr/include/gnome-desktop-3.0/libgnome-desktop/gnome-systemd.h
}
