# Depends: libx11
description="Refresh all or part of an X screen"
homepage="https://gitlab.freedesktop.org/xorg/app/xrefresh"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xrefresh
version=1.1.0
release=1
source="http://ftp.x.org/pub/individual/app/xrefresh-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

