description="An audio processing library"
homepage="https://www.surina.net/soundtouch/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=soundtouch
version=2.4.1
release=1
source="https://www.surina.net/$name/$name-$version.tar.gz"

pkg_build() {
	cd $name

	./bootstrap
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
