# Depends: xcb-util
description="RandR-based backlight control application"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xbacklight
version=1.2.4
release=1
source="http://ftp.x.org/pub/individual/app/xbacklight-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
