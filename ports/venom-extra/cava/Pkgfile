# Depends: alsa-lib libtool m4 fftw iniparser
description="Console-based Audio Visualizer for ALSA "
homepage="https://github.com/karlstav/cava"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=cava
version=1.0.0
release=1
source="https://github.com/karlstav/cava/releases/download/$version/$name-$version.tar.gz"

pkg_build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
	make DESTDIR=$PKG install
}
