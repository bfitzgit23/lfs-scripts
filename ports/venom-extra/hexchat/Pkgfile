# Depends: dbus-glib gtk2 lua libcanberra libnotify python3-cffi
description="IRC client based on XChat"
homepage="https://hexchat.github.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=hexchat
version=2.16.2
release=1
source="https://github.com/hexchat/hexchat/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build \
		-Dwith-perl=false \
		-Dwith-lua=lua \
		-Dwith-sysinfo=false \
		-Dwith-python=python3-embed
	meson compile -C build
	DESTDIR="$PKG" meson install --no-rebuild -C build

}
