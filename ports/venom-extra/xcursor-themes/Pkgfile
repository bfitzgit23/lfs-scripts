# Depends: xcursorgen
description="Redglass and whiteglass animated cursor themes"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xcursor-themes
version=1.0.7
release=1
source="http://ftp.x.org/pub/individual/data/xcursor-themes-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
