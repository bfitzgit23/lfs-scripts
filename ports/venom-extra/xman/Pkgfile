# Depends: libxaw groff man-db
description="xman manual page browser"
homepage="https://www.x.org/releases/individual/app/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xman
version=1.2.0
release=1
source="https://ftp.x.org/releases/individual/app/xman-$version.tar.xz"

pkg_build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
