# Depends: appstream appstream-glib gexiv2 gegl libgudev libexif libjxl libwebp mypaint-brushes
description="GNU Image Manipulation Program"
homepage="https://www.gimp.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=gimp
version=3.2.4
release=1
source="https://download.gimp.org/pub/gimp/v${version%.*}/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build -Ddebug=false -Db_lto=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
