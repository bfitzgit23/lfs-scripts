# Depends: xorgproto
description="Register X sessions in system utmp/utmpx databases"
homepage="https://xorg.freedesktop.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=sessreg
version=1.1.4
release=1
source="http://ftp.x.org/pub/individual/app/sessreg-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
