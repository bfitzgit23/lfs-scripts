# Depends: libxml2 curl gettext lynx
description="RSS feed reader for the command-line"
homepage="https://sourceforge.net/projects/snownews/ "
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=snownews
version=1.11
release=2
source="https://sourceforge.net/projects/$name/files/$name-$version.tar.gz"

pkg_build() {
	./configure --prefix=/usr
	make
	make PREFIX=/usr DESTDIR=$PKG install
}
