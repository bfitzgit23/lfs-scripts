# Depends: libxaw
description="XKB utility demos"
homepage="https://xorg.freedesktop.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xkbutils
version=1.0.6
release=1
source="http://ftp.x.org/pub/individual/app/xkbutils-$version.tar.xz"

pkg_build() {

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

