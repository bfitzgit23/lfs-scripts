# Depends: libxaw3dxft netpbm
description="A color image editing tool which features most standard paint program options"
homepage="http://sourceforge.net/projects/sf-xpaint/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=xpaint
version=3.1.4
release=1
source="https://downloads.sourceforge.net/sf-$name/$name-$version.tar.bz2
	$name.desktop"

pkg_build() {

	./configure --prefix=/usr
	make -j1
	make DESTDIR=$PKG install

	install -Dm644 $SRC/$name.desktop \
	    $PKG/usr/share/applications/$name.desktop
}
