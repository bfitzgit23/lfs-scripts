# Depends: libseccomp libevent zlib
description="Anonymizing overlay network"
homepage="https://www.torproject.org"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=tor
version=0.4.9.11
release=1
source="https://www.torproject.org/dist/$name-$version.tar.gz
	rc.tor
	run.tor
	torrc"

pkg_build() {

	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
	make
	make DESTDIR=$PKG install

	install -Dm0644 $SRC/torrc $PKG/etc/tor/torrc
	mv $PKG/etc/tor/torrc.sample $PKG/etc/tor/torrc-dist

	install -d $PKG/var/lib/tor -o tor -g tor

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run
		ln -s /run/runit/supervice.$name $PKG/etc/sv/$name/supervise
	} || continue
	
	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.$name $PKG/etc/rc.d/$name || continue
}
