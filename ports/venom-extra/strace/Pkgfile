# Depends: elfutils
description="A diagnostic, debugging and instructional userspace tracer"
homepage="https://strace.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=strace
version=7.1
release=1
source="https://github.com/strace/strace/releases/download/v$version/$name-$version.tar.xz"

pkg_build() {

	./configure \
	--prefix=/usr \
	--enable-silent-rules \
	--enable-bundled=yes
	make
	make DESTDIR=$PKG install
}
