# Depends: gobject-introspection gtk3 qt6-base
description="libportal provides GIO-style async APIs for most Flatpak portals."
homepage="https://github.com/flatpak/libportal"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libportal
version=0.10.0
release=1
source="https://github.com/flatpak/libportal/releases/download/$version/$name-$version.tar.xz"

pkg_build() {
	venom-meson $name-$version build\
		-Ddocs=false\
		-Dbackend-gtk4=`scratch isinstalled gtk4 && printf "enabled" || printf "disabled"` \
		-Dbackend-qt5=`scratch isinstalled qt5 && printf "enabled" || printf "disabled"` \
		-Dbackend-qt6=enabled
	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
