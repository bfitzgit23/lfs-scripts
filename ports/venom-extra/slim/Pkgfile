# Depends: libx11 libxft libxrender libxrandr libxmu freetype2 libjpeg-turbo libpng zlib consolekit2 linux-pam
description="Simple Login Manager"
homepage="https://slim-fork.sourceforge.io/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=slim
version=1.4.1
release=2
backup="etc/slim.conf"
source="https://sourceforge.net/projects/${name}-fork/files/$name-$version.tar.gz
	pam-headers.patch
	rc.slim
	$name.pam
	run.slim"

pkg_build() {
	
	patch -Np1 -i $SRC/pam-headers.patch
	cmake -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DUSE_CONSOLEKIT=yes \
		-DUSE_PAM=yes \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build

	# remove systemd things
	rm -rf $PKG/lib

	install -Dm644 $SRC/$name.pam $PKG/etc/pam.d/$name

	# runit service
	scratch isinstalled runit && {
		install -Dm755 $SRC/run.slim $PKG/etc/sv/slim/run
		ln -s /run/runit/supervise.slim $PKG/etc/sv/slim/supervise
	} || continue

	# rc service
	scratch isinstalled sysvinit && \
		install -Dm755 $SRC/rc.slim $PKG/etc/rc.d/slim || continue
}
