# Depends: layer-shell-qt qtxdg-tools breeze-icons liblxqt lxqt-themes xdg-user-dirs
description="The LXQt session"
homepage="https://lxqt-project.org/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=lxqt-wayland-session
version=0.4.1
release=1
source="https://github.com/lxqt/lxqt-wayland-session/releases/download/$version/$name-$version.tar.xz"
	

pkg_build() {
	cmake -S $name-$version -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
