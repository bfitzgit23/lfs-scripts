# Depends: kwin
description="A cool desktop panel for Linux desktop"
homepage="https://github.com/dangvd/crystal-dock"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=crystal-dock
version=2.16
release=1
source=(https://github.com/dangvd/crystal-dock/archive/refs/tags/v$version.tar.gz)
renames=(crystal-dock-2.16.tar.gz)
pkg_build() {
	mkdir -p build
	cd build
	cmake  \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    ../src
  make
  cd ..
  DESTDIR=$PKG cmake --install build
}
