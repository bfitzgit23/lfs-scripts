# Depends: liblxqt
description="Utilities for monitoring your system and processes on your system"
homepage="https://gitlab.com/procps-ng/procps"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libprocps
version=3.3.17
release=1
source="https://downloads.sourceforge.net/project/procps-ng/Production/procps-ng-${version}.tar.xz"

pkg_build() {
	if [ -d procps-${version} ]; then
		cd procps-${version}
	fi

	./configure \
		--prefix=/usr \
		--exec-prefix=/ \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--bindir=/usr/bin \
		--sbindir=/usr/bin \
		--enable-watch8bit \
		--disable-modern-top \
		--disable-kill
	make
	make DESTDIR="${PKG}" install

	rm -rf "${PKG}"/usr/bin "${PKG}"/usr/share
}
