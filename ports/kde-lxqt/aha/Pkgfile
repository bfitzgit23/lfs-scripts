description="ANSI color to HTML converter"
homepage="https://github.com/theZiz/ah"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=aha
version=0.5.1
release=1
source=(https://github.com/theZiz/aha/archive/$version.tar.gz)
renames=(aha-0.5.1.tar.gz)

pkg_build() {
	if [ -d ${name}-${version} ]; then
		if [ -d ${name}-${version} ]; then cd ${name}-${version}; fi
	fi
	make
	install -Dm 755 aha $PKG/usr/bin/aha
	install -Dm 644 aha.1 $PKG/usr/share/man/man1/aha.1
}
