# Depends: baloo kactivitymanagerd kholidays knotifyconfig kquickcharts ktexteditor kunitconversion kuserfeedback kwallet kwin kwin-x11 libqalculate networkmanager-qt phonon plasma-activities-stats plasma-integration plasma5support prison qcoro kde-cli-tools qt6-location
description="The base for Plasma Desktop, Mobile, and Bigscreen containing shared KCMs, applets and multiple libraries"
homepage="https://kde.org/plasma-desktop/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=plasma-workspace
version=6.7.1
release=1
source="https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz"

pkg_build() {
    # Fix doc build with libxml2 2.15
    find -name index.docbook | xargs sed -e 's|index.html "|index.html"|g' -i

    cmake -S $name-$version -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_INSTALL_LIBEXECDIR=lib \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    cmake --build build
    DESTDIR=$PKG cmake --install build

    rm -rf $PKG/usr/lib/systemd

    sed -i -e 's,^Exec=\(/usr/lib/plasma-dbus.*\),Exec=/usr/bin/ck-launch-session \1,' \
        $PKG/usr/share/wayland-sessions/plasma.desktop

}
