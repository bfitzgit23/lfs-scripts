# Depends: kwidgetsaddons kcrash kdnssd kpipewire kstatusnotifieritem kwallet kwayland kxmlgui libvncserver xdg-desktop-portal
description="Desktop Sharing"
homepage="https://apps.kde.org/krfb/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=krfb
version=26.04.2
release=1
source="https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz"

pkg_build() {
    cmake -S $name-$version -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	-DBUILD_TESTING=OFF \
        -Wno-dev
    cmake --build build
    DESTDIR=$PKG cmake --install build

}
