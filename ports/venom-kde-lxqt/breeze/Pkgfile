# Depends: frameworkintegration kcmutils kdecoration kirigami
description="Color schemes, cursors, window decorations, application style, and wallpapers for the breeze visual style"
homepage="https://invent.kde.org/plasma/breeze"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=breeze
version=6.7.1
release=1
source="https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz"

pkg_build() {

	cmake -S $name-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -D BUILD_QT5=OFF \
	        -D BUILD_TESTING=OFF \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
