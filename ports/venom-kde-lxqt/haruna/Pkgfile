# Depends: ffmpeg kcolorscheme kconfig kcoreaddons kcrash kdeclarative kdsingleapplication kfilemetadata ki18n kio kirigami kitemmodels kservice kwindowsystem mpvqt qqc2-desktop-style qt6-declarative yt-dlp
description="Video player built with Qt/QML on top of libmpv"
homepage="https://apps.kde.org/haruna/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=haruna
version=1.8.1
release=1
source="https://download.kde.org/stable/$name/$version/$name-$version.tar.xz"

pkg_build() {
	cmake -S $name-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -Wno-dev
	 cmake --build build
	 DESTDIR=$PKG cmake --install build

}
