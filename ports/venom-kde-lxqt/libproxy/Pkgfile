# Depends: duktape gsettings-desktop-schemas python3-gobject3
description="Automatic proxy configuration management library"
homepage="https://libproxy.github.io/libproxy/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=libproxy
version=0.5.12
release=1
source="https://github.com/libproxy/libproxy/archive/$version/$name-$version.tar.gz"

pkg_build() {
	venom-meson $name-$version build \
		-D release=true \
	        -D docs=false
	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
