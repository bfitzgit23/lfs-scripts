# Depends: kio libksysguard
description="A plugin based system monitoring daemon"
homepage="https://kde.org/plasma-desktop/"
maintainer="Venom Linux Team, venomlinux at disroot dot org"

name=ksystemstats
version=6.7.1
release=1
case "$PKG" in
	*.90*) _rel=unstable;;
	*) _rel=stable;;
esac
source="https://download.kde.org/$_rel/plasma/$version/ksystemstats-$version.tar.xz"

pkg_build() {
    cmake -S $name-$version -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    cmake --build build
    DESTDIR=$PKG cmake --install build

    rm -rf $PKG/usr/lib/systemd

}
